CREATE OR REPLACE PROCEDURE `ti-ca-ml-start.QA_Training_scorecards.step0_sp_2026_lead_vocpercenttogoal_ETL`()
BEGIN

  /************************************************************************************************
   PROCEDURE: step0_sp_2026_lead_vocpercenttogoal_ETL
   DESCRIPTION: Master ETL pipeline aggregating the 'VOC % to Goal' KPI for CX Quality Team Leads 
                (10% Weight). This procedure rolls up granular analyst-level VOC performance, 
                evaluates hierarchical team exemption and applicability flags, applies multi-program 
                capping to normalize outliers, maps performance to VOC-specific achievement tiers, 
                and calculates diluted scorecard weights to ensure accurate global aggregation.
  ************************************************************************************************/

  CREATE OR REPLACE TABLE `ti-ca-ml-start.QA_Training_scorecards.2026_voc_ptg_team_lead_detailed` AS
  
  /* =========================================================================================
     CTE 1: HIERARCHICAL PROGRAM FOOTPRINT
     Determines the exact number of active, non-exempt operational combinations (Program + 
     Country + Region) managed by each Team Lead per month. This distinct count is critical 
     for triggering multi-program capping and weight dilution calculations downstream.
  ========================================================================================= */
  WITH ProgramCounts AS (
    SELECT 
      tl_wdid, report_month, report_year, 
      COUNT(DISTINCT CASE WHEN UPPER(kpi_applicable) = 'YES' AND UPPER(exempt) = 'NO' THEN CONCAT(program, COALESCE(country, ''), COALESCE(region, '')) END) AS final_total_programs
    FROM `ti-ca-ml-start.QA_Training_scorecards.2026_qa_voc_raw`
    GROUP BY 1, 2, 3
  ),

  /* =========================================================================================
     CTE 2: ANALYST-TO-LEAD METRIC AGGREGATION
     Rolls up granular analyst-level VOC metrics into a unified Team Lead view. Consolidates 
     applicability flags and averages VOC actuals and targets exclusively for active, non-exempt 
     analysts to protect the integrity of the hierarchical score average. Allocates the 10% metric weight.
  ========================================================================================= */
  CalculatedData AS (
    SELECT 
      'CX Quality Team Lead and Sr Team lead' AS role,
      MAX(raw.timestamp) AS timestamp, 
      MAX(raw.submitter_email) AS submitter_email,
      raw.report_month,
      raw.report_year,
      raw.tl_wdid,
      raw.tl_name,
      raw.tl_manager,
      raw.tl_sr_manager,
      raw.program,
      raw.country,
      raw.region,
      'My Customer' AS voc_business_category,
      'VOC % to Goal' AS voc_kpi,
      
      -- Consolidates analyst-level flags to determine Team Lead metric applicability
      IF(COUNTIF(LOWER(TRIM(raw.kpi_applicable)) = 'yes') > 0, 'Yes', 'No') AS voc_kpi_applicable,
      IF(COUNTIF(LOWER(TRIM(raw.exempt)) = 'no') > 0, 'No', 'Yes') AS voc_exempt,
      IF(COUNTIF(LOWER(TRIM(raw.exempt)) = 'no') > 0, 'Rolled up by TL and Program', 'Exempt') AS voc_reason,
      
      -- Calculates team average scores safely excluding exempt analysts
      IF(COUNTIF(LOWER(TRIM(raw.kpi_applicable)) = 'yes') = 0 OR COUNTIF(LOWER(TRIM(raw.exempt)) = 'no') = 0, NULL, FORMAT('%.2f%%', AVG(CASE WHEN LOWER(TRIM(raw.exempt)) = 'no' THEN CAST(REPLACE(raw.voc_score_actual, '%', '') AS FLOAT64) ELSE NULL END))) AS voc_score_actual,
      IF(COUNTIF(LOWER(TRIM(raw.kpi_applicable)) = 'yes') = 0 OR COUNTIF(LOWER(TRIM(raw.exempt)) = 'no') = 0, NULL, FORMAT('%.2f%%', AVG(CASE WHEN LOWER(TRIM(raw.exempt)) = 'no' THEN CAST(REPLACE(raw.voc_score_target_program, '%', '') AS FLOAT64) ELSE NULL END))) AS voc_score_target_program,
      
      pc.final_total_programs,
      
      -- Dynamic metric weight allocation (10%) with hierarchical exemption logic
      CASE 
        WHEN COUNTIF(LOWER(TRIM(raw.kpi_applicable)) = 'yes') > 0 AND COUNTIF(LOWER(TRIM(raw.exempt)) = 'no') > 0 THEN 0.10 
        ELSE NULL 
      END AS voc_weight,

      -- Standardized Percentage to Goal ratio based on active analyst averages
      SAFE_DIVIDE(
        AVG(CASE WHEN LOWER(TRIM(raw.exempt)) = 'no' THEN CAST(REPLACE(raw.voc_score_actual, '%', '') AS FLOAT64) ELSE NULL END), 
        AVG(CASE WHEN LOWER(TRIM(raw.exempt)) = 'no' THEN CAST(REPLACE(raw.voc_score_target_program, '%', '') AS FLOAT64) ELSE NULL END)
      ) AS voc_single_multi_program,

      -- Isolates the ratio strictly for Team Leads supporting a single program
      CASE WHEN pc.final_total_programs = 1 THEN
        SAFE_DIVIDE(
          AVG(CASE WHEN LOWER(TRIM(raw.exempt)) = 'no' THEN CAST(REPLACE(raw.voc_score_actual, '%', '') AS FLOAT64) ELSE NULL END), 
          AVG(CASE WHEN LOWER(TRIM(raw.exempt)) = 'no' THEN CAST(REPLACE(raw.voc_score_target_program, '%', '') AS FLOAT64) ELSE NULL END)
        )
      ELSE NULL END AS voc_single_program,

      -- Preserves the unaltered ratio to fuel the multi-program capping engine
      SAFE_DIVIDE(
        AVG(CASE WHEN LOWER(TRIM(raw.exempt)) = 'no' THEN CAST(REPLACE(raw.voc_score_actual, '%', '') AS FLOAT64) ELSE NULL END), 
        AVG(CASE WHEN LOWER(TRIM(raw.exempt)) = 'no' THEN CAST(REPLACE(raw.voc_score_target_program, '%', '') AS FLOAT64) ELSE NULL END)
      ) AS _raw_calc
    FROM 
      `ti-ca-ml-start.QA_Training_scorecards.2026_qa_voc_raw` AS raw
    LEFT JOIN ProgramCounts AS pc 
      ON raw.tl_wdid = pc.tl_wdid AND raw.report_month = pc.report_month AND raw.report_year = pc.report_year
    GROUP BY 4,5,6,7,8,9,10,11,12, pc.final_total_programs
  ),

  /* =========================================================================================
     CTE 3: MULTI-PROGRAM CAPPING LOGIC
     Normalizes performance outliers for Team Leads managing multiple programs. Applies a 
     continuous range logic using VOC-specific bounds to group raw averaged scores into 
     predefined capped tiers, preventing evaluation gaps.
  ========================================================================================= */
  CappedData AS (
    SELECT * EXCEPT(_raw_calc),
      IF(voc_exempt = 'Yes', NULL,
        CASE WHEN final_total_programs >= 2 THEN
            CASE 
              WHEN _raw_calc <= 0.50 THEN 0
              WHEN _raw_calc <= 0.85 THEN 0.50
              WHEN _raw_calc < 0.96  THEN 0.75
              WHEN _raw_calc < 1.15  THEN 1.00
              WHEN _raw_calc >= 1.15 THEN 1.15
              ELSE _raw_calc
            END
        ELSE NULL END) AS voc_multi_program,
      IF(voc_exempt = 'Yes', NULL,
        COALESCE(voc_single_program, 
                 CASE WHEN final_total_programs >= 2 THEN
                   CASE 
                     WHEN _raw_calc <= 0.50 THEN 0
                     WHEN _raw_calc <= 0.85 THEN 0.50
                     WHEN _raw_calc < 0.96  THEN 0.75
                     WHEN _raw_calc < 1.15  THEN 1.00
                     WHEN _raw_calc >= 1.15 THEN 1.15
                     ELSE _raw_calc
                   END
                 ELSE NULL END)) AS voc_perf_vs_cap_uncapped
    FROM CalculatedData
  ),

  /* =========================================================================================
     CTE 4: DILUTION, TIERING & POINT ASSIGNMENT
     Calculates the program-adjusted score and maps it against continuous VOC performance 
     thresholds (<85%, <95%, <96%, >=96%) to assign the final Achievement Category and 
     standardized Metric Points (1-4).
  ========================================================================================= */
  CategorizedAndPointsData AS (
    SELECT *,
      -- Dilutes the capped score evenly across the Team Lead's total active programs
      IF(voc_exempt = 'Yes', NULL, voc_perf_vs_cap_uncapped * SAFE_DIVIDE(1.0, final_total_programs)) AS adjusted_score_based_on_cap,

      -- Continuous tier mapping utilizing VOC-specific thresholds
      IF(voc_exempt = 'Yes', NULL,
        CASE 
          WHEN voc_perf_vs_cap_uncapped < 0.85 THEN 'Improvement Required'
          WHEN voc_perf_vs_cap_uncapped < 0.95 THEN 'Developing'
          WHEN voc_perf_vs_cap_uncapped < 0.96 THEN 'Achieving'
          WHEN voc_perf_vs_cap_uncapped >= 0.96 THEN 'Excelling'
          ELSE NULL 
        END) AS achievement_category,
      IF(voc_exempt = 'Yes', NULL,
        CASE 
          WHEN voc_perf_vs_cap_uncapped < 0.85 THEN 1
          WHEN voc_perf_vs_cap_uncapped < 0.95 THEN 2
          WHEN voc_perf_vs_cap_uncapped < 0.96 THEN 3
          WHEN voc_perf_vs_cap_uncapped >= 0.96 THEN 4
          ELSE NULL 
        END) AS voc_points_obtained
    FROM CappedData
  )

  /* =========================================================================================
     FINAL OUTPUT: WEIGHT DISTRIBUTION & SCORING
     Finalizes the scorecard presentation layer. Calculates final numerical points and 
     formatted earned weights, distributing the impact proportionally across the managed 
     program footprint to ensure accurate global scorecard aggregation.
  ========================================================================================= */
  SELECT 
    *,
    -- Calculates the fractional weight obtained (quartered based on a 4-point scale)
    IF(voc_exempt = 'Yes', NULL, (voc_points_obtained / 4.0) * voc_weight) AS voc_weight_obtaiend,
    
    -- Numerical points derived for final global score aggregation
    IF(voc_exempt = 'Yes', NULL, voc_points_obtained * voc_weight) AS voc_points_obtained_for_final_score_only,
    
    -- Dilutes the earned fractional weight proportionally across the active managed footprint
    IF(voc_exempt = 'Yes', NULL,
      (CASE 
        WHEN achievement_category = 'Improvement Required' THEN voc_weight * 0.25
        WHEN achievement_category = 'Developing' THEN voc_weight * 0.50
        WHEN achievement_category = 'Achieving' THEN voc_weight * 0.75
        WHEN achievement_category = 'Excelling' THEN voc_weight * 1.00
        ELSE NULL 
      END) * SAFE_DIVIDE(1.0, final_total_programs)) AS voc_weight_obtaiend_program_diluted,

    -- Program-diluted final numerical points generation for proportional scorecard aggregation
    IF(voc_exempt = 'Yes', NULL,
      CASE 
        WHEN final_total_programs = 1 THEN CAST(voc_points_obtained * voc_weight AS FLOAT64)
        ELSE CAST(voc_points_obtained * SAFE_DIVIDE(voc_weight, final_total_programs) AS FLOAT64)
      END
    ) AS voc_points_obtained_for_final_score_only_program_diluted
  
  FROM 
    CategorizedAndPointsData;

END;
