CREATE OR REPLACE PROCEDURE `ti-ca-ml-start.QA_Training_scorecards.step4_sp_2026_unpivot_qa_analyst_pr`()
BEGIN

  /************************************************************************************************
   PROCEDURE: step4_sp_2026_unpivot_qa_analyst_pr
   DESCRIPTION: Big Rolled-Up Payroll (PR) Unpivot structure for CX Quality Analysts[cite: 29]. 
                Collapses operational granularity to the Person/Month/Year/KPI level for 6 base metrics[cite: 29]. 
                Updates percent_to_target calculations using the SUM of capped adjusted scores for 
                QA & VOC metrics[cite: 29]. Dynamically generates the 'Final Score' row based on total 
                ratings obtained[cite: 29]. Calculates two month-over-month progressive Year-to-Date (YTD) 
                cumulative metrics (`ytd_final_scores` and `ytd_final_tier`)[cite: 29] and appends a 
                dynamic `is_latest_month` boolean flag for seamless Looker Studio filtering[cite: 29]. 
                Integrates the standardized 3-Level Row Level Security (RLS) model[cite: 29].
  ************************************************************************************************/

  CREATE OR REPLACE TABLE `ti-ca-ml-start.QA_Training_scorecards.2026_scorecard_quality_analyst_unpivoted_pr` AS

  WITH 
    /* =========================================================================================
       CTE 1: DYNAMIC FULL ACCESS EMAIL CONSOLIDATION
       Aggregates privileged system access emails across Telus Digital and Telus International sources 
       to construct a universal RLS bypass list[cite: 29].
    ========================================================================================= */
    full_access_list AS (
      SELECT STRING_AGG(email, ',') AS full_access_emails
      FROM (
        SELECT LOWER(TRIM(telus_digital_email)) AS email 
        FROM `ti-ca-ml-start.QA_Training_scorecards.2026_full_access_security_emails_raw` 
        WHERE telus_digital_email IS NOT NULL AND TRIM(telus_digital_email) != ''
        
        UNION DISTINCT
        
        SELECT LOWER(TRIM(telus_international_email)) AS email 
        FROM `ti-ca-ml-start.QA_Training_scorecards.2026_full_access_security_emails_raw` 
        WHERE telus_international_email IS NOT NULL AND TRIM(telus_international_email) != ''
      )
    ),

    /* =========================================================================================
       CTE 2: HISTORICAL ROSTER SECURITY MAPPING
       Extracts global roster supervisory chains per employee, month, and year[cite: 29]. Cleanses Workday IDs 
       and month keys, aggregating up to 6 supervisory levels into comma-separated lists[cite: 29].
    ========================================================================================= */
    roster_security AS (
      SELECT 
        REGEXP_REPLACE(TRIM(CAST(employee_id AS STRING)), r'\.0$', '') AS employee_id_std,
        UPPER(TRIM(SUBSTR(CAST(month AS STRING), 1, 3))) AS month_std,
        SAFE_CAST(year AS STRING) AS year_std,
        LOWER(TRIM(email_primary_work)) AS evaluated_email,
        LOWER(TRIM(inmediate_supervisor_1_email)) AS supervisor_1_email,
        ARRAY_TO_STRING(
          ARRAY(
            SELECT DISTINCT email
            FROM UNNEST([
              LOWER(TRIM(email_primary_work)),
              LOWER(TRIM(inmediate_supervisor_1_email)),
              LOWER(TRIM(inmediate_supervisor_2_email)),
              LOWER(TRIM(inmediate_supervisor_3_email)),
              LOWER(TRIM(inmediate_supervisor_4_email)),
              LOWER(TRIM(inmediate_supervisor_5_email)),
              LOWER(TRIM(inmediate_supervisor_6_email))
            ]) AS email
            WHERE email IS NOT NULL AND TRIM(email) != ''
          ), ','
        ) AS full_chain_emails
      FROM `ti-ca-ml-start.QA_Training_scorecards.2026_historical_qa_global_roster_proposal_raw`
      WHERE employee_id IS NOT NULL 
        AND TRIM(CAST(employee_id AS STRING)) NOT IN ('', '-', 'NULL')
      QUALIFY ROW_NUMBER() OVER(
        PARTITION BY 
          REGEXP_REPLACE(TRIM(CAST(employee_id AS STRING)), r'\.0$', ''),
          UPPER(TRIM(SUBSTR(CAST(month AS STRING), 1, 3))),
          SAFE_CAST(year AS STRING)
        ORDER BY employee_id
      ) = 1
    ),

    /* =========================================================================================
       CTE 3: CONSOLIDATED SOURCE SELECTION
       Loads consolidated CX Analyst metrics, filtering out null Workday IDs[cite: 29].
    ========================================================================================= */
    source AS (
      SELECT * FROM `ti-ca-ml-start.QA_Training_scorecards.2026_scorecard_quality_analyst_consolidated`
      WHERE tm_wdid IS NOT NULL
    ),

    /* =========================================================================================
       CTE 4: EXCLUSIVE UNPIVOT OF 6 BASE METRICS (CAPPING ENFORCED FOR QA & VOC)
       Unpivots the six base operational and development metrics into a unified structure[cite: 29]. 
       Parses percentage strings to numeric ratios and enforces capped scores for QA and VOC[cite: 29].
    ========================================================================================= */
    unpivoted_data AS (
      -- BLOCK 1: QUALITY % TO GOAL (WITH CAPPING)
      SELECT 
        PARSE_DATE('%b %E4Y', CONCAT(INITCAP(report_month), ' ', CAST(report_year AS STRING))) AS performance_date,
        report_year, report_month, 'CX Quality Analyst' AS position_role,
        SAFE_CAST(tm_wdid AS STRING) AS employee_id, tm_name AS quality_team_member,
        tl_name AS immediate_supervisor, tl_manager AS immediate_manager, tl_sr_manager AS immediate_sr_manager,
        'Quality % to Goal' AS kpi, qaptg_business_category AS business_category, 
        SAFE_CAST(qa_weight AS FLOAT64) AS weight_master,
        CASE WHEN STRPOS(CAST(quality_score_target_program AS STRING), '%') > 0 THEN SAFE_CAST(REPLACE(CAST(quality_score_target_program AS STRING), '%', '') AS FLOAT64) / 100 ELSE SAFE_CAST(quality_score_target_program AS FLOAT64) END AS target_master,
        COALESCE(
          CASE WHEN STRPOS(CAST(qa_adjusted_score_based_on_cap AS STRING), '%') > 0 THEN SAFE_CAST(REPLACE(CAST(qa_adjusted_score_based_on_cap AS STRING), '%', '') AS FLOAT64) / 100 ELSE SAFE_CAST(qa_adjusted_score_based_on_cap AS FLOAT64) END,
          SAFE_CAST(qa_single_multi_program AS FLOAT64)
        ) AS target_obtained
      FROM source
      UNION ALL
      -- BLOCK 2: VOC % TO GOAL (WITH CAPPING)
      SELECT 
        PARSE_DATE('%b %E4Y', CONCAT(INITCAP(report_month), ' ', CAST(report_year AS STRING))),
        report_year, report_month, 'CX Quality Analyst', SAFE_CAST(tm_wdid AS STRING), tm_name,
        tl_name, tl_manager, tl_sr_manager,
        'VOC % to Goal', voc_business_category, SAFE_CAST(voc_weight AS FLOAT64),
        CASE WHEN STRPOS(CAST(voc_score_target_program AS STRING), '%') > 0 THEN SAFE_CAST(REPLACE(CAST(voc_score_target_program AS STRING), '%', '') AS FLOAT64) / 100 ELSE SAFE_CAST(voc_score_target_program AS FLOAT64) END,
        COALESCE(
          CASE WHEN STRPOS(CAST(voc_adjusted_score_based_on_cap AS STRING), '%') > 0 THEN SAFE_CAST(REPLACE(CAST(voc_adjusted_score_based_on_cap AS STRING), '%', '') AS FLOAT64) / 100 ELSE SAFE_CAST(voc_adjusted_score_based_on_cap AS FLOAT64) END,
          SAFE_CAST(voc_single_multi_program AS FLOAT64)
        )
      FROM source
      UNION ALL
      -- BLOCK 3: TEAM DEVELOPMENT
      SELECT 
        PARSE_DATE('%b %E4Y', CONCAT(INITCAP(report_month), ' ', CAST(report_year AS STRING))),
        report_year, report_month, 'CX Quality Analyst', SAFE_CAST(tm_wdid AS STRING), tm_name,
        tl_name, tl_manager, tl_sr_manager,
        'Team Development', td_business_category, SAFE_CAST(td_weight AS FLOAT64),
        SAFE_CAST(td_target AS FLOAT64), SAFE_CAST(td_ptg AS FLOAT64)
      FROM source
      UNION ALL
      -- BLOCK 4: PRODUCTIVITY
      SELECT 
        PARSE_DATE('%b %E4Y', CONCAT(INITCAP(report_month), ' ', CAST(report_year AS STRING))),
        report_year, report_month, 'CX Quality Analyst', SAFE_CAST(tm_wdid AS STRING), tm_name,
        tl_name, tl_manager, tl_sr_manager,
        'Productivity', productivity_business_category, SAFE_CAST(productivity_weight_master AS FLOAT64),
        CASE WHEN STRPOS(CAST(productivity_target_master AS STRING), '%') > 0 THEN SAFE_CAST(REPLACE(CAST(productivity_target_master AS STRING), '%', '') AS FLOAT64) / 100 ELSE SAFE_CAST(productivity_target_master AS FLOAT64) END,
        SAFE_CAST(REPLACE(CAST(productivity_pct_to_goal AS STRING), '%', '') AS FLOAT64) / 100
      FROM source
      UNION ALL
      -- BLOCK 5: ACCURACY % TO GOAL
      SELECT 
        PARSE_DATE('%b %E4Y', CONCAT(INITCAP(report_month), ' ', CAST(report_year AS STRING))),
        report_year, report_month, 'CX Quality Analyst', SAFE_CAST(tm_wdid AS STRING), tm_name,
        tl_name, tl_manager, tl_sr_manager,
        'Accuracy % to Goal', accuracy_business_category, SAFE_CAST(accuracy_weight_master AS FLOAT64),
        CASE WHEN STRPOS(CAST(accuracy_target_master AS STRING), '%') > 0 THEN SAFE_CAST(REPLACE(CAST(accuracy_target_master AS STRING), '%', '') AS FLOAT64) / 100 ELSE SAFE_CAST(accuracy_target_master AS FLOAT64) END,
        SAFE_CAST(REPLACE(CAST(accuracy_pct_to_goal AS STRING), '%', '') AS FLOAT64) / 100
      FROM source
      UNION ALL
      -- BLOCK 6: PPD
      SELECT 
        PARSE_DATE('%b %E4Y', CONCAT(INITCAP(report_month), ' ', CAST(report_year AS STRING))),
        report_year, report_month, 'CX Quality Analyst', SAFE_CAST(tm_wdid AS STRING), tm_name,
        tl_name, tl_manager, tl_sr_manager,
        'PPD', ppd_businesscategory, SAFE_CAST(ppd_weight AS FLOAT64),
        SAFE_CAST(ppd_target AS FLOAT64), SAFE_CAST(ppd_ptg AS FLOAT64)
      FROM source
    ),

    /* =========================================================================================
       CTE 5: BIG ROLLED-UP OF THE 6 BASE METRICS
       Aggregates metrics by Person/Month/Year/KPI[cite: 29]. Sums capped actuals for QA and VOC, 
       while averaging targets and weights for the remaining metrics[cite: 29].
    ========================================================================================= */
    aggregated_pr AS (
      SELECT 
        MAX(performance_date) AS performance_date,
        report_year, report_month, position_role, employee_id,
        ANY_VALUE(quality_team_member) AS quality_team_member,
        ANY_VALUE(immediate_supervisor) AS immediate_supervisor,
        ANY_VALUE(immediate_manager) AS immediate_manager,
        ANY_VALUE(immediate_sr_manager) AS immediate_sr_manager,
        kpi, ANY_VALUE(business_category) AS business_category,
        AVG(weight_master) AS weight_master,
        AVG(target_master) AS target_master,
        CASE 
          WHEN kpi IN ('Quality % to Goal', 'VOC % to Goal') THEN SUM(target_obtained)
          ELSE AVG(target_obtained)
        END AS percent_to_target
      FROM unpivoted_data
      GROUP BY report_year, report_month, position_role, employee_id, kpi
    ),

    /* =========================================================================================
       CTE 6: BASE CALCULATION FOR 6 METRICS
       Assigns achievement tiers ('IR', 'D', 'A', 'E'), maximum available points, and metric points 
       based on standard metric-specific thresholds[cite: 29].
    ========================================================================================= */
    base_metrics AS (
      SELECT 
        a.*,
        
        -- ACHIEVEMENT TIER (Base metrics)
        CASE 
          WHEN a.kpi = 'Quality % to Goal' THEN 
            CASE WHEN a.percent_to_target IS NULL THEN NULL WHEN a.percent_to_target < 0.90 THEN 'IR' WHEN a.percent_to_target < 1.00 THEN 'D' WHEN a.percent_to_target < 1.01 THEN 'A' ELSE 'E' END
          WHEN a.kpi = 'VOC % to Goal' THEN 
            CASE WHEN a.percent_to_target IS NULL THEN NULL WHEN a.percent_to_target < 0.85 THEN 'IR' WHEN a.percent_to_target < 0.95 THEN 'D' WHEN a.percent_to_target < 0.96 THEN 'A' ELSE 'E' END
          WHEN a.kpi = 'Productivity' THEN 
            CASE WHEN a.percent_to_target IS NULL THEN NULL WHEN a.percent_to_target < 0.90 THEN 'IR' WHEN a.percent_to_target < 1.00 THEN 'D' ELSE 'A' END
          WHEN a.kpi = 'Accuracy % to Goal' THEN 
            CASE WHEN a.percent_to_target IS NULL THEN NULL WHEN a.percent_to_target < 0.90 THEN 'IR' WHEN a.percent_to_target < 0.95 THEN 'D' WHEN a.percent_to_target < 0.96 THEN 'A' ELSE 'E' END
          WHEN a.kpi = 'Team Development' THEN 
            CASE WHEN a.percent_to_target IS NULL THEN NULL WHEN a.percent_to_target < 0.75 THEN 'IR' WHEN a.percent_to_target < 1.00 THEN 'D' WHEN a.percent_to_target < (13.0 / 12.0) THEN 'A' ELSE 'E' END
          WHEN a.kpi = 'PPD' THEN 
            CASE WHEN a.percent_to_target IS NULL THEN NULL WHEN a.percent_to_target < 0.40 THEN 'IR' WHEN a.percent_to_target < 0.85 THEN 'D' WHEN a.percent_to_target < 1.00 THEN 'A' ELSE 'E' END
        END AS achievement_tier,

        -- MAX POINTS AVAILABLE
        CASE 
          WHEN a.percent_to_target IS NULL THEN NULL
          WHEN a.kpi = 'Productivity' THEN 3.0
          ELSE 4.0
        END AS max_points_available,

        -- METRIC POINTS
        CASE 
          WHEN a.percent_to_target IS NULL THEN NULL
          ELSE
            CASE 
              WHEN (CASE WHEN a.kpi = 'Quality % to Goal' THEN CASE WHEN a.percent_to_target < 0.90 THEN 'IR' WHEN a.percent_to_target < 1.00 THEN 'D' WHEN a.percent_to_target < 1.01 THEN 'A' ELSE 'E' END
                         WHEN a.kpi = 'VOC % to Goal' THEN CASE WHEN a.percent_to_target < 0.85 THEN 'IR' WHEN a.percent_to_target < 0.95 THEN 'D' WHEN a.percent_to_target < 0.96 THEN 'A' ELSE 'E' END
                         WHEN a.kpi = 'Productivity' THEN CASE WHEN a.percent_to_target < 0.90 THEN 'IR' WHEN a.percent_to_target < 1.00 THEN 'D' ELSE 'A' END
                         WHEN a.kpi = 'Accuracy % to Goal' THEN CASE WHEN a.percent_to_target < 0.90 THEN 'IR' WHEN a.percent_to_target < 0.95 THEN 'D' WHEN a.percent_to_target < 0.96 THEN 'A' ELSE 'E' END
                         WHEN a.kpi = 'Team Development' THEN CASE WHEN a.percent_to_target < 0.75 THEN 'IR' WHEN a.percent_to_target < 1.00 THEN 'D' WHEN a.percent_to_target < (13.0/12.0) THEN 'A' ELSE 'E' END
                         WHEN a.kpi = 'PPD' THEN CASE WHEN a.percent_to_target < 0.40 THEN 'IR' WHEN a.percent_to_target < 0.85 THEN 'D' WHEN a.percent_to_target < 1.00 THEN 'A' ELSE 'E' END
                   END) = 'IR' THEN 1.0
              WHEN (CASE WHEN a.kpi = 'Quality % to Goal' THEN CASE WHEN a.percent_to_target < 0.90 THEN 'IR' WHEN a.percent_to_target < 1.00 THEN 'D' WHEN a.percent_to_target < 1.01 THEN 'A' ELSE 'E' END
                         WHEN a.kpi = 'VOC % to Goal' THEN CASE WHEN a.percent_to_target < 0.85 THEN 'IR' WHEN a.percent_to_target < 0.95 THEN 'D' WHEN a.percent_to_target < 0.96 THEN 'A' ELSE 'E' END
                         WHEN a.kpi = 'Productivity' THEN CASE WHEN a.percent_to_target < 0.90 THEN 'IR' WHEN a.percent_to_target < 1.00 THEN 'D' ELSE 'A' END
                         WHEN a.kpi = 'Accuracy % to Goal' THEN CASE WHEN a.percent_to_target < 0.90 THEN 'IR' WHEN a.percent_to_target < 0.95 THEN 'D' WHEN a.percent_to_target < 0.96 THEN 'A' ELSE 'E' END
                         WHEN a.kpi = 'Team Development' THEN CASE WHEN a.percent_to_target < 0.75 THEN 'IR' WHEN a.percent_to_target < 1.00 THEN 'D' WHEN a.percent_to_target < (13.0/12.0) THEN 'A' ELSE 'E' END
                         WHEN a.kpi = 'PPD' THEN CASE WHEN a.percent_to_target < 0.40 THEN 'IR' WHEN a.percent_to_target < 0.85 THEN 'D' WHEN a.percent_to_target < 1.00 THEN 'A' ELSE 'E' END
                   END) = 'D' THEN 2.0
              WHEN (CASE WHEN a.kpi = 'Quality % to Goal' THEN CASE WHEN a.percent_to_target < 0.90 THEN 'IR' WHEN a.percent_to_target < 1.00 THEN 'D' WHEN a.percent_to_target < 1.01 THEN 'A' ELSE 'E' END
                         WHEN a.kpi = 'VOC % to Goal' THEN CASE WHEN a.percent_to_target < 0.85 THEN 'IR' WHEN a.percent_to_target < 0.95 THEN 'D' WHEN a.percent_to_target < 0.96 THEN 'A' ELSE 'E' END
                         WHEN a.kpi = 'Productivity' THEN CASE WHEN a.percent_to_target < 0.90 THEN 'IR' WHEN a.percent_to_target < 1.00 THEN 'D' ELSE 'A' END
                         WHEN a.kpi = 'Accuracy % to Goal' THEN CASE WHEN a.percent_to_target < 0.90 THEN 'IR' WHEN a.percent_to_target < 0.95 THEN 'D' WHEN a.percent_to_target < 0.96 THEN 'A' ELSE 'E' END
                         WHEN a.kpi = 'Team Development' THEN CASE WHEN a.percent_to_target < 0.75 THEN 'IR' WHEN a.percent_to_target < 1.00 THEN 'D' WHEN a.percent_to_target < (13.0/12.0) THEN 'A' ELSE 'E' END
                         WHEN a.kpi = 'PPD' THEN CASE WHEN a.percent_to_target < 0.40 THEN 'IR' WHEN a.percent_to_target < 0.85 THEN 'D' WHEN a.percent_to_target < 1.00 THEN 'A' ELSE 'E' END
                   END) = 'A' THEN 3.0
              WHEN (CASE WHEN a.kpi = 'Quality % to Goal' THEN CASE WHEN a.percent_to_target < 0.90 THEN 'IR' WHEN a.percent_to_target < 1.00 THEN 'D' WHEN a.percent_to_target < 1.01 THEN 'A' ELSE 'E' END
                         WHEN a.kpi = 'VOC % to Goal' THEN CASE WHEN a.percent_to_target < 0.85 THEN 'IR' WHEN a.percent_to_target < 0.95 THEN 'D' WHEN a.percent_to_target < 0.96 THEN 'A' ELSE 'E' END
                         WHEN a.kpi = 'Productivity' THEN CASE WHEN a.percent_to_target < 0.90 THEN 'IR' WHEN a.percent_to_target < 1.00 THEN 'D' ELSE 'A' END
                         WHEN a.kpi = 'Accuracy % to Goal' THEN CASE WHEN a.percent_to_target < 0.90 THEN 'IR' WHEN a.percent_to_target < 0.95 THEN 'D' WHEN a.percent_to_target < 0.96 THEN 'A' ELSE 'E' END
                         WHEN a.kpi = 'Team Development' THEN CASE WHEN a.percent_to_target < 0.75 THEN 'IR' WHEN a.percent_to_target < 1.00 THEN 'D' WHEN a.percent_to_target < (13.0/12.0) THEN 'A' ELSE 'E' END
                         WHEN a.kpi = 'PPD' THEN CASE WHEN a.percent_to_target < 0.40 THEN 'IR' WHEN a.percent_to_target < 0.85 THEN 'D' WHEN a.percent_to_target < 1.00 THEN 'A' ELSE 'E' END
                   END) = 'E' THEN 4.0
            END
        END AS metric_points
      FROM aggregated_pr a
    ),
    
    /* =========================================================================================
       CTE 7: MULTIPLIED CALCULATIONS FOR 6 METRICS
       Computes earned weights (`metric_weight_obtained`), maximum available ratings 
       (`max_rating_available`), and ratings obtained (`rating_obtained`)[cite: 29].
    ========================================================================================= */
    calculated_base_metrics AS (
      SELECT 
        *,
        IF(metric_points IS NOT NULL AND weight_master IS NOT NULL, weight_master * (metric_points / 4.0), NULL) AS metric_weight_obtained,
        IF(percent_to_target IS NOT NULL AND max_points_available IS NOT NULL AND weight_master IS NOT NULL, weight_master * max_points_available, NULL) AS max_rating_available,
        IF(metric_points IS NOT NULL AND weight_master IS NOT NULL, weight_master * metric_points, NULL) AS rating_obtained
      FROM base_metrics
    ),

    /* =========================================================================================
       CTE 8: 'FINAL SCORE' ROW GENERATION
       Aggregates monthly ratings across active metrics to dynamically construct the overall 
       'Final Score' row and assign overall achievement tiers ('IR', 'D', 'A', 'E')[cite: 29].
    ========================================================================================= */
    final_score_cte AS (
      SELECT 
        MAX(performance_date) AS performance_date,
        report_year, 
        report_month, 
        ANY_VALUE(position_role) AS position_role,
        employee_id, 
        ANY_VALUE(quality_team_member) AS quality_team_member,
        ANY_VALUE(immediate_supervisor) AS immediate_supervisor, 
        ANY_VALUE(immediate_manager) AS immediate_manager, 
        ANY_VALUE(immediate_sr_manager) AS immediate_sr_manager,
        'Final Score' AS kpi,
        'All' AS business_category,
        
        -- Sum of active Weight Master for the month
        SUM(weight_master) AS weight_master,
        
        CAST(NULL AS FLOAT64) AS target_master,
        
        -- Percent to target (Rating Obtained / Max Rating Available)
        SUM(rating_obtained) / NULLIF(SUM(max_rating_available), 0) AS percent_to_target,
        
        -- Achievement Tier for Final Score (With Rounding)
        CASE 
          WHEN SUM(max_rating_available) IS NULL OR SUM(max_rating_available) = 0 THEN NULL
          WHEN ROUND(SUM(rating_obtained) / NULLIF(SUM(max_rating_available), 0), 4) < 0.50 THEN 'IR'
          WHEN ROUND(SUM(rating_obtained) / NULLIF(SUM(max_rating_available), 0), 4) < 0.75 THEN 'D'
          WHEN ROUND(SUM(rating_obtained) / NULLIF(SUM(max_rating_available), 0), 4) <= 0.8725 THEN 'A'
          ELSE 'E'
        END AS achievement_tier,

        SUM(max_points_available) AS max_points_available,
        SUM(metric_points) AS metric_points,
        SUM(weight_master) AS metric_weight_obtained,
        SUM(max_rating_available) AS max_rating_available,
        SUM(rating_obtained) AS rating_obtained
      FROM calculated_base_metrics
      -- Only sum if there were targets
      WHERE percent_to_target IS NOT NULL 
      GROUP BY report_year, report_month, employee_id
    ),

    /* =========================================================================================
       CTE 9: METRIC CONSOLIDATION
       Unions the six base operational/development metrics with the aggregated 'Final Score' row[cite: 29].
    ========================================================================================= */
    all_metrics AS (
      SELECT * FROM calculated_base_metrics
      UNION ALL
      SELECT * FROM final_score_cte
    ),

    /* =========================================================================================
       CTE 10: PROGRESSIVE YTD FINAL SCORES CALCULATION
       Computes month-over-month running cumulative average ratios (`ytd_final_scores`) 
       partitioned by Employee ID, Year, and KPI[cite: 29].
    ========================================================================================= */
    metrics_with_ytd AS (
      SELECT 
        m.*,
        
        -- Cumulative average of percent_to_target from start of year up to current month
        AVG(m.percent_to_target) OVER(
          PARTITION BY m.employee_id, m.report_year, m.kpi
          ORDER BY m.performance_date
          ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
        ) AS ytd_final_scores
      FROM all_metrics m
    ),

    /* =========================================================================================
       CTE 11: YTD FINAL TIER CALCULATION
       Maps cumulative `ytd_final_scores` ratios to progressive YTD achievement tiers (`ytd_final_tier`)[cite: 29].
    ========================================================================================= */
    final_metrics AS (
      SELECT 
        y.*,
        
        -- YTD Tier evaluation on ytd_final_scores
        CASE 
          WHEN y.ytd_final_scores IS NULL THEN NULL
          WHEN y.kpi = 'Quality % to Goal' THEN 
            CASE WHEN y.ytd_final_scores < 0.90 THEN 'IR' WHEN y.ytd_final_scores < 1.00 THEN 'D' WHEN y.ytd_final_scores < 1.01 THEN 'A' ELSE 'E' END
          WHEN y.kpi = 'VOC % to Goal' THEN 
            CASE WHEN y.ytd_final_scores < 0.85 THEN 'IR' WHEN y.ytd_final_scores < 0.95 THEN 'D' WHEN y.ytd_final_scores < 0.96 THEN 'A' ELSE 'E' END
          WHEN y.kpi = 'Productivity' THEN 
            CASE WHEN y.ytd_final_scores < 0.90 THEN 'IR' WHEN y.ytd_final_scores < 1.00 THEN 'D' ELSE 'A' END
          WHEN y.kpi = 'Accuracy % to Goal' THEN 
            CASE WHEN y.ytd_final_scores < 0.90 THEN 'IR' WHEN y.ytd_final_scores < 0.95 THEN 'D' WHEN y.ytd_final_scores < 0.96 THEN 'A' ELSE 'E' END
          WHEN y.kpi = 'Team Development' THEN 
            CASE WHEN y.ytd_final_scores < 0.75 THEN 'IR' WHEN y.ytd_final_scores < 1.00 THEN 'D' WHEN y.ytd_final_scores < (13.0 / 12.0) THEN 'A' ELSE 'E' END
          WHEN y.kpi = 'PPD' THEN 
            CASE WHEN y.ytd_final_scores < 0.40 THEN 'IR' WHEN y.ytd_final_scores < 0.85 THEN 'D' WHEN y.ytd_final_scores < 1.00 THEN 'A' ELSE 'E' END
          WHEN y.kpi = 'Final Score' THEN 
            CASE 
              WHEN ROUND(y.ytd_final_scores, 4) < 0.50 THEN 'IR'
              WHEN ROUND(y.ytd_final_scores, 4) < 0.75 THEN 'D'
              WHEN ROUND(y.ytd_final_scores, 4) <= 0.8725 THEN 'A'
              ELSE 'E'
            END
        END AS ytd_final_tier
      FROM metrics_with_ytd y
    )
    
  /* =========================================================================================
     FINAL SELECTION & 3-LEVEL SECURITY COUPLING
     Projects unpivoted dimensions, appends the dynamic `is_latest_month` boolean flag[cite: 29], 
     and couples the 3-Level Row Level Security (RLS) governance model[cite: 29].
  ========================================================================================= */
  SELECT 
    f.performance_date, 
    f.report_year, 
    f.report_month, 
    f.position_role, 
    f.employee_id, 
    f.quality_team_member, 
    f.immediate_supervisor, 
    f.immediate_manager, 
    f.immediate_sr_manager,
    f.kpi, 
    f.business_category, 
    f.weight_master,
    f.target_master,
    f.percent_to_target,
    f.achievement_tier,
    f.max_points_available,
    f.metric_points,
    f.metric_weight_obtained,
    f.max_rating_available,
    f.rating_obtained,
    f.ytd_final_scores,
    f.ytd_final_tier,
    
    -- DYNAMIC LATEST MONTH FLAG FOR PERMANENT LOOKER STUDIO FILTER
    IF(f.performance_date = MAX(f.performance_date) OVER(PARTITION BY f.report_year), TRUE, FALSE) AS is_latest_month,
    
    -- FIRST LEVEL SECURITY: Evaluated Employee Email + Full Access System Emails
    NULLIF(
      ARRAY_TO_STRING(ARRAY(SELECT DISTINCT email FROM UNNEST(SPLIT(CONCAT(IFNULL(r.evaluated_email, ''),',',IFNULL(fa.full_access_emails, '')), ',')) AS email WHERE email IS NOT NULL AND TRIM(email) != ''), ','), ''
    ) AS first_level_security,

    -- SECOND LEVEL SECURITY: Immediate Supervisor 1 Email + Full Access System Emails
    NULLIF(
      ARRAY_TO_STRING(ARRAY(SELECT DISTINCT email FROM UNNEST(SPLIT(CONCAT(IFNULL(r.supervisor_1_email, ''),',',IFNULL(fa.full_access_emails, '')), ',')) AS email WHERE email IS NOT NULL AND TRIM(email) != ''), ','), ''
    ) AS second_level_security,

    -- THIRD LEVEL SECURITY: Evaluated Email + Full Hierarchy Chain (L1-L6) + Full Access System Emails
    NULLIF(
      ARRAY_TO_STRING(ARRAY(SELECT DISTINCT email FROM UNNEST(SPLIT(CONCAT(IFNULL(r.full_chain_emails, ''),',',IFNULL(fa.full_access_emails, '')), ',')) AS email WHERE email IS NOT NULL AND TRIM(email) != ''), ','), ''
    ) AS third_level_security

  FROM final_metrics f
  CROSS JOIN full_access_list fa
  LEFT JOIN roster_security r
    ON REGEXP_REPLACE(TRIM(CAST(f.employee_id AS STRING)), r'\.0$', '') = r.employee_id_std
   AND UPPER(TRIM(SUBSTR(CAST(f.report_month AS STRING), 1, 3))) = r.month_std
   AND SAFE_CAST(f.report_year AS STRING) = r.year_std;

END;
