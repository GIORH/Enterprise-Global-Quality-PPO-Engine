CREATE OR REPLACE PROCEDURE `ti-ca-ml-start.QA_Training_scorecards.a_sp_2026_enrich_roster_with_all_scores`()
BEGIN

  /************************************************************************************************
   PROCEDURE: a_sp_2026_enrich_roster_with_all_scores
   DESCRIPTION: Enriches the global QA roster with Yearly Employee Trust/Leadership (YETG) scores.
                Implements a hierarchical waterfall inheritance model to ensure all levels of
                leadership receive a valid score. Normalizes the data and calculates final
                tiers, points, and weights aligned with the standardized scorecard metrics.
  ************************************************************************************************/

  CREATE OR REPLACE TABLE `ti-ca-ml-start.QA_Training_scorecards.global_qa_roster_with_scores` AS
  
  WITH 
  /* =========================================================================================
     CTE 1: ROSTER BASE & HIERARCHY EXTRACTION
     Isolates the target baseline roster and extracts clean Workday IDs (WDID) for the employee 
     and their entire upward chain of command using regular expressions. This enables the 
     hierarchical score inheritance.
  ========================================================================================= */
  Roster_Base AS (
    SELECT DISTINCT 
        * EXCEPT(employee_id, full_name, sr_manager, month, year),
        employee_id AS Employee_ID,
        full_name AS Full_Name,
        sr_manager AS Sr_Manager,
        month AS Month,
        year AS Year,
        REGEXP_EXTRACT(immediate_supervisor, r'.*\(([^)]+)\)') AS supervisor_wdid,
        REGEXP_EXTRACT(sr_manager, r'.*\(([^)]+)\)') AS manager_wdid,
        REGEXP_EXTRACT(sr_manager_department_head, r'.*\(([^)]+)\)') AS sr_manager_wdid
    FROM `ti-ca-ml-start.QA_Training_scorecards.2026_historical_qa_global_roster_proposal_raw`
    WHERE employee_id IS NOT NULL 
      AND LOWER(TRIM(month)) = 'may' 
  ),

  /* =========================================================================================
     CTE 2: LEADERSHIP SCORE STANDARDIZATION
     Extracts the raw survey scores, sanitizes the identifying WDIDs, and converts the 
     text-based percentages into operational FLOAT64 decimal values.
  ========================================================================================= */
  Clean_Leadership AS (
      SELECT 
          TRIM(REGEXP_EXTRACT(Leader, r'.*\(([^)]+)\)')) AS tid_str,
          SAFE_CAST(REPLACE(NULLIF(apr_26, '-'), '%', '') AS FLOAT64) / 100 AS lead_score
      FROM `ti-ca-ml-start.QA_Training_scorecards.2026_leadership_survey_results`
      WHERE Leader IS NOT NULL
  ),

  /* =========================================================================================
     CTE 3: WATERFALL INHERITANCE & NORMALIZATION
     Applies a top-down waterfall logic: if an employee lacks a direct survey score, they 
     inherit the score from their direct supervisor, manager, or senior manager respectively. 
     Calculates the normalized percentage to goal against the business baseline (0.85).
  ========================================================================================= */
  Waterfall_Calculated AS (
    SELECT 
        r.*,
        CONCAT(CAST(r.Employee_ID AS STRING), '_', r.Month, '_', CAST(r.Year AS STRING)) AS roster_key,
        l_e.lead_score AS employee_leadership_score,
        l_s.lead_score AS supervisor_leadership_score,
        l_m.lead_score AS manager_leadership_score,
        l_sm.lead_score AS sr_manager_leadership_score,
        
        COALESCE(l_e.lead_score, l_s.lead_score, l_m.lead_score, l_sm.lead_score) AS leadership_score,
        
        COALESCE(l_e.lead_score, l_s.lead_score, l_m.lead_score, l_sm.lead_score) / 0.85 AS leadership_ptg

    FROM Roster_Base AS r
    LEFT JOIN Clean_Leadership AS l_e ON CAST(r.Employee_ID AS STRING) = l_e.tid_str
    LEFT JOIN Clean_Leadership AS l_s ON CAST(r.supervisor_wdid AS STRING) = l_s.tid_str
    LEFT JOIN Clean_Leadership AS l_m ON CAST(r.manager_wdid AS STRING) = l_m.tid_str
    LEFT JOIN Clean_Leadership AS l_sm ON CAST(r.sr_manager_wdid AS STRING) = l_sm.tid_str
  ),

  /* =========================================================================================
     CTE 4: METRIC CATEGORIZATION & TIERING
     Maps the normalized leadership percentage to standardized performance tiers 
     (Improvement Required, Developing, Achieving, Excelling) based on business thresholds.
  ========================================================================================= */
  Final_Calculations AS (
    SELECT 
        *,
        'My Team' AS leadership_business_category,
        'yearly_evaluations_leadership' AS leadership_kpi,
        '10%' AS leadership_weight,
        '100%' AS leadership_target,
        
        CASE 
          WHEN leadership_ptg < 0.90 THEN 'Improvement Required'
          WHEN leadership_ptg >= 0.90 AND leadership_ptg < 1.00 THEN 'Developing'
          WHEN leadership_ptg >= 1.00 AND leadership_ptg < 1.01 THEN 'Achieving'
          WHEN leadership_ptg >= 1.01 THEN 'Excelling'
          ELSE 'N/A'
        END AS leadership_achievement_category
    FROM Waterfall_Calculated
  ),

  /* =========================================================================================
     CTE 5: SCORECARD POINTS & WEIGHT DISTRIBUTION
     Translates the assigned performance tiers into exact mathematical point values (1-4) 
     and applies the 10% metric weight to calculate the definitive scorecard contribution.
  ========================================================================================= */
  Final_Scored_Roster AS (
    SELECT 
        *,
        CASE 
          WHEN leadership_achievement_category = 'Improvement Required' THEN 1
          WHEN leadership_achievement_category = 'Developing' THEN 2
          WHEN leadership_achievement_category = 'Achieving' THEN 3
          WHEN leadership_achievement_category = 'Excelling' THEN 4
          ELSE 0
        END AS leadership_points_obtained,

        (CASE 
          WHEN leadership_achievement_category = 'Improvement Required' THEN 1
          WHEN leadership_achievement_category = 'Developing' THEN 2
          WHEN leadership_achievement_category = 'Achieving' THEN 3
          WHEN leadership_achievement_category = 'Excelling' THEN 4
          ELSE 0
        END / 4.0) * 0.10 AS leadership_weight_obtained,

        (CASE 
          WHEN leadership_achievement_category = 'Improvement Required' THEN 1
          WHEN leadership_achievement_category = 'Developing' THEN 2
          WHEN leadership_achievement_category = 'Achieving' THEN 3
          WHEN leadership_achievement_category = 'Excelling' THEN 4
          ELSE 0
        END) * 0.10 AS leadership_points_final_score
    FROM Final_Calculations
  ),

  /* =========================================================================================
     CTE 6: FINAL OUTPUT FLATTENING
     Collapses the granular hierarchical data into a flat, distinct list of leaders with 
     their definitive leadership scores, formatting the dataset for upcoming evaluation periods.
  ========================================================================================= */
  Regrouped_Leadership AS (
    SELECT
        DATE '2026-06-01' AS timestamp,                
        'Jun' AS report_month,                          
        2026 AS report_year,                            
        Employee_ID,                                    
        Full_Name,                                      
        leadership_score,                               
        leadership_ptg                                  
    FROM Final_Scored_Roster
    GROUP BY 
        Employee_ID, 
        Full_Name, 
        leadership_score,
        leadership_ptg                                  
  )

  -- FINAL SELECTION
  SELECT * FROM Regrouped_Leadership;
  
  -- Execution success status indicator 
  SELECT 'Roster updated: Data regrouped into June format, hierarchy strings removed from final output, and table rewritten.' as status;

END;
