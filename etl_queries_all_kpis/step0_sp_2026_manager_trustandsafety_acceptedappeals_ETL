CREATE OR REPLACE PROCEDURE `ti-ca-ml-start.QA_Training_scorecards.step0_sp_2026_manager_trustandsafety_acceptedappeals_ETL`()
BEGIN

  /************************************************************************************************
   PROCEDURE: step0_sp_2026_manager_trustandsafety_acceptedappeals_ETL
   DESCRIPTION: Master ETL pipeline aggregating the 'Accepted Appeals % to Goal' KPI for 
                Trust & Safety Quality Managers and Senior Managers (15% Weight). 
                The procedure uses a dual-branch architecture to roll up granular analyst-level 
                appeal actuals and targets across both management tiers. It evaluates team-wide 
                exemption flags, calculates pre-goal performance ratios, indexes results against 
                the 0.975 target baseline, maps scores to standard achievement tiers, and computes 
                final weighted scorecard impacts.
  ************************************************************************************************/

  CREATE OR REPLACE TABLE `ti-ca-ml-start.QA_Training_scorecards.step0_sp_2026_manager_trustandsafety_acceptedappeals_ETL` AS

  /* ==============================================================================================
     BRANCH 1: TRUST & SAFETY QUALITY MANAGER ROLL-UP
     ============================================================================================== */
  
  /* CTE 1.1: MANAGER LEVEL AGGREGATION & EXEMPTION CONTROL
     Sums granular Accepted Appeals actuals and target volumes grouped at the Manager, program, 
     and regional level. Evaluates analyst-level flags to set team-wide exemption status, 
     safely omitting exempt individual records to preserve metric calculation integrity. */
  WITH Manager_Appeals_Source AS (
    SELECT
      MAX(timestamp) AS timestamp,
      SAFE.PARSE_DATE('%d %B %Y', CONCAT('01 ', TRIM(report_month), ' ', CAST(report_year AS STRING))) AS date,
      report_month,
      report_year,
      tl_manager,
      tl_sr_manager,
      program,
      country,
      region,
      
      SUM(CASE WHEN UPPER(TRIM(aa_kpi_applicable)) = 'NO' OR UPPER(TRIM(aa_exempt)) = 'YES' THEN NULL ELSE SAFE_CAST(aa_actual AS FLOAT64) END) AS aa_actual,
      SUM(CASE WHEN UPPER(TRIM(aa_kpi_applicable)) = 'NO' OR UPPER(TRIM(aa_exempt)) = 'YES' THEN NULL ELSE SAFE_CAST(aa_score_target_program AS FLOAT64) END) AS aa_score_target_program,
      
      IF(COUNTIF(UPPER(TRIM(aa_kpi_applicable)) = 'NO') = COUNT(*), 'No', 'Yes') AS aa_kpi_applicable,
      IF(COUNTIF(UPPER(TRIM(aa_exempt)) = 'YES') = COUNT(*), 'Yes', 'No') AS aa_exempt,
      IF(COUNTIF(UPPER(TRIM(aa_exempt)) = 'YES') = COUNT(*), 'Whole roll-up team exempt', NULL) AS aa_notes,
      IF(COUNTIF(UPPER(TRIM(aa_exempt)) = 'YES') = COUNT(*), MAX(aa_reason), NULL) AS aa_reason
    FROM `ti-ca-ml-start.QA_Training_scorecards.2026_ts_qa_consolidated_kpis_raw`
    GROUP BY report_month, report_year, tl_manager, tl_sr_manager, program, country, region
  ),

  /* CTE 1.2: MANAGER BENCHMARKING & RATIO CALCULATION
     Injects scorecard metadata (15% master weight, 0.975 target baseline). Computes the pre-goal 
     performance ratio and indexes the final Percentage to Goal (PTG) against the master target benchmark. */
  Manager_Appeals_PTG AS (
    SELECT
      *,
      'My Customer' AS accepted_appeals_business_category,
      'Accepted Appeals % to Goal' AS accepted_appeals_kpi,
      CASE 
        WHEN UPPER(TRIM(aa_kpi_applicable)) = 'NO' OR UPPER(TRIM(aa_exempt)) = 'YES' THEN NULL 
        ELSE 0.975 
      END AS accepted_appeals_target,
      
      CASE 
        WHEN UPPER(TRIM(aa_kpi_applicable)) = 'NO' OR UPPER(TRIM(aa_exempt)) = 'YES' THEN NULL 
        ELSE 0.15 
      END AS accepted_appeals_weight_master,
      
      CASE 
        WHEN UPPER(TRIM(aa_kpi_applicable)) = 'NO' OR UPPER(TRIM(aa_exempt)) = 'YES' THEN NULL
        ELSE SAFE_DIVIDE(aa_score_target_program - aa_actual, aa_score_target_program)
      END AS accepted_appeals_performance_before_goal,
      
      CASE 
        WHEN UPPER(TRIM(aa_kpi_applicable)) = 'NO' OR UPPER(TRIM(aa_exempt)) = 'YES' THEN NULL 
        ELSE SAFE_DIVIDE(aa_score_target_program - aa_actual, aa_score_target_program) / 0.975 
      END AS accepted_appeals_ptg
    FROM Manager_Appeals_Source
  ),

  /* CTE 1.3: MANAGER METRIC TIERING & POINT ALLOCATION
     Maps the computed PTG against continuous performance thresholds (<85%, <95%, <96%, >=96%) 
     to assign official Achievement Tiers and continuous 4-point scale metric points. */
  Manager_Appeals_Scores AS (
    SELECT
      *,
      CASE 
        WHEN accepted_appeals_ptg IS NULL THEN NULL 
        WHEN accepted_appeals_ptg < 0.85 THEN 'Improvement Required' 
        WHEN accepted_appeals_ptg < 0.95 THEN 'Developing' 
        WHEN accepted_appeals_ptg < 0.96 THEN 'Achieving' 
        WHEN accepted_appeals_ptg >= 0.96 THEN 'Excelling' 
        ELSE NULL 
      END AS accepted_appeals_achievement_tier,
      
      CASE 
        WHEN accepted_appeals_ptg IS NULL THEN NULL 
        WHEN accepted_appeals_ptg < 0.85 THEN 1 
        WHEN accepted_appeals_ptg < 0.95 THEN 2 
        WHEN accepted_appeals_ptg < 0.96 THEN 3 
        WHEN accepted_appeals_ptg >= 0.96 THEN 4 
        ELSE 0 
      END AS accepted_appeals_points_obtained
    FROM Manager_Appeals_PTG
  ),

  /* CTE 1.4: MANAGER WEIGHT DISTRIBUTION & SCORING
     Translates 4-point scale metric points into quartered weight distributions against the 
     15% master weight. Calculates final numerical point contributions for the Manager tier. */
  Manager_Appeals_Block AS (
    SELECT
      timestamp,
      date,
      report_month,
      report_year,
      tl_manager,
      tl_sr_manager,
      program,
      country,
      region,
      accepted_appeals_business_category,
      accepted_appeals_kpi,
      aa_actual,
      aa_score_target_program,
      accepted_appeals_weight_master,
      accepted_appeals_target,
      accepted_appeals_performance_before_goal,
      accepted_appeals_ptg,
      accepted_appeals_achievement_tier,
      accepted_appeals_points_obtained,
      CASE WHEN accepted_appeals_points_obtained IS NULL THEN NULL ELSE (accepted_appeals_points_obtained / 4) * accepted_appeals_weight_master END AS accepted_appeals_weight_obtained,
      CASE WHEN accepted_appeals_points_obtained IS NULL THEN NULL ELSE accepted_appeals_points_obtained * accepted_appeals_weight_master END AS accepted_appeals_points_final_score,
      aa_notes,
      aa_kpi_applicable,
      aa_exempt,
      aa_reason
    FROM Manager_Appeals_Scores
  ),

  /* ==============================================================================================
     BRANCH 2: TRUST & SAFETY QUALITY SENIOR MANAGER ROLL-UP
     ============================================================================================== */
  
  /* CTE 2.1: SR. MANAGER LEVEL AGGREGATION & EXEMPTION CONTROL
     Sums granular Accepted Appeals volumes grouped at the Senior Manager level, re-mapping 
     `tl_sr_manager` to `tl_manager`. Filters for active Senior Manager records. */
  SrManager_Appeals_Source AS (
    SELECT
      MAX(timestamp) AS timestamp,
      SAFE.PARSE_DATE('%d %B %Y', CONCAT('01 ', TRIM(report_month), ' ', CAST(report_year AS STRING))) AS date,
      report_month,
      report_year,
      tl_sr_manager AS tl_manager,
      program,
      country,
      region,
      
      SUM(CASE WHEN UPPER(TRIM(aa_kpi_applicable)) = 'NO' OR UPPER(TRIM(aa_exempt)) = 'YES' THEN NULL ELSE SAFE_CAST(aa_actual AS FLOAT64) END) AS aa_actual,
      SUM(CASE WHEN UPPER(TRIM(aa_kpi_applicable)) = 'NO' OR UPPER(TRIM(aa_exempt)) = 'YES' THEN NULL ELSE SAFE_CAST(aa_score_target_program AS FLOAT64) END) AS aa_score_target_program,
      
      IF(COUNTIF(UPPER(TRIM(aa_kpi_applicable)) = 'NO') = COUNT(*), 'No', 'Yes') AS aa_kpi_applicable,
      IF(COUNTIF(UPPER(TRIM(aa_exempt)) = 'YES') = COUNT(*), 'Yes', 'No') AS aa_exempt,
      IF(COUNTIF(UPPER(TRIM(aa_exempt)) = 'YES') = COUNT(*), 'Whole roll-up team exempt', NULL) AS aa_notes,
      IF(COUNTIF(UPPER(TRIM(aa_exempt)) = 'YES') = COUNT(*), MAX(aa_reason), NULL) AS aa_reason
    FROM `ti-ca-ml-start.QA_Training_scorecards.2026_ts_qa_consolidated_kpis_raw`
    WHERE tl_sr_manager IS NOT NULL AND TRIM(tl_sr_manager) != ''
    GROUP BY report_month, report_year, tl_sr_manager, program, country, region
  ),

  /* CTE 2.2: SR. MANAGER BENCHMARKING & RATIO CALCULATION
     Injects scorecard metadata and computes the pre-goal performance ratio and final PTG 
     for the Senior Manager level. */
  SrManager_Appeals_PTG AS (
    SELECT
      *,
      'My Customer' AS accepted_appeals_business_category,
      'Accepted Appeals % to Goal' AS accepted_appeals_kpi,
      CASE 
        WHEN UPPER(TRIM(aa_kpi_applicable)) = 'NO' OR UPPER(TRIM(aa_exempt)) = 'YES' THEN NULL 
        ELSE 0.975 
      END AS accepted_appeals_target,
      
      CASE 
        WHEN UPPER(TRIM(aa_kpi_applicable)) = 'NO' OR UPPER(TRIM(aa_exempt)) = 'YES' THEN NULL 
        ELSE 0.15 
      END AS accepted_appeals_weight_master,
      
      CASE 
        WHEN UPPER(TRIM(aa_kpi_applicable)) = 'NO' OR UPPER(TRIM(aa_exempt)) = 'YES' THEN NULL
        ELSE SAFE_DIVIDE(aa_score_target_program - aa_actual, aa_score_target_program)
      END AS accepted_appeals_performance_before_goal,
      
      CASE 
        WHEN UPPER(TRIM(aa_kpi_applicable)) = 'NO' OR UPPER(TRIM(aa_exempt)) = 'YES' THEN NULL 
        ELSE SAFE_DIVIDE(aa_score_target_program - aa_actual, aa_score_target_program) / 0.975 
      END AS accepted_appeals_ptg
    FROM SrManager_Appeals_Source
  ),

  /* CTE 2.3: SR. MANAGER METRIC TIERING & POINT ALLOCATION
     Maps Senior Manager PTG to official Achievement Tiers and continuous 4-point scale metric points. */
  SrManager_Appeals_Scores AS (
    SELECT
      *,
      CASE 
        WHEN accepted_appeals_ptg IS NULL THEN NULL 
        WHEN accepted_appeals_ptg < 0.85 THEN 'Improvement Required' 
        WHEN accepted_appeals_ptg < 0.95 THEN 'Developing' 
        WHEN accepted_appeals_ptg < 0.96 THEN 'Achieving' 
        WHEN accepted_appeals_ptg >= 0.96 THEN 'Excelling' 
        ELSE NULL 
      END AS accepted_appeals_achievement_tier,
      
      CASE 
        WHEN accepted_appeals_ptg IS NULL THEN NULL 
        WHEN accepted_appeals_ptg < 0.85 THEN 1 
        WHEN accepted_appeals_ptg < 0.95 THEN 2 
        WHEN accepted_appeals_ptg < 0.96 THEN 3 
        WHEN accepted_appeals_ptg >= 0.96 THEN 4 
        ELSE 0 
      END AS accepted_appeals_points_obtained
    FROM SrManager_Appeals_PTG
  ),

  /* CTE 2.4: SR. MANAGER WEIGHT DISTRIBUTION & SCORING
     Finalizes calculations for the Senior Manager layer, projecting `tl_sr_manager` as NULL 
     to maintain hierarchical schema consistency. */
  SrManager_Appeals_Block AS (
    SELECT
      timestamp,
      date,
      report_month,
      report_year,
      tl_manager,
      CAST(NULL AS STRING) AS tl_sr_manager,
      program,
      country,
      region,
      accepted_appeals_business_category,
      accepted_appeals_kpi,
      aa_actual,
      aa_score_target_program,
      accepted_appeals_weight_master,
      accepted_appeals_target,
      accepted_appeals_performance_before_goal,
      accepted_appeals_ptg,
      accepted_appeals_achievement_tier,
      accepted_appeals_points_obtained,
      CASE WHEN accepted_appeals_points_obtained IS NULL THEN NULL ELSE (accepted_appeals_points_obtained / 4) * accepted_appeals_weight_master END AS accepted_appeals_weight_obtained,
      CASE WHEN accepted_appeals_points_obtained IS NULL THEN NULL ELSE accepted_appeals_points_obtained * accepted_appeals_weight_master END AS accepted_appeals_points_final_score,
      aa_notes,
      aa_kpi_applicable,
      aa_exempt,
      aa_reason
    FROM SrManager_Appeals_Scores
  )

  /* ==============================================================================================
     FINAL MASTER UNION
     Combines Manager and Senior Manager rolled-up Accepted Appeals datasets into a single 
     unified table output.
     ============================================================================================== */
  SELECT * FROM Manager_Appeals_Block
  UNION ALL
  SELECT * FROM SrManager_Appeals_Block;

END;
