CREATE OR REPLACE PROCEDURE `ti-ca-ml-start.QA_Training_scorecards.step2_sp_2026_scorecard_qa_director_consolidated`()
BEGIN

  /************************************************************************************************
   PROCEDURE: step2_sp_2026_scorecard_qa_director_consolidated
   DESCRIPTION: Master consolidation procedure for the QA Director Scorecard. Standardizes raw 
                timestamps and Director Workday IDs, calculates dynamic Service Excellence Index 
                (SEI) metrics (25% Weight), and horizontally integrates dynamic leadership pillars: 
                Yearly Evaluations (Cascade Leadership - June only, 20% Weight), Top Performers 
                (POTP - 20% Weight), and Coaching/Team Development (20% Weight). Dynamically calculates 
                the total obtained score against active metric point ceilings to assign final executive 
                performance tiers.
  ************************************************************************************************/

  CREATE OR REPLACE TABLE `ti-ca-ml-start.QA_Training_scorecards.2026_scorecard_qa_director_consolidated` AS
  
  /* =========================================================================================
     CTE 1: RAW DATA CLEANING & SEI DECIMAL CALCULATION
     Filters out null, empty, or placeholder Director Workday IDs to protect data integrity. 
     Cleans string percentage characters from SEI score and target fields to dynamically compute 
     the actual SEI PTG decimal ratio.
  ========================================================================================= */
  WITH Raw_Data AS (
    SELECT 
      *,
      SAFE_DIVIDE(
        SAFE_CAST(REPLACE(CAST(sei_score AS STRING), '%', '') AS FLOAT64),
        SAFE_CAST(REPLACE(CAST(sei_target AS STRING), '%', '') AS FLOAT64)
      ) AS sei_ptg_decimal
    FROM `ti-ca-ml-start.QA_Training_scorecards.2026_qadirectors_raw`
    WHERE director_wdid IS NOT NULL 
      AND TRIM(CAST(director_wdid AS STRING)) NOT IN ('', '-', 'NULL')
  ),
  
  /* =========================================================================================
     CTE 2: SEI METRIC TIERING & POINT ALLOCATION
     Evaluates the dynamic SEI PTG decimal ratio against standard continuous thresholds (<90%, 
     <100%, <101%, >=101%) to assign 1-4 metric points under a 25% fixed master weight.
  ========================================================================================= */
  Calculos_Metricas AS (
    SELECT
      *,
      'Service Excellence Index' AS sei_kpi_fixed,
      'My Customer' AS sei_business_category_fixed,
      0.25 AS sei_weight_fixed,
      CASE 
        WHEN sei_ptg_decimal < 0.90 THEN 'Improvement Required'
        WHEN sei_ptg_decimal < 1.00 THEN 'Developing'
        WHEN sei_ptg_decimal < 1.01 THEN 'Achieving'
        ELSE 'Excelling'
      END AS sei_achievement_category_calc,
      CASE 
        WHEN sei_ptg_decimal < 0.90 THEN 1
        WHEN sei_ptg_decimal < 1.00 THEN 2
        WHEN sei_ptg_decimal < 1.01 THEN 3
        ELSE 4
      END AS sei_points_obtained_calc
    FROM Raw_Data
  ),

  /* =========================================================================================
     CTE 3: BASE SCORECARD WITH STANDARDIZED KEYS
     Standardizes reporting months into definitive 3-letter upper-case strings (e.g., 'JUN') 
     and strips trailing '.0' artifacts from Director Workday IDs. Calculates earned weights and 
     final scorecard point impacts for SEI.
  ========================================================================================= */
  Base_Scorecard AS (
    SELECT 
      pk,
      timestamp,
      submitter_email,
      UPPER(TRIM(SUBSTR(CAST(report_month AS STRING), 1, 3))) AS report_month,
      report_year,
      region,
      role,
      REGEXP_REPLACE(TRIM(CAST(director_wdid AS STRING)), r'\.0$', '') AS director_wdid, 
      director_name,
      sei_kpi_fixed AS sei_kpi,
      sei_business_category_fixed AS sei_business_category,
      sei_weight_fixed AS sei_weight,
      sei_score,
      sei_target,
      FORMAT('%.2f%%', sei_ptg_decimal * 100) AS sei_ptg, 
      sei_achievement_category_calc AS sei_achievement_category,
      sei_points_obtained_calc AS sei_points_obtained,
      (CAST(sei_points_obtained_calc AS FLOAT64) / 4) * 0.25 AS sei_weight_obtained,
      CAST(sei_points_obtained_calc AS FLOAT64) * 0.25 AS sei_points_final_score
    FROM Calculos_Metricas
  ),

  /* =========================================================================================
     NEW BLOCK: CASCADE LEADERSHIP PRE-AGGREGATION
     Extracts yearly evaluation scores from the global roster for Directors, standardizing 
     Employee Workday IDs and reporting periods.
  ========================================================================================= */
  leadership_director_agg AS (
    SELECT 
      REGEXP_REPLACE(TRIM(CAST(Employee_ID AS STRING)), r'\.0$', '') AS wdid,
      UPPER(TRIM(SUBSTR(CAST(report_month AS STRING), 1, 3))) AS month,
      SAFE_CAST(report_year AS STRING) AS year,
      SAFE_CAST(leadership_ptg AS FLOAT64) AS leadership_ptg
    FROM `ti-ca-ml-start.QA_Training_scorecards.global_qa_roster_with_scores` 
    WHERE Employee_ID IS NOT NULL
  ),

  /* =========================================================================================
     CTE 4: MACRO POTP PRE-AGGREGATION
     Aggregates top performer counts and total counts at the immediate supervisor level 
     (Director ID) to compute the POTP PTG ratio.
  ========================================================================================= */
  potp_director_agg AS (
    SELECT 
      REGEXP_REPLACE(TRIM(CAST(inmediate_supervisor_id AS STRING)), r'\.0$', '') AS wdid, 
      UPPER(TRIM(SUBSTR(CAST(month AS STRING), 1, 3))) as month,
      SAFE_CAST(year AS STRING) as year, 
      SUM(count_top_performers) as count_top_performers,
      SUM(count_total) as count_total,
      MAX(target_master) as target_master,
      SAFE_DIVIDE(SUM(count_top_performers), SUM(count_total)) as potp_ptg
    FROM `ti-ca-ml-start.QA_Training_scorecards.2026_potp_all_roles_etl_output`
    WHERE inmediate_supervisor_id IS NOT NULL 
      AND TRIM(CAST(inmediate_supervisor_id AS STRING)) NOT IN ('', '-', 'NULL')
    GROUP BY 1, 2, 3 
  ),

  /* =========================================================================================
     CTE 5: COACHING PRE-AGGREGATION FOR DIRECTORS
     Aggregates performed and target coaching volumes grouped by Coach Workday ID and reporting 
     period. Consolidates exemption flags and exception reasons.
  ========================================================================================= */
  coaching_director_agg AS (
    SELECT 
      REGEXP_REPLACE(TRIM(CAST(coach_wdid AS STRING)), r'\.0$', '') AS wdid,
      UPPER(TRIM(SUBSTR(CAST(report_month AS STRING), 1, 3))) AS month,
      SAFE_CAST(report_year AS STRING) AS year,
      SUM(coachings_performed) AS coachings_performed,
      SUM(coachings_target) AS coachings_target,
      MAX(CASE WHEN UPPER(TRIM(CAST(exempt AS STRING))) = 'YES' THEN 'Yes' ELSE 'No' END) AS exempt,
      STRING_AGG(DISTINCT NULLIF(TRIM(exempt_reason), ''), ' | ') AS exempt_reason
    FROM `ti-ca-ml-start.QA_Training_scorecards.2026_coaching_leadership_general`
    WHERE coach_wdid IS NOT NULL 
      AND TRIM(CAST(coach_wdid AS STRING)) NOT IN ('', '-', 'NULL')
    GROUP BY 1, 2, 3
  ),

  /* =========================================================================================
     CTE 6: HORIZONTAL COUPLING & DYNAMIC SCORE AGGREGATION
     Joins Leadership, POTP, and Coaching blocks to the Base Scorecard using composite keys 
     (WDID, Month, Year). Evaluates component applicability (e.g., Leadership active strictly in 
     June ('JUN')) and dynamically sums obtained points and available point ceilings across 
     applicable pillars.
  ========================================================================================= */
  DAPT_Calculations AS (
    SELECT
      b.*,
      
      -- ==========================================
      -- METADATA AND PILLAR LOGIC: CASCADE LEADERSHIP (20% WEIGHT - JUNE ONLY)
      -- ==========================================
      CAST('My Team' AS STRING) AS yearly_evals_business_category,
      CAST('Yearly Evaluations (% to goal)' AS STRING) AS yearly_evals_kpi,
      1.00 AS yearly_evals_target_master,
      
      CASE 
        WHEN b.report_month = 'JUN' AND l.leadership_ptg IS NOT NULL THEN 0.20 
        ELSE NULL 
      END AS yearly_evals_weight_master,
      
      CASE WHEN b.report_month = 'JUN' THEN l.leadership_ptg ELSE NULL END AS yearly_evals_ptg,
      CAST(CASE WHEN b.report_month = 'JUN' AND l.leadership_ptg IS NOT NULL THEN 'Yes' ELSE 'No' END AS STRING) AS yearly_evals_kpi_applicable,
      
      CASE 
        WHEN b.report_month != 'JUN' THEN NULL
        WHEN l.leadership_ptg IS NULL THEN NULL
        WHEN l.leadership_ptg < 0.90 THEN 'Improvement Required'
        WHEN l.leadership_ptg < 1.00 THEN 'Developing'
        WHEN l.leadership_ptg < 1.01 THEN 'Achieving'
        ELSE 'Excelling'
      END AS yearly_evals_achievement_category,

      CASE 
        WHEN b.report_month != 'JUN' THEN NULL
        WHEN l.leadership_ptg IS NULL THEN NULL
        WHEN l.leadership_ptg < 0.90 THEN 1
        WHEN l.leadership_ptg < 1.00 THEN 2
        WHEN l.leadership_ptg < 1.01 THEN 3
        ELSE 4
      END AS yearly_evals_metric_points,

      CASE 
        WHEN b.report_month != 'JUN' THEN NULL
        WHEN l.leadership_ptg IS NULL THEN NULL
        WHEN l.leadership_ptg < 0.90 THEN 0.25
        WHEN l.leadership_ptg < 1.00 THEN 0.50
        WHEN l.leadership_ptg < 1.01 THEN 0.75
        ELSE 1.00
      END * 0.20 AS yearly_evals_weight_earned,

      CASE 
        WHEN b.report_month != 'JUN' THEN NULL
        WHEN l.leadership_ptg IS NULL THEN NULL
        WHEN l.leadership_ptg < 0.90 THEN 1
        WHEN l.leadership_ptg < 1.00 THEN 2
        WHEN l.leadership_ptg < 1.01 THEN 3
        ELSE 4
      END * 0.20 AS yearly_evals_points_final_score,
      
      -- ==========================================
      -- METADATA AND PILLAR LOGIC: POTP (20% WEIGHT)
      -- ==========================================
      CAST('My Team' AS STRING) AS potp_business_category,
      CAST('% of Top Performers' AS STRING) AS potp_kpi,
      p.count_top_performers AS potp_count_top_performers,
      p.count_total AS potp_count_total,
      CAST(CASE WHEN p.count_total IS NULL OR p.count_total = 0 THEN 'No' ELSE 'Yes' END AS STRING) AS potp_kpi_applicable,
      CAST('No' AS STRING) AS potp_exempt,
      CAST(NULL AS STRING) AS potp_reason,
      
      CASE 
        WHEN p.count_total IS NULL OR p.count_total = 0 THEN NULL 
        ELSE 0.20 
      END AS potp_weight, 
      
      p.target_master AS potp_target,
      p.potp_ptg AS potp_ptg,
      
      CASE 
        WHEN p.count_total IS NULL OR p.count_total = 0 THEN NULL
        WHEN p.potp_ptg < 0.75 THEN 'Improvement Required'
        WHEN p.potp_ptg < 0.90 THEN 'Developing'
        WHEN p.potp_ptg < 0.95 THEN 'Achieving'
        ELSE 'Excelling'
      END AS potp_achievement_tier,

      CASE 
        WHEN p.count_total IS NULL OR p.count_total = 0 THEN NULL
        WHEN p.potp_ptg < 0.75 THEN 1
        WHEN p.potp_ptg < 0.90 THEN 2
        WHEN p.potp_ptg < 0.95 THEN 3
        ELSE 4
      END AS potp_points_obtained,

      CASE 
        WHEN p.count_total IS NULL OR p.count_total = 0 THEN NULL
        WHEN p.potp_ptg < 0.75 THEN 0.25
        WHEN p.potp_ptg < 0.90 THEN 0.50
        WHEN p.potp_ptg < 0.95 THEN 0.75
        ELSE 1.00
      END * 0.20 AS potp_weight_obtained,

      CASE 
        WHEN p.count_total IS NULL OR p.count_total = 0 THEN NULL
        WHEN p.potp_ptg < 0.75 THEN 1
        WHEN p.potp_ptg < 0.90 THEN 2
        WHEN p.potp_ptg < 0.95 THEN 3
        ELSE 4
      END * 0.20 AS potp_points_for_final_score,

      -- ==========================================
      -- METADATA AND PILLAR LOGIC: COACHING / TEAM DEVELOPMENT (20% WEIGHT)
      -- ==========================================
      CAST('My Business' AS STRING) AS coaching_business_category,
      CAST('Coaching' AS STRING) AS coaching_kpi,
      c.coachings_performed AS coaching_count_performed,
      c.coachings_target AS coaching_count_target,
      CAST(IFNULL(c.exempt, 'No') AS STRING) AS coaching_exempt,
      c.exempt_reason AS coaching_reason,
      1.00 AS coaching_target_master,
      
      CASE 
        WHEN c.wdid IS NULL OR IFNULL(c.exempt, 'No') = 'Yes' THEN NULL
        ELSE 0.20
      END AS coaching_weight_master,
      
      CASE 
        WHEN c.wdid IS NULL OR IFNULL(c.exempt, 'No') = 'Yes' THEN NULL
        ELSE SAFE_DIVIDE(c.coachings_performed, c.coachings_target)
      END AS coaching_ptg,

      CASE 
        WHEN c.wdid IS NULL OR IFNULL(c.exempt, 'No') = 'Yes' THEN NULL
        WHEN SAFE_DIVIDE(c.coachings_performed, c.coachings_target) < 0.90 THEN 'Improvement Required'
        WHEN SAFE_DIVIDE(c.coachings_performed, c.coachings_target) < 1.00 THEN 'Developing'
        WHEN SAFE_DIVIDE(c.coachings_performed, c.coachings_target) < 1.01 THEN 'Achieving'
        ELSE 'Excelling'
      END AS coaching_achievement_category,

      CASE 
        WHEN c.wdid IS NULL OR IFNULL(c.exempt, 'No') = 'Yes' THEN NULL
        WHEN SAFE_DIVIDE(c.coachings_performed, c.coachings_target) < 0.90 THEN 1
        WHEN SAFE_DIVIDE(c.coachings_performed, c.coachings_target) < 1.00 THEN 2
        WHEN SAFE_DIVIDE(c.coachings_performed, c.coachings_target) < 1.01 THEN 3
        ELSE 4
      END AS coaching_points_obtained,

      CASE 
        WHEN c.wdid IS NULL OR IFNULL(c.exempt, 'No') = 'Yes' THEN NULL
        WHEN SAFE_DIVIDE(c.coachings_performed, c.coachings_target) < 0.90 THEN 0.25
        WHEN SAFE_DIVIDE(c.coachings_performed, c.coachings_target) < 1.00 THEN 0.50
        WHEN SAFE_DIVIDE(c.coachings_performed, c.coachings_target) < 1.01 THEN 0.75
        ELSE 1.00
      END * 0.20 AS coaching_weight_earned,

      CASE 
        WHEN c.wdid IS NULL OR IFNULL(c.exempt, 'No') = 'Yes' THEN NULL
        WHEN SAFE_DIVIDE(c.coachings_performed, c.coachings_target) < 0.90 THEN 1
        WHEN SAFE_DIVIDE(c.coachings_performed, c.coachings_target) < 1.00 THEN 2
        WHEN SAFE_DIVIDE(c.coachings_performed, c.coachings_target) < 1.01 THEN 3
        ELSE 4
      END * 0.20 AS coaching_points_final_score,

      -- Standardized metadata pillars for Step 3 Unpivot
      CAST('All' AS STRING) AS final_score_business_category,
      CAST('Final Score' AS STRING) AS final_score_kpi,

      -- DYNAMIC SUMMATIVE SCORE CALCULATION
      (
        COALESCE(b.sei_points_final_score, 0) +
        COALESCE(CASE 
          WHEN b.report_month != 'JUN' THEN NULL
          WHEN l.leadership_ptg IS NULL THEN NULL
          WHEN l.leadership_ptg < 0.90 THEN 1
          WHEN l.leadership_ptg < 1.00 THEN 2
          WHEN l.leadership_ptg < 1.01 THEN 3
          ELSE 4
        END * 0.20, 0) +
        COALESCE(CASE 
          WHEN p.count_total IS NULL OR p.count_total = 0 THEN NULL
          WHEN p.potp_ptg < 0.75 THEN 1
          WHEN p.potp_ptg < 0.90 THEN 2
          WHEN p.potp_ptg < 0.95 THEN 3
          ELSE 4
        END * 0.20, 0) +
        COALESCE(CASE 
          WHEN c.wdid IS NULL OR IFNULL(c.exempt, 'No') = 'Yes' THEN NULL
          WHEN SAFE_DIVIDE(c.coachings_performed, c.coachings_target) < 0.90 THEN 1
          WHEN SAFE_DIVIDE(c.coachings_performed, c.coachings_target) < 1.00 THEN 2
          WHEN SAFE_DIVIDE(c.coachings_performed, c.coachings_target) < 1.01 THEN 3
          ELSE 4
        END * 0.20, 0)
      ) AS final_score_points_obtained,

      -- DYNAMIC SCORE CEILING BY APPLICABILITY
      (
        COALESCE(b.sei_weight, 0) * 4 +
        COALESCE(CASE WHEN b.report_month != 'JUN' OR l.leadership_ptg IS NULL THEN 0 ELSE 0.20 END * 4, 0) +
        COALESCE(CASE WHEN p.count_total IS NULL OR p.count_total = 0 THEN 0 ELSE 0.20 END * 4, 0) +
        COALESCE(CASE WHEN c.wdid IS NULL OR IFNULL(c.exempt, 'No') = 'Yes' THEN 0 ELSE 0.20 END * 4, 0)
      ) AS max_final_score_points_available

    FROM Base_Scorecard b
    
    -- LEFT JOIN 1: Connection to Leadership table under composite triad (ID, Month, Year)
    LEFT JOIN leadership_director_agg l
      ON b.director_wdid = l.wdid
     AND b.report_month = l.month
     AND SAFE_CAST(b.report_year AS STRING) = l.year

    -- LEFT JOIN 2: Connection to POTP under composite triad
    LEFT JOIN potp_director_agg p
      ON b.director_wdid = p.wdid
     AND b.report_month = p.month
     AND SAFE_CAST(b.report_year AS STRING) = p.year

    -- LEFT JOIN 3: Connection to Coaching under composite triad
    LEFT JOIN coaching_director_agg c
      ON b.director_wdid = c.wdid
     AND b.report_month = c.month
     AND SAFE_CAST(b.report_year AS STRING) = c.year
  )

  /* =========================================================================================
     FINAL MASTER SELECTION
     Calculates final ratio (obtained points / max available points) and maps the overall score 
     to executive performance tiers (>=87% Excelling, >=75% Achieving, >=50% Developing, <50% IR).
  ========================================================================================= */
  SELECT 
    *,
    SAFE_DIVIDE(final_score_points_obtained, max_final_score_points_available) AS final_score_ptg,
    
    CASE 
      WHEN SAFE_DIVIDE(final_score_points_obtained, max_final_score_points_available) IS NULL THEN NULL
      WHEN SAFE_DIVIDE(final_score_points_obtained, max_final_score_points_available) >= 0.87 THEN 'Excelling'
      WHEN SAFE_DIVIDE(final_score_points_obtained, max_final_score_points_available) >= 0.75 THEN 'Achieving'
      WHEN SAFE_DIVIDE(final_score_points_obtained, max_final_score_points_available) >= 0.50 THEN 'Developing'
      ELSE 'Improvement Required'
    END AS final_score_tier
  FROM DAPT_Calculations;

END;
