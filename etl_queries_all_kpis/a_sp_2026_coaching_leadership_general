CREATE OR REPLACE PROCEDURE `ti-ca-ml-start.QA_Training_scorecards.a_sp_2026_coaching_leadership_general`()
BEGIN

  /************************************************************************************************
   PROCEDURE: a_sp_2026_coaching_leadership_general
   DESCRIPTION: Consolidates coaching and leadership interactions across all hierarchy levels 
                and business verticals (CX and Trust & Safety). 
                It standardizes the Coach-to-Coachee relationship and applies a comprehensive 
                Row-Level Security (RLS) model granting access to the Coachee, their entire 
                upward chain of command (up to 6 levels), and global admins.
  ************************************************************************************************/

  CREATE OR REPLACE TABLE `ti-ca-ml-start.QA_Training_scorecards.2026_coaching_leadership_general` AS

  WITH 
    /* =========================================================================================
       CTE 1: DYNAMIC FULL ACCESS EMAIL CONSOLIDATION
       Extracts and concatenates all authorized super-user emails to ensure global visibility.
    ========================================================================================= */
    full_access_list AS (
      SELECT STRING_AGG(email, ',') AS full_access_emails
      FROM (
        SELECT LOWER(TRIM(telus_digital_email)) AS email 
        FROM `ti-ca-ml-start.QA_Training_scorecards.2026_full_access_security_emails_raw` 
        WHERE telus_digital_email IS NOT NULL AND TRIM(telus_digital_email) != ''
        
        UNION DISTINCT
        
        SELECT LOWER(TRIM(telus_international_email)) AS email 
        FROM `ti-ca-ml-start.QA_Training_scorecards.2026_full_access_security_emails_raw` 
        WHERE telus_international_email IS NOT NULL AND TRIM(telus_international_email) != ''
      )
    ),

    /* =========================================================================================
       CTE 2: HISTORICAL ROSTER SECURITY MAPPING
       Builds a comprehensive security chain per employee, month, and year. It merges the 
       coachee's primary email with up to 6 levels of hierarchical supervisors into a single 
       comma-separated string for dynamic Looker Studio filtering.
    ========================================================================================= */
    roster_security AS (
      SELECT 
        REGEXP_REPLACE(TRIM(CAST(employee_id AS STRING)), r'\.0$', '') AS employee_id_std,
        UPPER(TRIM(SUBSTR(CAST(month AS STRING), 1, 3))) AS month_std,
        SAFE_CAST(year AS STRING) AS year_std,
        ARRAY_TO_STRING(
          ARRAY(
            SELECT DISTINCT email
            FROM UNNEST([
              LOWER(TRIM(email_primary_work)),
              LOWER(TRIM(inmediate_supervisor_1_email)),
              LOWER(TRIM(inmediate_supervisor_2_email)),
              LOWER(TRIM(inmediate_supervisor_3_email)),
              LOWER(TRIM(inmediate_supervisor_4_email)),
              LOWER(TRIM(inmediate_supervisor_5_email)),
              LOWER(TRIM(inmediate_supervisor_6_email))
            ]) AS email
            WHERE email IS NOT NULL AND TRIM(email) != ''
          ), ','
        ) AS full_chain_emails
      FROM `ti-ca-ml-start.QA_Training_scorecards.2026_historical_qa_global_roster_proposal_raw`
      WHERE employee_id IS NOT NULL 
        AND TRIM(CAST(employee_id AS STRING)) NOT IN ('', '-', 'NULL')
      QUALIFY ROW_NUMBER() OVER(
        PARTITION BY 
          REGEXP_REPLACE(TRIM(CAST(employee_id AS STRING)), r'\.0$', ''),
          UPPER(TRIM(SUBSTR(CAST(month AS STRING), 1, 3))),
          SAFE_CAST(year AS STRING)
        ORDER BY employee_id
      ) = 1
    ),

    /* =========================================================================================
       CTE 3: UNIFIED COACHING DATA CONSOLIDATION
       Appends coaching interactions across all functional levels and verticals using UNION ALL.
       Standardizes dimensions to clearly identify the Coach, the Coachee, and their roles.
    ========================================================================================= */
    consolidated_data AS (
      
      /* --- BLOCK 1: CX Quality Team Leads coaching CX Quality Analysts --- */
      SELECT
        SAFE.PARSE_DATE('%b %Y', CONCAT(INITCAP(SUBSTR(TRIM(CAST(report_month AS STRING)), 1, 3)), ' ', REGEXP_REPLACE(TRIM(CAST(report_year AS STRING)), r'\.0$', ''))) AS date,
        report_month,
        report_year,
        tl_wdid AS coach_wdid,
        tl_name AS coach_name,
        tm_wdid AS coachee_wdid,
        tm_name AS coachee_name,
        country,
        region,
        NULLIF(SAFE_CAST(coachings_performed AS FLOAT64), 0) AS coachings_performed,
        NULLIF(SAFE_CAST(coachings_target AS FLOAT64), 0) AS coachings_target,
        notes,
        exempt,
        exempt_reason,
        'CX Quality Analyst' AS coachee_role
      FROM `ti-ca-ml-start.QA_Training_scorecards.2026_cx_qatl_coaching_raw`

      UNION ALL

      /* --- BLOCK 2: CX Quality Managers coaching CX Quality Team Leads --- */
      SELECT
        SAFE.PARSE_DATE('%b %Y', CONCAT(INITCAP(SUBSTR(TRIM(CAST(report_month AS STRING)), 1, 3)), ' ', REGEXP_REPLACE(TRIM(CAST(report_year AS STRING)), r'\.0$', ''))) AS date,
        report_month,
        report_year,
        mngr_wdid AS coach_wdid,
        mngr_name AS coach_name,
        tl_wdid AS coachee_wdid,
        tl_name AS coachee_name,
        country,
        region,
        NULLIF(SAFE_CAST(coachings_performed AS FLOAT64), 0) AS coachings_performed,
        NULLIF(SAFE_CAST(coachings_target AS FLOAT64), 0) AS coachings_target,
        notes,
        exempt,
        exempt_reason,
        'CX Quality Team Lead' AS coachee_role
      FROM `ti-ca-ml-start.QA_Training_scorecards.2026_cx_qamnr_coaching_raw`

      UNION ALL

      /* --- BLOCK 3: CX Regional Leads/Directors coaching CX Quality Managers/Sr Managers --- */
      SELECT
        SAFE.PARSE_DATE('%b %Y', CONCAT(INITCAP(SUBSTR(TRIM(CAST(report_month AS STRING)), 1, 3)), ' ', REGEXP_REPLACE(TRIM(CAST(report_year AS STRING)), r'\.0$', ''))) AS date,
        report_month,
        report_year,
        mgr_l1_wdid AS coach_wdid,
        mgr_l1_name AS coach_name,
        mngr_wdid AS coachee_wdid,
        mgr_name AS coachee_name,
        country,
        region,
        NULLIF(SAFE_CAST(coachings_performed AS FLOAT64), 0) AS coachings_performed,
        NULLIF(SAFE_CAST(coachings_target AS FLOAT64), 0) AS coachings_target,
        notes,
        exempt,
        exempt_reason,
        'CX Quality Manager/Sr Manager' AS coachee_role
      FROM `ti-ca-ml-start.QA_Training_scorecards.2026_cx_regionallead_directors_coaching_raw`

      UNION ALL

      /* --- BLOCK 4: T&S Quality Team Leads coaching T&S Quality Analysts --- */
      SELECT
        SAFE.PARSE_DATE('%b %Y', CONCAT(INITCAP(SUBSTR(TRIM(CAST(report_month AS STRING)), 1, 3)), ' ', REGEXP_REPLACE(TRIM(CAST(report_year AS STRING)), r'\.0$', ''))) AS date,
        report_month,
        report_year,
        tl_wdid AS coach_wdid,
        tl_name AS coach_name,
        tm_wdid AS coachee_wdid,
        tm_name AS coachee_name,
        country,
        region,
        NULLIF(SAFE_CAST(coachings_performed AS FLOAT64), 0) AS coachings_performed,
        NULLIF(SAFE_CAST(coachings_target AS FLOAT64), 0) AS coachings_target,
        notes,
        exempt,
        exempt_reason,
        'T&S Quality Analyst' AS coachee_role
      FROM `ti-ca-ml-start.QA_Training_scorecards.2026_trustandsafety_qatl_coaching_raw`

      UNION ALL

      /* --- BLOCK 5: T&S Quality Managers coaching T&S Quality TLs/Sr TLs --- */
      SELECT
        SAFE.PARSE_DATE('%b %Y', CONCAT(INITCAP(SUBSTR(TRIM(CAST(report_month AS STRING)), 1, 3)), ' ', REGEXP_REPLACE(TRIM(CAST(report_year AS STRING)), r'\.0$', ''))) AS date,
        report_month,
        report_year,
        mngr_wdid AS coach_wdid,
        mngr_name AS coach_name,
        tl_wdid AS coachee_wdid,
        tl_name AS coachee_name,
        country,
        region,
        NULLIF(SAFE_CAST(coachings_performed AS FLOAT64), 0) AS coachings_performed,
        NULLIF(SAFE_CAST(coachings_target AS FLOAT64), 0) AS coachings_target,
        notes,
        exempt,
        exempt_reason,
        'T&S Quality TL/Sr TL' AS coachee_role
      FROM `ti-ca-ml-start.QA_Training_scorecards.2026_trustandsafety_qamnr_coaching_raw`

      UNION ALL

      /* --- BLOCK 6: T&S Regional Leads/Directors coaching T&S Quality Managers/Sr Managers --- */
      SELECT
        SAFE.PARSE_DATE('%b %Y', CONCAT(INITCAP(SUBSTR(TRIM(CAST(report_month AS STRING)), 1, 3)), ' ', REGEXP_REPLACE(TRIM(CAST(report_year AS STRING)), r'\.0$', ''))) AS date,
        report_month,
        report_year,
        mgr_l1_wdid AS coach_wdid,
        mgr_l1_name AS coach_name,
        mngr_wdid AS coachee_wdid,
        mgr_name AS coachee_name,
        country,
        region,
        NULLIF(SAFE_CAST(coachings_performed AS FLOAT64), 0) AS coachings_performed,
        NULLIF(SAFE_CAST(coachings_target AS FLOAT64), 0) AS coachings_target,
        notes,
        exempt,
        exempt_reason,
        'T&S Quality Manager/Sr Manager' AS coachee_role
      FROM `ti-ca-ml-start.QA_Training_scorecards.2026_trustandsafety_regionallead_directors_coaching_raw`
    )

  /* =========================================================================================
     FINAL ASSEMBLY: ROW-LEVEL SECURITY & DATE FILTERING
     Generates the definitive dataset by applying the combined RLS string (Coachee + upward 
     chain + Global Access). Filters out invalid Coach IDs and enforces the business rule to 
     only evaluate coaching data from July onwards (Month >= 7).
  ========================================================================================= */
  SELECT 
    c.date,
    c.report_month,
    c.report_year,
    c.coach_wdid,
    c.coach_name,
    c.coachee_wdid,
    c.coachee_name,
    c.country,
    c.region,
    c.coachings_performed,
    c.coachings_target,
    c.notes,
    c.exempt,
    c.exempt_reason,
    c.coachee_role,

    -- Security Column: Grants access to the Coachee, up to 6 hierarchical managers, and Full Access list
    NULLIF(
      ARRAY_TO_STRING(
        ARRAY(
          SELECT DISTINCT email
          FROM UNNEST(
            SPLIT(
              CONCAT(
                IFNULL(r.full_chain_emails, ''),
                ',',
                IFNULL(fa.full_access_emails, '')
              ), ','
            )
          ) AS email
          WHERE email IS NOT NULL AND TRIM(email) != ''
        ), ','
      ), ''
    ) AS row_level_security

  FROM consolidated_data c
  CROSS JOIN full_access_list fa
  LEFT JOIN roster_security r
    ON REGEXP_REPLACE(TRIM(CAST(c.coachee_wdid AS STRING)), r'\.0$', '') = r.employee_id_std
   AND UPPER(TRIM(SUBSTR(CAST(c.report_month AS STRING), 1, 3))) = r.month_std
   AND SAFE_CAST(c.report_year AS STRING) = r.year_std
   
  WHERE c.coach_wdid IS NOT NULL 
    AND TRIM(CAST(c.coach_wdid AS STRING)) NOT IN ('', '-', 'NULL')
    AND EXTRACT(MONTH FROM c.date) >= 7;

END;
