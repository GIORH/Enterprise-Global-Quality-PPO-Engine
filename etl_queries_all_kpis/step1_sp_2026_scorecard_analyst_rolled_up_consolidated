CREATE OR REPLACE PROCEDURE `ti-ca-ml-start.QA_Training_scorecards.step1_sp_2026_scorecard_analyst_rolled_up_consolidated`()
BEGIN

  /************************************************************************************************
   PROCEDURE: step1_sp_2026_scorecard_analyst_rolled_up_consolidated
   DESCRIPTION: Master consolidation procedure for the rolled-up CX Quality Analyst Scorecard. 
                Unifies dimensions from four detailed metric ETL pipelines (Quality, VOC, Accuracy, 
                and Productivity). Standardizes the primary composite key (TM_WDID|Month|Year|Program|Country) 
                and cleans timestamps into MM/DD/YYYY format. Integrates full audit blocks and 
                capping metrics for QA and VOC alongside Productivity and Accuracy metrics to 
                formulate the master consolidated reporting layer.
  ************************************************************************************************/

  CREATE OR REPLACE TABLE `ti-ca-ml-start.QA_Training_scorecards.2026_analyst_rolled_up_consolidated` AS
  
  /* ===========================================================================
     BLOCK 1: RAW DIMENSION COLLECTION (UNION ALL)
     Consolidates base dimensions across all four analyst-level detailed source tables.
  =========================================================================== */
  WITH All_Sources AS (
      SELECT 
        SAFE_CAST(tm_wdid AS STRING) as tm_wdid, 
        SAFE_CAST(report_month AS STRING) as report_month, 
        SAFE_CAST(report_year AS STRING) as report_year, 
        SAFE_CAST(program AS STRING) as program, 
        SAFE_CAST(role AS STRING) as role, 
        SAFE_CAST(timestamp AS STRING) as timestamp, 
        SAFE_CAST(submitter_email AS STRING) as submitter_email, 
        SAFE_CAST(tl_wdid AS STRING) as tl_wdid, 
        tl_name, 
        tl_manager, 
        tl_sr_manager, 
        tm_name, 
        country, 
        region
      FROM `ti-ca-ml-start.QA_Training_scorecards.2026_qa_ptg_quality_analyst_detailed`
      
      UNION ALL
      
      SELECT 
        SAFE_CAST(tm_wdid AS STRING) as tm_wdid, 
        SAFE_CAST(report_month AS STRING) as report_month, 
        SAFE_CAST(report_year AS STRING) as report_year, 
        SAFE_CAST(program AS STRING) as program, 
        SAFE_CAST(role AS STRING) as role, 
        SAFE_CAST(timestamp AS STRING) as timestamp, 
        SAFE_CAST(submitter_email AS STRING) as submitter_email, 
        SAFE_CAST(tl_wdid AS STRING) as tl_wdid, 
        tl_name, 
        tl_manager, 
        tl_sr_manager, 
        tm_name, 
        country, 
        region
      FROM `ti-ca-ml-start.QA_Training_scorecards.2026_voc_ptg_quality_analyst_detailed`
      
      UNION ALL
      
      SELECT 
        SAFE_CAST(tm_wdid AS STRING) as tm_wdid, 
        SAFE_CAST(report_month AS STRING) as report_month, 
        SAFE_CAST(report_year AS STRING) as report_year, 
        SAFE_CAST(program AS STRING) as program, 
        SAFE_CAST(role AS STRING) as role, 
        SAFE_CAST(timestamp AS STRING) as timestamp, 
        SAFE_CAST(submitter_email AS STRING) as submitter_email, 
        SAFE_CAST(tl_wdid AS STRING) as tl_wdid, 
        tl_name, 
        tl_manager, 
        tl_sr_manager, 
        tm_name, 
        country, 
        region
      FROM `ti-ca-ml-start.QA_Training_scorecards.2026_qa_accuracy_analyst_detailed`
      
      UNION ALL
      
      SELECT 
        SAFE_CAST(tm_wdid AS STRING) as tm_wdid, 
        SAFE_CAST(report_month AS STRING) as report_month, 
        SAFE_CAST(report_year AS STRING) as report_year, 
        SAFE_CAST(program AS STRING) as program, 
        SAFE_CAST(role AS STRING) as role, 
        SAFE_CAST(timestamp AS STRING) as timestamp, 
        SAFE_CAST(submitter_email AS STRING) as submitter_email, 
        SAFE_CAST(tl_wdid AS STRING) as tl_wdid, 
        tl_name, 
        tl_manager, 
        tl_sr_manager, 
        tm_name, 
        country, 
        region
      FROM `ti-ca-ml-start.QA_Training_scorecards.2026_qa_productivity_analyst_detailed`
  ),

  /* ===========================================================================
     BLOCK 2: STANDARDIZATION (PRIMARY KEY AND TIMESTAMP)
     Constructs the master primary key (TM_WDID|Month|Year|Program|Country) and cleanses 
     timestamp entries into a standardized MM/DD/YYYY string format.
  =========================================================================== */
  Standardized_Skeleton AS (
    SELECT 
      CONCAT(tm_wdid, '|', report_month, '|', report_year, '|', program, '|', country) as key,
      role,
      submitter_email,
      report_month,
      report_year,
      tl_wdid,
      tl_name,
      tl_manager,
      tl_sr_manager,
      tm_wdid,
      tm_name,
      program,
      country,
      region,
      COALESCE(
        SAFE.FORMAT_TIMESTAMP('%m/%d/%Y', SAFE_CAST(timestamp AS TIMESTAMP)),
        SAFE.FORMAT_DATE('%m/%d/%Y', SAFE.PARSE_DATE('%m/%d/%Y', REGEXP_EXTRACT(timestamp, r'\d{1,2}/\d{1,2}/\d{4}'))),
        SAFE.FORMAT_DATE('%m/%d/%Y', SAFE.PARSE_DATE('%Y-%m-%d', REGEXP_EXTRACT(timestamp, r'\d{4}-\d{2}-\d{2}'))),
        timestamp 
      ) as clean_timestamp
    FROM All_Sources
  ),

  /* ===========================================================================
     BLOCK 3: FINAL SKELETON
     Deduplicates the standardized dimension records by grouping on the primary key, 
     establishing the consolidated backbone for metric joining.
  =========================================================================== */
  Final_Skeleton AS (
    SELECT 
      key,
      MAX(role) as role,
      MAX(clean_timestamp) as timestamp,
      MAX(submitter_email) as submitter_email,
      report_month,
      report_year,
      MAX(tl_wdid) as tl_wdid,
      MAX(tl_name) as tl_name,
      MAX(tl_manager) as tl_manager,
      MAX(tl_sr_manager) as tl_sr_manager,
      tm_wdid,
      MAX(tm_name) as tm_name,
      program,
      country,
      region
    FROM Standardized_Skeleton
    GROUP BY 
      key, 
      report_month, 
      report_year, 
      tm_wdid, 
      program,
      country,
      region
  ),

  /* ===========================================================================
     BLOCK 4: QA METRIC DATA (FULL 20 COLUMNS)
     Extracts all Quality % to Goal calculation fields, audit flags, capping outputs, 
     and diluted point values mapped by the master composite key.
  =========================================================================== */
  QA_Data AS (
    SELECT 
      CONCAT(SAFE_CAST(tm_wdid AS STRING), '|', SAFE_CAST(report_month AS STRING), '|', SAFE_CAST(report_year AS STRING), '|', SAFE_CAST(program AS STRING), '|', SAFE_CAST(country AS STRING)) as key,
      qaptg_business_category,
      qa_kpi,
      qa_kpi_applicable,
      qa_exempt,
      qa_reason,
      quality_score_actual,
      quality_score_target_program,
      final_total_programs AS qa_final_total_programs,
      qa_weight,
      qa_single_multi_program,
      qa_single_program,
      quality_multi_program,
      qa_perf_vs_cap_uncapped,
      adjusted_score_based_on_cap AS qa_adjusted_score_based_on_cap,
      achievement_category AS qa_achievement_category,
      qa_points_obtained,
      qa_weight_obtaiend,
      qa_weight_obtaiend_program_diluted,
      qa_points_obtained_for_final_score_only,
      qa_points_obtained_for_final_score_only_program_diluted
    FROM `ti-ca-ml-start.QA_Training_scorecards.2026_qa_ptg_quality_analyst_detailed`
  ),

  /* ===========================================================================
     BLOCK 5: VOC METRIC DATA (FULL 20 COLUMNS)
     Extracts all VOC % to Goal calculation fields, audit flags, capping outputs, 
     and diluted point values mapped by the master composite key.
  =========================================================================== */
  VOC_Data AS (
    SELECT 
      CONCAT(SAFE_CAST(tm_wdid AS STRING), '|', SAFE_CAST(report_month AS STRING), '|', SAFE_CAST(report_year AS STRING), '|', SAFE_CAST(program AS STRING), '|', SAFE_CAST(country AS STRING)) as key,
      voc_business_category,
      voc_kpi,
      voc_kpi_applicable,
      voc_exempt,
      voc_reason,
      voc_score_actual,
      voc_score_target_program,
      final_total_programs AS voc_final_total_programs,
      voc_weight,
      voc_single_multi_program,
      voc_single_program,
      voc_multi_program,
      voc_perf_vs_cap_uncapped,
      adjusted_score_based_on_cap AS voc_adjusted_score_based_on_cap,
      achievement_category AS voc_achievement_category,
      voc_points_obtained,
      voc_weight_obtaiend,
      voc_weight_obtaiend_program_diluted,
      voc_points_obtained_for_final_score_only,
      voc_points_obtained_for_final_score_only_program_diluted
    FROM `ti-ca-ml-start.QA_Training_scorecards.2026_voc_ptg_quality_analyst_detailed`
  ),

  /* ===========================================================================
     BLOCK 6: PRODUCTIVITY METRIC DATA
     Extracts all Productivity metrics, completion volumes (QA, VOC, Calibrations), 
     targets, and calculated weight distributions mapped by the master composite key.
  =========================================================================== */
  Productivity_Data AS (
    SELECT 
      CONCAT(SAFE_CAST(tm_wdid AS STRING), '|', SAFE_CAST(report_month AS STRING), '|', SAFE_CAST(report_year AS STRING), '|', SAFE_CAST(program AS STRING), '|', SAFE_CAST(country AS STRING)) as key,
      productivity_business_category,
      kpi AS productivity_kpi,
      qa_evals_completed,
      qa_evals_target,
      voc_evals_completed,
      voc_evals_target,
      calibrations_completed,
      calibrations_target,
      productivity_target_master,
      productivity_weight_master,
      productivity_pct_to_goal,
      productivity_status,
      productivity_points_obtained,
      productivity_earned_weight,
      productivity_points_obtained_for_final_score_only,
      productivity_weight_obtaiend_program_diluted
    FROM `ti-ca-ml-start.QA_Training_scorecards.2026_qa_productivity_analyst_detailed`
  ),

  /* ===========================================================================
     BLOCK 7: ACCURACY METRIC DATA
     Extracts all Accuracy metrics, dispute counts, evaluation accuracy volumes, 
     and calculated weight distributions mapped by the master composite key.
  =========================================================================== */
  Accuracy_Data AS (
    SELECT 
      CONCAT(SAFE_CAST(tm_wdid AS STRING), '|', SAFE_CAST(report_month AS STRING), '|', SAFE_CAST(report_year AS STRING), '|', SAFE_CAST(program AS STRING), '|', SAFE_CAST(country AS STRING)) as key,
      accuracy_business_category,
      kpi AS accuracy_kpi,
      cal_accurate,
      cal_performed,
      valid_disputes,
      total_completed_evals,
      accurate_evals,
      accuracy_target_master,
      accuracy_weight_master,
      accuracy_pct_to_goal,
      accuracy_earned_weight,
      accuracy_achievement_category,
      accuracy_points_obtained,
      accuracy_weight_diluted,
      accuracy_points_obtained_for_final_score_only,
      accuracy_weight_obtaiend_program_diluted
    FROM `ti-ca-ml-start.QA_Training_scorecards.2026_qa_accuracy_analyst_detailed`
  )

  /* ===========================================================================
     BLOCK 8: FINAL CONSOLIDATED SELECT
     Joins all individual metric blocks (QA, VOC, Productivity, Accuracy) back to 
     the master dimension skeleton via LEFT JOIN to assemble the complete consolidated scorecard.
  =========================================================================== */
  SELECT 
    -- Basic Dimensions
    s.key,
    s.role,
    s.timestamp,
    s.submitter_email,
    s.report_month,
    s.report_year,
    s.tl_wdid,
    s.tl_name,
    s.tl_manager,
    s.tl_sr_manager,
    s.tm_wdid,
    s.tm_name,
    s.program,
    s.country,
    s.region,

    -- QA Block (Full 20 Columns)
    q.qaptg_business_category,
    q.qa_kpi,
    q.qa_kpi_applicable,
    q.qa_exempt,
    q.qa_reason,
    q.quality_score_actual,
    q.quality_score_target_program,
    q.qa_final_total_programs,
    q.qa_weight,
    q.qa_single_multi_program,
    q.qa_single_program,
    q.quality_multi_program,
    q.qa_perf_vs_cap_uncapped,
    q.qa_adjusted_score_based_on_cap,
    q.qa_achievement_category,
    q.qa_points_obtained,
    q.qa_weight_obtaiend,
    q.qa_weight_obtaiend_program_diluted,
    q.qa_points_obtained_for_final_score_only,
    q.qa_points_obtained_for_final_score_only_program_diluted,

    -- VOC Block (Full 20 Columns)
    v.voc_business_category,
    v.voc_kpi,
    v.voc_kpi_applicable,
    v.voc_exempt,
    v.voc_reason,
    v.voc_score_actual,
    v.voc_score_target_program,
    v.voc_final_total_programs,
    v.voc_weight,
    v.voc_single_multi_program,
    v.voc_single_program,
    v.voc_multi_program,
    v.voc_perf_vs_cap_uncapped,
    v.voc_adjusted_score_based_on_cap,
    v.voc_achievement_category,
    v.voc_points_obtained,
    v.voc_weight_obtaiend,
    v.voc_weight_obtaiend_program_diluted,
    v.voc_points_obtained_for_final_score_only,
    v.voc_points_obtained_for_final_score_only_program_diluted,

    -- Productivity Block
    p.productivity_business_category,
    p.productivity_kpi,
    p.qa_evals_completed,
    p.qa_evals_target,
    p.voc_evals_completed,
    p.voc_evals_target,
    p.calibrations_completed,
    p.calibrations_target,
    p.productivity_target_master,
    p.productivity_weight_master,
    p.productivity_pct_to_goal,
    p.productivity_status,
    p.productivity_points_obtained,
    p.productivity_earned_weight,
    p.productivity_points_obtained_for_final_score_only,
    p.productivity_weight_obtaiend_program_diluted,

    -- Accuracy Block
    a.accuracy_business_category,
    a.accuracy_kpi,
    a.cal_accurate,
    a.cal_performed,
    a.valid_disputes,
    a.total_completed_evals,
    a.accurate_evals,
    a.accuracy_target_master,
    a.accuracy_weight_master,
    a.accuracy_pct_to_goal,
    a.accuracy_earned_weight,
    a.accuracy_achievement_category,
    a.accuracy_points_obtained,
    a.accuracy_weight_diluted,
    a.accuracy_points_obtained_for_final_score_only,
    a.accuracy_weight_obtaiend_program_diluted

  FROM Final_Skeleton s
  LEFT JOIN QA_Data q 
    ON s.key = q.key
  LEFT JOIN VOC_Data v 
    ON s.key = v.key
  LEFT JOIN Productivity_Data p 
    ON s.key = p.key
  LEFT JOIN Accuracy_Data a
    ON s.key = a.key;

END;
