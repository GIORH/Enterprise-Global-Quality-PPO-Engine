CREATE OR REPLACE PROCEDURE `ti-ca-ml-start.QA_Training_scorecards.step2_sp_2026_scorecard_quality_analyst_consolidated`()
BEGIN

  CREATE OR REPLACE TABLE `ti-ca-ml-start.QA_Training_scorecards.2026_scorecard_quality_analyst_consolidated` AS
  
  WITH 
    /* --- PASO 1: PREPARAR Y SANITIZAR LAS FUENTES --- */
    rolled_src AS (
      SELECT 
        REGEXP_REPLACE(TRIM(CAST(tm_wdid AS STRING)), r'\.0$', '') as wdid, 
        UPPER(TRIM(SUBSTR(CAST(report_month AS STRING), 1, 3))) as month, -- Definitive 3-Letter Upper Standard
        REGEXP_REPLACE(TRIM(CAST(report_year AS STRING)), r'\.0$', '') as year, 
        TRIM(program) as program,
        * EXCEPT(tm_wdid, report_month, report_year, program)
      FROM `ti-ca-ml-start.QA_Training_scorecards.2026_analyst_rolled_up_consolidated`
    ),

    non_rolled_src AS (
      SELECT 
        REGEXP_REPLACE(TRIM(CAST(tm_wdid AS STRING)), r'\.0$', '') as wdid, 
        UPPER(TRIM(SUBSTR(CAST(report_month AS STRING), 1, 3))) as month, -- Definitive 3-Letter Upper Standard
        REGEXP_REPLACE(TRIM(CAST(report_year AS STRING)), r'\.0$', '') as year,
        * EXCEPT(tm_wdid, report_month, report_year)
      FROM `ti-ca-ml-start.QA_Training_scorecards.2026_analyst_non_rolled_up_consolidate`
    ),

    /* --- PASO 2: CREAR EL ESQUELETO MAESTRO CON BLINDAJE GEOGRÁFICO --- */
    master_skeleton AS (
      -- 1. Todas las llaves operativas de producción
      SELECT DISTINCT wdid, month, year, program, country, region FROM rolled_src
      WHERE wdid IS NOT NULL AND TRIM(wdid) NOT IN ('', '-', 'NULL')
      UNION DISTINCT
      -- 2. Analistas que están en Non-Rolled pero no tienen producción (Huérfanos)
      SELECT DISTINCT wdid, month, year, CAST(NULL AS STRING) as program, country, region 
      FROM non_rolled_src n
      WHERE NOT EXISTS (
        SELECT 1 FROM rolled_src r 
        WHERE r.wdid = n.wdid AND r.month = n.month AND r.year = n.year
      )
      AND n.wdid IS NOT NULL AND TRIM(n.wdid) NOT IN ('', '-', 'NULL')
    ),

    /* --- PASO 3: OBTENER DEMOGRÁFICOS UNIFICADOS (CORREGIDO GROUP BY) --- */
    demographics AS (
      SELECT 
        wdid, month, year, program, country, region,
        ANY_VALUE(role) as role,
        ANY_VALUE(tm_name) as tm_name,
        ANY_VALUE(tl_wdid) as tl_wdid,
        ANY_VALUE(tl_name) as tl_name,
        ANY_VALUE(tl_manager) as tl_manager,
        ANY_VALUE(tl_sr_manager) as tl_sr_manager
      FROM (
        SELECT wdid, month, year, program, country, region, role, tm_name, tl_wdid, tl_name, tl_manager, tl_sr_manager FROM rolled_src
        UNION ALL
        SELECT wdid, month, year, CAST(NULL AS STRING) as program, country, region, role, tm_name, tl_wdid, tl_name, tl_manager, tl_sr_manager FROM non_rolled_src
      )
      GROUP BY 1, 2, 3, 4, 5, 6
    )

  /* --- PASO 4: ENSAMBLE FINAL CON SCORE TOTAL DINÁMICO (DAPT) --- */
  SELECT 
    ptg_base.*,
    
    -- Mapeo de final_score_tier basado en los nuevos buckets de PTG
    CASE 
      WHEN ptg_base.final_score_ptg IS NULL THEN NULL
      WHEN ptg_base.final_score_ptg < 0.50 THEN 'Improvement Required'
      WHEN ptg_base.final_score_ptg < 0.75 THEN 'Developing'
      WHEN ptg_base.final_score_ptg < 0.87 THEN 'Achieving'
      ELSE 'Excelling'
    END AS final_score_tier

  FROM (
    SELECT 
      base.*,
      -- Porcentaje de logro final protegido contra divisiones por cero
      SAFE_DIVIDE(base.final_score_points_obtained, base.max_final_score_points_available) AS final_score_ptg
    FROM (
      SELECT 
        -- PRIMARY KEY ESTÁNDAR: wdid_month_year_program_country
        CONCAT(s.wdid, '_', s.month, '_', s.year, IFNULL(CONCAT('_', s.program), ''), '_', s.country) as primary_key,
        s.wdid as tm_wdid,
        s.month as report_month,
        s.year as report_year,
        s.program,
        d.role,
        d.tm_name,
        d.country,
        d.region,
        d.tl_wdid,
        d.tl_name,
        d.tl_manager,
        d.tl_sr_manager,
        r.* EXCEPT(wdid, month, year, program, role, tm_name, country, region, tl_wdid, tl_name, tl_manager, tl_sr_manager, key, timestamp, submitter_email),
        n.* EXCEPT(wdid, month, year, role, tm_name, country, region, tl_wdid, tl_name, tl_manager, tl_sr_manager, key, timestamp, submitter_email),
        
        -- Pilares de metadatos estandarizados para el Unpivot del Paso 3
        CAST('All' AS STRING) AS final_score_business_category,
        CAST('Final Score' AS STRING) AS final_score_kpi,
        
        -- Sumatoria de puntos ganados
        (
          COALESCE(r.qa_points_obtained_for_final_score_only, 0) +
          COALESCE(r.voc_points_obtained_for_final_score_only, 0) +
          COALESCE(r.productivity_points_obtained_for_final_score_only, 0) +
          COALESCE(r.accuracy_points_obtained_for_final_score_only, 0) +
          COALESCE(n.ppd_points_obtained_for_final_score_only, 0) +
          COALESCE(n.td_points_obtained_for_final_score_only, 0)
        ) AS final_score_points_obtained,

        -- Techo máximo disponible de puntos
        (
          COALESCE(r.qa_weight, 0) * 4 +
          COALESCE(r.voc_weight, 0) * 4 +
          COALESCE(r.productivity_weight_master, 0) * 3 +
          COALESCE(r.accuracy_weight_master, 0) * 4 +
          COALESCE(n.ppd_weight, 0) * 4 +
          COALESCE(n.td_weight, 0) * 4
        ) AS max_final_score_points_available

      FROM master_skeleton s
      LEFT JOIN demographics d ON s.wdid = d.wdid AND s.month = d.month AND s.year = d.year AND (s.program = d.program OR (s.program IS NULL AND d.program IS NULL)) AND s.country = d.country AND s.region = d.region
      LEFT JOIN rolled_src r   ON s.wdid = r.wdid AND s.month = r.month AND s.year = r.year AND s.program = r.program AND s.country = r.country AND s.region = r.region
      LEFT JOIN non_rolled_src n ON s.wdid = n.wdid AND s.month = n.month AND s.year = n.year
    ) AS base
  ) AS ptg_base;

END;
