CREATE OR REPLACE PROCEDURE `ti-ca-ml-start.QA_Training_scorecards.step1_sp_2026_scorecard_lead_trustandsafety_non_rolled_up_consolidated`()
BEGIN

  CREATE OR REPLACE TABLE `ti-ca-ml-start.QA_Training_scorecards.step1_sp_2026_scorecard_lead_trustandsafety_non_rolled_up_consolidated` AS
  
  WITH 
    /* --- PART 1: RAW DATA AGGREGATION FROM REALTIME T&S SOURCE --- */
    Base_Aggregation AS (
      SELECT
        CAST(tl_wdid AS INT64) AS tl_wdid,
        LOWER(TRIM(report_month)) AS report_month,
        CAST(report_year AS INT64) AS report_year,
        ANY_VALUE(TRIM(tl_name)) AS tl_name,
        ANY_VALUE(TRIM(country)) AS country,
        ANY_VALUE(TRIM(region)) AS region,
        ANY_VALUE(TRIM(tl_manager)) AS tl_manager,
        ANY_VALUE(TRIM(tl_sr_manager)) AS tl_sr_manager,
        
        -- Estado e Inputs de Innovation (Mapeado a columnas de la Sheet Realtime)
        MAX(innovation_exempt) AS innovation_exempt,
        MAX(innovation_exception_reason) AS innovation_reason, 
        SUM(CASE WHEN LOWER(TRIM(innovation_exempt)) = 'no' THEN SAFE_CAST(innovation_high_count AS FLOAT64) ELSE NULL END) AS inn_h,
        SUM(CASE WHEN LOWER(TRIM(innovation_exempt)) = 'no' THEN SAFE_CAST(innovation_med_count AS FLOAT64) ELSE NULL END) AS inn_m,
        SUM(CASE WHEN LOWER(TRIM(innovation_exempt)) = 'no' THEN SAFE_CAST(innovation_low_count AS FLOAT64) ELSE NULL END) AS inn_l,
        
        -- Estado e Inputs de PPD (Mapeado a columnas de la Sheet Realtime)
        MAX(ppd_exempt) AS ppd_exempt,
        MAX(ppd_exception_reason) AS ppd_reason, 
        SUM(CASE WHEN LOWER(TRIM(ppd_exempt)) = 'no' THEN SAFE_CAST(ppd_mandatory_completed AS FLOAT64) ELSE NULL END) AS ppd_act,
        SUM(CASE WHEN LOWER(TRIM(ppd_exempt)) = 'no' THEN SAFE_CAST(ppd_required_courses AS FLOAT64) ELSE NULL END) AS ppd_tar
      FROM `ti-ca-ml-start.QA_Training_scorecards.2026_ts_qatl_consolidated_kpis_2_raw`
      GROUP BY 1, 2, 3
    ),

    /* --- PART 2: ASSEMBLY & BASE CALCULATIONS --- */
    Assembly AS (
      SELECT 
        *,
        COALESCE(innovation_exempt, 'No') AS inn_exempt_clean,
        COALESCE(ppd_exempt, 'No') AS ppd_exempt_clean,
        'Yes' AS innovation_kpi_applicable,
        'Yes' AS ppd_kpi_applicable,
        
        -- Metric Points Calculation (Innovation)
        CASE 
          WHEN inn_h IS NULL AND inn_m IS NULL AND inn_l IS NULL THEN NULL 
          ELSE (COALESCE(inn_h,0) * 4 + COALESCE(inn_m,0) * 3 + COALESCE(inn_l,0) * 2) 
        END AS inn_total_pts,

        -- Raw data for PPD
        SAFE_DIVIDE(ppd_act, ppd_tar) AS ppd_ptg_raw,

        -- Constants
        0.10 AS weight_const, 
        1.0 AS target_const   
      FROM Base_Aggregation
    ),

    /* --- PART 3: PTG MAPPING --- */
    Logic_Attribution AS (
      SELECT 
        *,
        -- Innovation PTG Mapping (1pt=25%, 2pts=50%, 3pts=75%, 4pts=100%, 5+pts=100.1%)
        CASE 
          WHEN inn_total_pts IS NULL THEN NULL
          WHEN inn_total_pts = 1 THEN 0.25
          WHEN inn_total_pts = 2 THEN 0.50
          WHEN inn_total_pts = 3 THEN 0.75
          WHEN inn_total_pts = 4 THEN 1.00
          WHEN inn_total_pts >= 5 THEN 1.001 
          ELSE 0.0 
        END AS inn_ptg_mapped
      FROM Assembly
    )

  /* --- PART 4: FINAL SELECTION & CATEGORIZATION --- */
  SELECT 
    CONCAT(CAST(tl_wdid AS STRING), '_', report_month, '_', CAST(report_year AS STRING)) AS primary_key,
    tl_wdid, report_month, report_year, tl_name, tl_manager, tl_sr_manager, country, region,

    -- INNOVATION BLOCK
    'My Business' AS innovation_businesscategory,
    'Innovation' AS innovation_kpi,
    innovation_kpi_applicable,
    inn_exempt_clean AS innovation_exempt,
    innovation_reason,
    inn_h AS innovation_high_count, 
    inn_m AS innovation_med_count, 
    inn_l AS innovation_low_count,
    IF(UPPER(TRIM(inn_exempt_clean)) = 'YES', NULL, inn_total_pts) AS innovation_metric_points, 
    target_const AS innovation_target,
    CASE 
      WHEN UPPER(TRIM(inn_exempt_clean)) = 'YES' THEN NULL 
      ELSE weight_const 
    END AS innovation_weight,
    IF(UPPER(TRIM(inn_exempt_clean)) = 'YES', NULL, inn_ptg_mapped) AS innovation_ptg,
    
    IF(UPPER(TRIM(inn_exempt_clean)) = 'YES', NULL, 
      CASE 
        WHEN (inn_ptg_mapped * weight_const) > weight_const THEN weight_const 
        ELSE (inn_ptg_mapped * weight_const) 
      END) AS innovation_weight_obtained,
      
    IF(UPPER(TRIM(inn_exempt_clean)) = 'YES', NULL,
      CASE 
        WHEN inn_ptg_mapped > 1.00  THEN 'Excelling'
        WHEN inn_ptg_mapped = 1.00  THEN 'Achieving'
        WHEN inn_ptg_mapped >= 0.75 THEN 'Developing'
        ELSE 'Improvement Required' 
      END) AS innovation_achievement,
      
    IF(UPPER(TRIM(inn_exempt_clean)) = 'YES', NULL,
      CASE 
        WHEN inn_ptg_mapped > 1.00  THEN 4
        WHEN inn_ptg_mapped = 1.00  THEN 3
        WHEN inn_ptg_mapped >= 0.75 THEN 2
        ELSE 1 
      END) AS innovation_points_obtained,
      
    IF(UPPER(TRIM(inn_exempt_clean)) = 'YES', NULL,
      (CASE 
        WHEN inn_ptg_mapped > 1.00  THEN 4
        WHEN inn_ptg_mapped = 1.00  THEN 3
        WHEN inn_ptg_mapped >= 0.75 THEN 2
        ELSE 1 
      END * weight_const)) AS innovation_points_obtained_for_final_score_only,

    -- PPD BLOCK
    'My Team' AS ppd_businesscategory,
    'PPD' AS ppd_kpi,
    ppd_kpi_applicable,
    ppd_exempt_clean AS ppd_exempt,
    ppd_reason,
    ppd_act AS ppd_mandatory_completed, 
    ppd_tar AS ppd_required_courses,
    target_const AS ppd_target,
    IF(UPPER(TRIM(ppd_exempt_clean)) = 'YES', NULL, ppd_ptg_raw) AS ppd_ptg,
    CASE 
      WHEN UPPER(TRIM(ppd_exempt_clean)) = 'YES' THEN NULL 
      ELSE weight_const 
    END AS ppd_weight,
    
    IF(UPPER(TRIM(ppd_exempt_clean)) = 'YES', NULL,
      CASE 
        WHEN ppd_ptg_raw > 1.0   THEN 'Excelling'
        WHEN ppd_ptg_raw >= 0.91 THEN 'Achieving'
        WHEN ppd_ptg_raw >= 0.50 THEN 'Developing'
        ELSE 'Improvement Required' 
      END) AS ppd_achievement_category,
      
    IF(UPPER(TRIM(ppd_exempt_clean)) = 'YES', NULL,
      (CASE 
        WHEN ppd_ptg_raw > 1.0   THEN 4
        WHEN ppd_ptg_raw >= 0.91 THEN 3
        WHEN ppd_ptg_raw >= 0.50 THEN 2
        ELSE 1 
      END / 4.0) * weight_const) AS ppd_weight_obtained,
      
    IF(UPPER(TRIM(ppd_exempt_clean)) = 'YES', NULL,
      CASE 
        WHEN ppd_ptg_raw > 1.0   THEN 4
        WHEN ppd_ptg_raw >= 0.91 THEN 3
        WHEN ppd_ptg_raw >= 0.50 THEN 2
        ELSE 1 
      END) AS ppd_points_obtained,
      
    IF(UPPER(TRIM(ppd_exempt_clean)) = 'YES', NULL,
      (CASE 
        WHEN ppd_ptg_raw > 1.0   THEN 4
        WHEN ppd_ptg_raw >= 0.91 THEN 3
        WHEN ppd_ptg_raw >= 0.50 THEN 2
        ELSE 1 
      END * weight_const)) AS ppd_points_obtained_for_final_score_only

  FROM Logic_Attribution;

END;
