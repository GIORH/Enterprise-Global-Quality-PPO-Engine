CREATE OR REPLACE PROCEDURE `ti-ca-ml-start.QA_Training_scorecards.step2_sp_2026_scorecard_qa_regional_lead_consolidated`()
BEGIN

  CREATE OR REPLACE TABLE `ti-ca-ml-start.QA_Training_scorecards.2026_scorecard_qa_regional_lead_consolidated` AS
  
  WITH 
    /* --- 1. ROLLED UP (Main Skeleton: Detailed Quality Data by Program, Country, and Vertical) --- */
    rolled AS (
      SELECT 
        -- SAFE FIX: Handles alphanumeric IDs and prevents 'Bad int64 value' execution errors
        REGEXP_REPLACE(TRIM(CAST(wdid_regional_lead AS STRING)), r'\.0$', '') as wdid,
        UPPER(TRIM(SUBSTR(CAST(report_month AS STRING), 1, 3))) as month, -- Definitive 3-Letter Upper Standard
        SAFE_CAST(report_year AS STRING) as year,
        IFNULL(NULLIF(TRIM(region), ''), 'No Region') as region,
        IFNULL(NULLIF(TRIM(program), ''), 'No Program') as program,
        TRIM(regional_lead_name) as lead_name,
        -- Standardized fixed role for the analytical layer
        CAST(' CX and T&S Quality Regional Lead' AS STRING) as role,
        timestamp, 
        achievement_category as qa_achievement_category,
        * EXCEPT (wdid_regional_lead, report_month, report_year, region, program, regional_lead_name, role, timestamp, achievement_category)
      FROM `ti-ca-ml-start.QA_Training_scorecards.2026_qa_ptg_regional_lead_detailed`
      -- ROOT PROTECTION: Filters ghost records out from quality data
      WHERE wdid_regional_lead IS NOT NULL 
        AND TRIM(CAST(wdid_regional_lead AS STRING)) NOT IN ('', '-', 'NULL')
    ),

    /* --- 2. NON-ROLLED UP (Secondary Skeleton: Role Specific Management Metrics) --- */
    non_rolled AS (
      SELECT 
        REGEXP_REPLACE(TRIM(CAST(lead_wdid AS STRING)), r'\.0$', '') as wdid,
        UPPER(TRIM(SUBSTR(CAST(report_month AS STRING), 1, 3))) as month, -- Definitive 3-Letter Upper Standard
        SAFE_CAST(report_year AS STRING) as year,
        TRIM(lead_name) as lead_name,
        TRIM(role) as role,
        timestamp,
        * EXCEPT (lead_wdid, report_month, report_year, lead_name, role, timestamp)
      FROM `ti-ca-ml-start.QA_Training_scorecards.2026_scorecard_qa_regional_lead_non_rolled_up_consolidated`
      -- ROOT PROTECTION: Filters ghost records out from management data
      WHERE lead_wdid IS NOT NULL 
        AND TRIM(CAST(lead_wdid AS STRING)) NOT IN ('', '-', 'NULL')
      -- KEY: Ensures a single row per leader-month-year for a clean broadcast join without row duplication
      QUALIFY ROW_NUMBER() OVER(PARTITION BY wdid, month, year ORDER BY timestamp DESC) = 1
    ),

    /* --- NEW BLOCK: CASCADE LEADERSHIP DATA INTEGRATION (YETG) --- */
    leadership_regional_agg AS (
      SELECT 
        REGEXP_REPLACE(TRIM(CAST(Employee_ID AS STRING)), r'\.0$', '') AS wdid,
        UPPER(TRIM(SUBSTR(CAST(report_month AS STRING), 1, 3))) AS month, -- Definitive 3-Letter Upper Standard
        SAFE_CAST(report_year AS STRING) AS year,
        SAFE_CAST(leadership_ptg AS FLOAT64) AS leadership_ptg
      FROM `ti-ca-ml-start.QA_Training_scorecards.global_qa_roster_with_scores`
      WHERE Employee_ID IS NOT NULL
    ),

    /* --- 3. POTP STEP: DEFENSIVE REGIONAL PRE-AGGREGATION AGAINST DUPLICATES (CORREGIDO CON COUNTRY) --- */
    potp_regional_agg AS (
      SELECT 
        REGEXP_REPLACE(TRIM(CAST(inmediate_supervisor_id AS STRING)), r'\.0$', '') as wdid, 
        UPPER(TRIM(SUBSTR(CAST(month AS STRING), 1, 3))) as month, -- Definitive 3-Letter Upper Standard
        SAFE_CAST(year AS STRING) as year, 
        TRIM(program) as program,
        LOWER(TRIM(region)) as region,
        LOWER(TRIM(country)) as country, -- AÑADIDO PARA EVITAR COLAPSO MULTI-PAÍS
        SUM(count_top_performers) as count_top_performers,
        SUM(count_total) as count_total,
        MAX(target_master) as target_master,
        SAFE_DIVIDE(SUM(count_top_performers), SUM(count_total)) as potp_ptg
      FROM `ti-ca-ml-start.QA_Training_scorecards.2026_potp_all_roles_etl_output`
      WHERE inmediate_supervisor_id IS NOT NULL 
        AND TRIM(CAST(inmediate_supervisor_id AS STRING)) NOT IN ('', '-', 'NULL')
      GROUP BY 1, 2, 3, 4, 5, 6
    )

  /* --- 4. FINAL SELECT WITH DYNAMIC INVERTED LOGIC AND DAPT SCORE CALCULATION --- */
  SELECT 
    base.*,
    
    -- Dynamic final achievement ratio protected against divisions by zero
    SAFE_DIVIDE(base.final_score_points_obtained, base.max_final_score_points_available) AS final_score_ptg,
    
    -- Final Tiers mapping based strictly on the requested individual evaluation buckets
    CASE 
      WHEN SAFE_DIVIDE(base.final_score_points_obtained, base.max_final_score_points_available) IS NULL THEN NULL
      WHEN SAFE_DIVIDE(base.final_score_points_obtained, base.max_final_score_points_available) < 0.50 THEN 'Improvement Required'
      WHEN SAFE_DIVIDE(base.final_score_points_obtained, base.max_final_score_points_available) < 0.75 THEN 'Developing'
      WHEN SAFE_DIVIDE(base.final_score_points_obtained, base.max_final_score_points_available) < 0.87 THEN 'Achieving'
      ELSE 'Excelling'
    END AS final_score_tier

  FROM (
    SELECT 
      -- Primary Key extended to operational grain: Region, Program, Country, and Cost Center
      CONCAT(r.wdid, '_', r.year, '_', r.month, '_', r.region, '_', r.program, '_', IFNULL(r.country, 'No Country'), '_', r.cost_center) as pk,
      r.timestamp,
      n.submitter_email,
      r.month as report_month,
      r.year as report_year,
      r.region,
      r.country,      -- Explicitly injected layout placeholder
      r.program, 
      r.cost_center,  -- Explicitly injected layout placeholder
      r.role,
      r.wdid as lead_wdid,
      IFNULL(r.lead_name, n.lead_name) as lead_name,

      -- Management Block (Couples secondarily and distributes across each program row of the leader)
      n.* EXCEPT (wdid, month, year, region, lead_name, role, pk, timestamp, submitter_email),

      -- Quality Block (Sourced directly from the primary driving table)
      r.* EXCEPT (wdid, month, year, region, program, country, cost_center, lead_name, role, timestamp),

      -- ===========================================================================
      -- INTEGRATION OF NEW PILLAR: YETG (15% WEIGHT & DEFINITIVE 'JUN' RULE)
      -- ===========================================================================
      CAST('My Team' AS STRING) AS yearly_evals_business_category,
      CAST('Yearly Evaluations (% to goal)' AS STRING) AS yearly_evals_kpi,
      
      -- Placeholders estructurales fijos en todos los meses para blindar el Unpivot
      1.00 AS yearly_evals_target_master,
      0.15 AS yearly_evals_weight_master, -- Peso específico del 15% para Regional Leads
      CASE WHEN r.month = 'JUN' THEN l.leadership_ptg ELSE NULL END AS yearly_evals_ptg,
      CAST(CASE WHEN r.month = 'JUN' AND l.leadership_ptg IS NOT NULL THEN 'Yes' ELSE 'No' END AS STRING) AS yearly_evals_kpi_applicable,
      
      CASE 
        WHEN r.month != 'JUN' THEN NULL
        WHEN l.leadership_ptg IS NULL THEN NULL
        WHEN l.leadership_ptg < 0.90 THEN 'Improvement Required'
        WHEN l.leadership_ptg < 1.00 THEN 'Developing'
        WHEN l.leadership_ptg < 1.01 THEN 'Achieving'
        ELSE 'Excelling'
      END AS yearly_evals_achievement_category,

      CASE 
        WHEN r.month != 'JUN' THEN NULL
        WHEN l.leadership_ptg IS NULL THEN NULL
        WHEN l.leadership_ptg < 0.90 THEN 1
        WHEN l.leadership_ptg < 1.00 THEN 2
        WHEN l.leadership_ptg < 1.01 THEN 3
        ELSE 4
      END AS yearly_evals_metric_points,

      CASE 
        WHEN r.month != 'JUN' THEN NULL
        WHEN l.leadership_ptg IS NULL THEN NULL
        WHEN l.leadership_ptg < 0.90 THEN 0.25
        WHEN l.leadership_ptg < 1.00 THEN 0.50
        WHEN l.leadership_ptg < 1.01 THEN 0.75
        ELSE 1.00
      END * 0.15 AS yearly_evals_weight_earned,

      CASE 
        WHEN r.month != 'JUN' THEN NULL
        WHEN l.leadership_ptg IS NULL THEN NULL
        WHEN l.leadership_ptg < 0.90 THEN 1
        WHEN l.leadership_ptg < 1.00 THEN 2
        WHEN l.leadership_ptg < 1.01 THEN 3
        ELSE 4
      END * 0.15 AS yearly_evals_points_final_score,

      -- ===========================================================================
      -- SURGICAL INTEGRATION OF POTP PILLAR (15% WEIGHT)
      -- ===========================================================================
      CAST('My Team' AS STRING) AS potp_business_category,
      CAST('% of Top Performers' AS STRING) AS potp_kpi,
      p.count_top_performers AS potp_count_top_performers,
      p.count_total AS potp_count_total,
      CAST(CASE WHEN p.count_total IS NULL OR p.count_total = 0 THEN 'No' ELSE 'Yes' END AS STRING) AS potp_kpi_applicable,
      CAST('No' AS STRING) AS potp_exempt,
      CAST(NULL AS STRING) AS potp_reason,
      0.15 AS potp_weight,
      p.target_master AS potp_target,
      p.potp_ptg AS potp_ptg,
      
      CASE 
        WHEN p.count_total IS NULL OR p.count_total = 0 THEN NULL
        WHEN p.potp_ptg < 0.75 THEN 'Improvement Required'
        WHEN p.potp_ptg < 0.90 THEN 'Developing'
        WHEN p.potp_ptg < 0.95 THEN 'Achieving'
        ELSE 'Excelling'
      END AS potp_achievement_tier,

      CASE 
        WHEN p.count_total IS NULL OR p.count_total = 0 THEN NULL
        WHEN p.potp_ptg < 0.75 THEN 1
        WHEN p.potp_ptg < 0.90 THEN 2
        WHEN p.potp_ptg < 0.95 THEN 3
        ELSE 4
      END AS potp_points_obtained,

      CASE 
        WHEN p.count_total IS NULL OR p.count_total = 0 THEN NULL
        WHEN p.potp_ptg < 0.75 THEN 0.25
        WHEN p.potp_ptg < 0.90 THEN 0.50
        WHEN p.potp_ptg < 0.95 THEN 0.75
        ELSE 1.00
      END * 0.15 AS potp_weight_obtained,

      CASE 
        WHEN p.count_total IS NULL OR p.count_total = 0 THEN NULL
        WHEN p.potp_ptg < 0.75 THEN 1
        WHEN p.potp_ptg < 0.90 THEN 2
        WHEN p.potp_ptg < 0.95 THEN 3
        ELSE 4
      END * 0.15 AS potp_points_for_final_score,

      -- Standardized metadata pillars for Step 3 Unpivot
      CAST('All' AS STRING) AS final_score_business_category,
      CAST('Final Score' AS STRING) AS final_score_kpi,

      -- Total score calculations (YETG evaluation restricted exclusively to 'JUN')
      (
        COALESCE(n.sei_points_final_score, 0) +
        COALESCE(n.ppd_points_final_score, 0) +
        COALESCE(r.qa_points_obtained_for_final_score_only, 0) +
        COALESCE(CASE 
          WHEN r.month != 'JUN' THEN NULL
          WHEN l.leadership_ptg IS NULL THEN NULL
          WHEN l.leadership_ptg < 0.90 THEN 1
          WHEN l.leadership_ptg < 1.00 THEN 2
          WHEN l.leadership_ptg < 1.01 THEN 3
          ELSE 4
        END * 0.15, 0) + 
        COALESCE(CASE 
          WHEN p.count_total IS NULL OR p.count_total = 0 THEN NULL
          WHEN p.potp_ptg < 0.75 THEN 1
          WHEN p.potp_ptg < 0.90 THEN 2
          WHEN p.potp_ptg < 0.95 THEN 3
          ELSE 4
        END * 0.15, 0)
      ) AS final_score_points_obtained,

      -- Dynamic available point ceiling (YETG weight drops to 0 outside of 'JUN' standard)
      (
        COALESCE(n.sei_weight, 0) * 4 +
        COALESCE(n.ppd_weight, 0) * 4 +
        COALESCE(r.qa_weight, 0) * 4 +
        COALESCE(CASE WHEN r.month != 'JUN' OR l.leadership_ptg IS NULL THEN 0 ELSE 0.15 END * 4, 0) + 
        COALESCE(CASE WHEN p.count_total IS NULL OR p.count_total = 0 THEN 0 ELSE 0.15 END * 4, 0)
      ) AS max_final_score_points_available

    FROM rolled r
    -- LEFT JOIN distributes fixed leader metrics using unified identity keys
    LEFT JOIN non_rolled n ON r.wdid = n.wdid AND r.month = n.month AND r.year = n.year
    
    -- LEFT JOIN couples YETG using unified identity keys
    LEFT JOIN leadership_regional_agg l ON r.wdid = l.wdid AND r.month = l.month AND r.year = l.year
    
    -- LEFT JOIN couples POTP using regional grouped granularity with unified month standard (CORREGIDO CON PAÍS)
    LEFT JOIN potp_regional_agg p
      ON r.wdid = p.wdid
      AND r.month = p.month
      AND r.year = p.year
      AND (r.program = p.program OR (r.program IS NULL AND p.program IS NULL))
      AND LOWER(TRIM(r.region)) = p.region
      AND LOWER(TRIM(r.country)) = p.country
  ) AS base
  WHERE base.lead_wdid IN ('10053071', '10017324');

END;
