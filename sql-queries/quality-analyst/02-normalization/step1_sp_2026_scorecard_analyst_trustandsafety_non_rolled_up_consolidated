CREATE OR REPLACE PROCEDURE `ti-ca-ml-start.QA_Training_scorecards.step1_sp_2026_scorecard_analyst_trustandsafety_non_rolled_up_consolidated`()
BEGIN

  /************************************************************************************************
   * ETL: Scorecard Analyst Trust & Safety (Non Rolled-up) - 2026
   * GRAIN: Monthly / Analyst / Activity
   ************************************************************************************************/

  CREATE OR REPLACE TABLE `ti-ca-ml-start.QA_Training_scorecards.step1_sp_2026_scorecard_analyst_trustandsafety_non_rolled_up_consolidated` AS

  /*-----------------------------------------------------------------------------------------------
    1. IDENTIFICATION BLOCK (HEADER)
  -----------------------------------------------------------------------------------------------*/
  WITH HeaderData AS (
    SELECT
      timestamp, 
      submitter_email, 
      report_month, 
      report_year, 
      tl_wdid, 
      tl_name, 
      tl_manager, 
      tl_sr_manager, 
      tm_wdid, 
      tm_name, 
      country, 
      region
    FROM 
      `ti-ca-ml-start.QA_Training_scorecards.2026_ts_qa_consolidated_kpis_2_raw`
  ),

  /*-----------------------------------------------------------------------------------------------
    2. METRIC BLOCK: TEAM DEVELOPMENT
  -----------------------------------------------------------------------------------------------*/
  Team_Development_Step1_Base AS (
    SELECT
      h.*,
      'My Team' AS teamdevelopment_business_category,
      'Team Development' AS teamdevelopment_kpi,
  
      -- Blanqueo si td_kpi_applicable es 'NO' o td_exempt es 'YES'
      CASE WHEN UPPER(TRIM(raw.td_kpi_applicable)) = 'NO' OR UPPER(TRIM(raw.td_exempt)) = 'YES' THEN NULL ELSE raw.workshops_delivered END AS workshops_delivered,
      CASE WHEN UPPER(TRIM(raw.td_kpi_applicable)) = 'NO' OR UPPER(TRIM(raw.td_exempt)) = 'YES' THEN NULL ELSE raw.workshops_required END AS workshops_required,
      raw.td_notes,
      raw.td_kpi_applicable,
      raw.td_exempt,
      raw.td_reason,
      1.00 AS teamdevelopment_target_master,
      CASE 
        WHEN UPPER(TRIM(raw.td_kpi_applicable)) = 'NO' OR UPPER(TRIM(raw.td_exempt)) = 'YES' THEN NULL 
        ELSE 0.20 
      END AS teamdevelopment_weight_master,
      
      -- PTG protegido
      CASE WHEN UPPER(TRIM(raw.td_kpi_applicable)) = 'NO' OR UPPER(TRIM(raw.td_exempt)) = 'YES' THEN NULL ELSE SAFE_DIVIDE(SAFE_CAST(raw.workshops_delivered AS FLOAT64), SAFE_CAST(raw.workshops_required AS FLOAT64)) END AS teamdevelopment_ptg
    FROM HeaderData h
    JOIN `ti-ca-ml-start.QA_Training_scorecards.2026_ts_qa_consolidated_kpis_2_raw` raw
      ON h.tm_wdid = raw.tm_wdid AND h.report_month = raw.report_month AND h.report_year = raw.report_year
  ),

  Team_Development_Step2_Tiers_And_Points AS (
    SELECT
      *,
      CASE 
        WHEN UPPER(TRIM(td_kpi_applicable)) = 'NO' OR UPPER(TRIM(td_exempt)) = 'YES' THEN NULL
        WHEN teamdevelopment_ptg < 0.75 THEN 'Improvement Required'
        WHEN teamdevelopment_ptg >= 0.75 AND teamdevelopment_ptg <= 0.9166 THEN 'Developing'
        WHEN teamdevelopment_ptg > 0.9166 AND teamdevelopment_ptg <= 1.0099 THEN 'Achieving'
        WHEN teamdevelopment_ptg >= 1.01 THEN 'Excelling'
        ELSE NULL 
      END AS team_development_achievement_category,

      CASE 
        WHEN UPPER(TRIM(td_kpi_applicable)) = 'NO' OR UPPER(TRIM(td_exempt)) = 'YES' THEN NULL
        WHEN (CASE WHEN teamdevelopment_ptg < 0.75 THEN 'Improvement Required' WHEN teamdevelopment_ptg >= 0.75 AND teamdevelopment_ptg <= 0.9166 THEN 'Developing' WHEN teamdevelopment_ptg > 0.9166 AND teamdevelopment_ptg <= 1.0099 THEN 'Achieving' WHEN teamdevelopment_ptg >= 1.01 THEN 'Excelling' END) = 'Improvement Required' THEN 1
        WHEN (CASE WHEN teamdevelopment_ptg < 0.75 THEN 'Improvement Required' WHEN teamdevelopment_ptg >= 0.75 AND teamdevelopment_ptg <= 0.9166 THEN 'Developing' WHEN teamdevelopment_ptg > 0.9166 AND teamdevelopment_ptg <= 1.0099 THEN 'Achieving' WHEN teamdevelopment_ptg >= 1.01 THEN 'Excelling' END) = 'Developing' THEN 2
        WHEN (CASE WHEN teamdevelopment_ptg < 0.75 THEN 'Improvement Required' WHEN teamdevelopment_ptg >= 0.75 AND teamdevelopment_ptg <= 0.9166 THEN 'Developing' WHEN teamdevelopment_ptg > 0.9166 AND teamdevelopment_ptg <= 1.0099 THEN 'Achieving' WHEN teamdevelopment_ptg >= 1.01 THEN 'Excelling' END) = 'Achieving' THEN 3
        WHEN (CASE WHEN teamdevelopment_ptg < 0.75 THEN 'Improvement Required' WHEN teamdevelopment_ptg >= 0.75 AND teamdevelopment_ptg <= 0.9166 THEN 'Developing' WHEN teamdevelopment_ptg > 0.9166 AND teamdevelopment_ptg <= 1.0099 THEN 'Achieving' WHEN teamdevelopment_ptg >= 1.01 THEN 'Excelling' END) = 'Excelling' THEN 4
        ELSE 0 
      END AS team_developoment_points
    FROM Team_Development_Step1_Base
  ),

  Team_Development_Final_Block AS (
    SELECT 
      *,
      CASE WHEN UPPER(TRIM(td_kpi_applicable)) = 'NO' OR UPPER(TRIM(td_exempt)) = 'YES' THEN NULL ELSE (team_developoment_points / 4) * teamdevelopment_weight_master END AS team_development_weight_obtained,
      CASE WHEN UPPER(TRIM(td_kpi_applicable)) = 'NO' OR UPPER(TRIM(td_exempt)) = 'YES' THEN NULL ELSE team_developoment_points * teamdevelopment_weight_master END AS team_development_points_final_score
    FROM 
      Team_Development_Step2_Tiers_And_Points
  ),

  /*-----------------------------------------------------------------------------------------------
    3. METRIC BLOCK: PPD (PERSONAL PROFESSIONAL DEVELOPMENT)
  -----------------------------------------------------------------------------------------------*/
  PPD_Step1_Base AS (
    SELECT
      td.*,
      'My Team' AS ppd_business_category,
      'personal_professional_development' AS ppd_kpi,
      
      -- Blanqueo si ppd_kpi_applicable es 'NO' o ppd_exempt es 'YES'
      CASE WHEN UPPER(TRIM(raw.ppd_kpi_applicable)) = 'NO' OR UPPER(TRIM(raw.ppd_exempt)) = 'YES' THEN NULL ELSE raw.courses_completed END AS courses_completed,
      CASE WHEN UPPER(TRIM(raw.ppd_kpi_applicable)) = 'NO' OR UPPER(TRIM(raw.ppd_exempt)) = 'YES' THEN NULL ELSE raw.courses_required END AS courses_required,
      raw.ppd_notes,
      raw.ppd_kpi_applicable,
      raw.ppd_exempt,
      raw.ppd_reason,
      1.00 AS ppd_target_master,
      CASE 
        WHEN UPPER(TRIM(raw.ppd_kpi_applicable)) = 'NO' OR UPPER(TRIM(raw.ppd_exempt)) = 'YES' THEN NULL 
        ELSE 0.15 
      END AS ppd_weight_master,
      
      -- PTG protegido
      CASE WHEN UPPER(TRIM(raw.ppd_kpi_applicable)) = 'NO' OR UPPER(TRIM(raw.ppd_exempt)) = 'YES' THEN NULL ELSE SAFE_DIVIDE(SAFE_CAST(raw.courses_completed AS FLOAT64), SAFE_CAST(raw.courses_required AS FLOAT64)) END AS ppd_ptg
    FROM Team_Development_Final_Block td
    JOIN `ti-ca-ml-start.QA_Training_scorecards.2026_ts_qa_consolidated_kpis_2_raw` raw
      ON td.tm_wdid = raw.tm_wdid AND td.report_month = raw.report_month AND td.report_year = raw.report_year
  ),

  PPD_Step2_Tiers_And_Points AS (
    SELECT
      *,
      CASE 
        WHEN UPPER(TRIM(ppd_kpi_applicable)) = 'NO' OR UPPER(TRIM(ppd_exempt)) = 'YES' THEN NULL
        WHEN ppd_ptg < 0.75 THEN 'Improvement Required'
        WHEN ppd_ptg >= 0.75 AND ppd_ptg <= 0.9599 THEN 'Developing'
        WHEN ppd_ptg >= 0.96 AND ppd_ptg <= 1.0099 THEN 'Achieving'
        WHEN ppd_ptg >= 1.01 THEN 'Excelling'
        ELSE NULL 
      END AS ppd_achievement_category,

      CASE 
        WHEN UPPER(TRIM(ppd_kpi_applicable)) = 'NO' OR UPPER(TRIM(ppd_exempt)) = 'YES' THEN NULL
        WHEN (CASE WHEN ppd_ptg < 0.75 THEN 'Improvement Required' WHEN ppd_ptg >= 0.75 AND ppd_ptg <= 0.9599 THEN 'Developing' WHEN ppd_ptg >= 0.96 AND ppd_ptg <= 1.0099 THEN 'Achieving' WHEN ppd_ptg >= 1.01 THEN 'Excelling' END) = 'Improvement Required' THEN 1
        WHEN (CASE WHEN ppd_ptg < 0.75 THEN 'Improvement Required' WHEN ppd_ptg >= 0.75 AND ppd_ptg <= 0.9599 THEN 'Developing' WHEN ppd_ptg >= 0.96 AND ppd_ptg <= 1.0099 THEN 'Achieving' WHEN ppd_ptg >= 1.01 THEN 'Excelling' END) = 'Developing' THEN 2
        WHEN (CASE WHEN ppd_ptg < 0.75 THEN 'Improvement Required' WHEN ppd_ptg >= 0.75 AND ppd_ptg <= 0.9599 THEN 'Developing' WHEN ppd_ptg >= 0.96 AND ppd_ptg <= 1.0099 THEN 'Achieving' WHEN ppd_ptg >= 1.01 THEN 'Excelling' END) = 'Achieving' THEN 3
        WHEN (CASE WHEN ppd_ptg < 0.75 THEN 'Improvement Required' WHEN ppd_ptg >= 0.75 AND ppd_ptg <= 0.9599 THEN 'Developing' WHEN ppd_ptg >= 0.96 AND ppd_ptg <= 1.0099 THEN 'Achieving' WHEN ppd_ptg >= 1.01 THEN 'Excelling' END) = 'Excelling' THEN 4
        ELSE 0 
      END AS ppd_points
    FROM PPD_Step1_Base
  ),

  PPD_Final_Block AS (
    SELECT 
      *,
      CASE WHEN UPPER(TRIM(ppd_kpi_applicable)) = 'NO' OR UPPER(TRIM(ppd_exempt)) = 'YES' THEN NULL ELSE (ppd_points / 4) * ppd_weight_master END AS ppd_weight_earn,
      CASE WHEN UPPER(TRIM(ppd_kpi_applicable)) = 'NO' OR UPPER(TRIM(ppd_exempt)) = 'YES' THEN NULL ELSE ppd_points * ppd_weight_master END AS ppd_final_points
    FROM 
      PPD_Step2_Tiers_And_Points
  )

  -- FINAL SELECTION
  SELECT 
    * FROM 
    PPD_Final_Block;

END;
