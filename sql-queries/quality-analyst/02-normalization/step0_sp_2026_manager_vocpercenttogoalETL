CREATE OR REPLACE PROCEDURE `ti-ca-ml-start.QA_Training_scorecards.step0_sp_2026_manager_vocpercenttogoalETL`()
BEGIN

  /************************************************************************************************
   PROCEDURE: Manager & Sr Manager - VOC % to Goal Rolled-up (Weight 10%)
  ************************************************************************************************/

  CREATE OR REPLACE TABLE `ti-ca-ml-start.QA_Training_scorecards.2026_voc_ptg_manager_detailed` AS
  
  -- ==============================================================================================
  -- BRANCH 1: MANAGER (100% INTACT ORIGINAL LOGIC)
  -- ==============================================================================================
  -- 1. CTE: Extraction of Manager ID and Name, and program counting
  WITH ManagerBase AS (
    SELECT 
      *,
      REGEXP_EXTRACT(tl_manager, r'\((\d+)\)\s*$') AS wdid_manager,
      TRIM(REGEXP_EXTRACT(tl_manager, r'^(.*?)\s*\(\d+\)\s*$')) AS manager_name
    FROM `ti-ca-ml-start.QA_Training_scorecards.2026_qa_voc_raw`
  ),

  ProgramCounts AS (
    SELECT 
      wdid_manager, report_month, report_year, 
      COUNT(DISTINCT program) AS final_total_programs
    FROM ManagerBase
    GROUP BY 1, 2, 3
  ),

  -- 2. CTE: Skeleton, Averages, and Initial Calculations
  CalculatedData AS (
    SELECT 
      'CX Quality Manager and Sr Manager' AS role,
      MAX(raw.timestamp) AS timestamp,
      raw.report_month,
      raw.report_year,
      raw.manager_name,
      raw.wdid_manager,
      raw.tl_sr_manager,
      raw.program,
      raw.country,
      raw.region,
      'My Customer' AS voc_business_category,
      'VOC % to Goal' AS voc_kpi,
      
      -- Support columns with hierarchical logic for Manager level state roll-up
      IF(COUNTIF(LOWER(TRIM(raw.kpi_applicable)) = 'yes') > 0, 'Yes', 'No') AS voc_kpi_applicable,
      IF(COUNTIF(LOWER(TRIM(raw.exempt)) = 'no') > 0, 'No', 'Yes') AS voc_exempt,
      IF(COUNTIF(LOWER(TRIM(raw.exempt)) = 'no') > 0, 'Rolled up by Manager and Program', 'Exempt') AS voc_reason,
      
      -- Rolled up Average Scores filtering out exempt analysts to protect the calculation
      IF(COUNTIF(LOWER(TRIM(raw.exempt)) = 'no') = 0, NULL, FORMAT('%.2f%%', AVG(CASE WHEN LOWER(TRIM(raw.exempt)) = 'no' THEN CAST(REPLACE(raw.voc_score_actual, '%', '') AS FLOAT64) ELSE NULL END))) AS voc_score_actual,
      IF(COUNTIF(LOWER(TRIM(raw.exempt)) = 'no') = 0, NULL, FORMAT('%.2f%%', AVG(CASE WHEN LOWER(TRIM(raw.exempt)) = 'no' THEN CAST(REPLACE(raw.voc_score_target_program, '%', '') AS FLOAT64) ELSE NULL END))) AS voc_score_target_program,
      
      pc.final_total_programs,
      
      -- Dynamic weight with hierarchical exclusion logic retaining original value of 0.15
      CASE 
        WHEN COUNTIF(LOWER(TRIM(raw.kpi_applicable)) = 'yes') > 0 AND COUNTIF(LOWER(TRIM(raw.exempt)) = 'no') > 0 THEN 0.15 
        ELSE NULL 
      END AS voc_weight,

      -- Initial calculations over active analysts averages
      SAFE_DIVIDE(
        AVG(CASE WHEN LOWER(TRIM(raw.exempt)) = 'no' THEN CAST(REPLACE(raw.voc_score_actual, '%', '') AS FLOAT64) ELSE NULL END), 
        AVG(CASE WHEN LOWER(TRIM(raw.exempt)) = 'no' THEN CAST(REPLACE(raw.voc_score_target_program, '%', '') AS FLOAT64) ELSE NULL END)
      ) AS voc_single_multi_program,

      CASE WHEN pc.final_total_programs = 1 THEN
        SAFE_DIVIDE(
          AVG(CASE WHEN LOWER(TRIM(raw.exempt)) = 'no' THEN CAST(REPLACE(raw.voc_score_actual, '%', '') AS FLOAT64) ELSE NULL END), 
          AVG(CASE WHEN LOWER(TRIM(raw.exempt)) = 'no' THEN CAST(REPLACE(raw.voc_score_target_program, '%', '') AS FLOAT64) ELSE NULL END)
        )
      ELSE NULL END AS voc_single_program,

      -- Internal calculation for Capping free of exempt analysts
      SAFE_DIVIDE(
        AVG(CASE WHEN LOWER(TRIM(raw.exempt)) = 'no' THEN CAST(REPLACE(raw.voc_score_actual, '%', '') AS FLOAT64) ELSE NULL END), 
        AVG(CASE WHEN LOWER(TRIM(raw.exempt)) = 'no' THEN CAST(REPLACE(raw.voc_score_target_program, '%', '') AS FLOAT64) ELSE NULL END)
      ) AS _raw_calc
    FROM ManagerBase AS raw
    LEFT JOIN ProgramCounts AS pc 
      ON raw.wdid_manager = pc.wdid_manager AND raw.report_month = pc.report_month AND raw.report_year = pc.report_year
    GROUP BY 3,4,5,6,7,8,9,10, pc.final_total_programs
  ),

  -- 3. CTE: Capping over averages (Specific VOC Buckets: 85/95.99/114.99/115)
  CappedData AS (
    SELECT * EXCEPT(_raw_calc),
      IF(voc_exempt = 'Yes', NULL,
        CASE WHEN final_total_programs >= 2 THEN
            CASE 
              WHEN _raw_calc <= 0.50 THEN 0
              WHEN _raw_calc > 0.50 AND _raw_calc <= 0.85 THEN 0.50
              WHEN _raw_calc > 0.85 AND _raw_calc <= 0.9599 THEN 0.75
              WHEN _raw_calc >= 0.96 AND _raw_calc <= 1.1499 THEN 1.00
              WHEN _raw_calc >= 1.15 THEN 1.15
              ELSE _raw_calc
            END
        ELSE NULL END) AS voc_multi_program,
      IF(voc_exempt = 'Yes', NULL,
        COALESCE(voc_single_program, 
                 CASE WHEN final_total_programs >= 2 THEN
                   CASE 
                     WHEN _raw_calc <= 0.50 THEN 0
                     WHEN _raw_calc > 0.50 AND _raw_calc <= 0.85 THEN 0.50
                     WHEN _raw_calc > 0.85 AND _raw_calc <= 0.9599 THEN 0.75
                     WHEN _raw_calc >= 0.96 AND _raw_calc <= 1.1499 THEN 1.00
                     WHEN _raw_calc >= 1.15 THEN 1.15
                     ELSE _raw_calc
                   END
                 ELSE NULL END)) AS voc_perf_vs_cap_uncapped
    FROM CalculatedData
  ),

  -- 4. CTE: Categories and Points (VOC Thresholds: 85/95/96)
  CategorizedAndPointsData AS (
    SELECT *,
      IF(voc_exempt = 'Yes', NULL,
        CASE 
          WHEN voc_perf_vs_cap_uncapped < 0.85 THEN 'Improvement Required'
          WHEN voc_perf_vs_cap_uncapped >= 0.85 AND voc_perf_vs_cap_uncapped <= 0.9499 THEN 'Developing'
          WHEN voc_perf_vs_cap_uncapped >= 0.95 AND voc_perf_vs_cap_uncapped <= 0.9599 THEN 'Achieving'
          WHEN voc_perf_vs_cap_uncapped >= 0.96 THEN 'Excelling'
          ELSE NULL 
        END) AS achievement_category,
      IF(voc_exempt = 'Yes', NULL,
        CASE 
          WHEN voc_perf_vs_cap_uncapped < 0.85 THEN 1
          WHEN voc_perf_vs_cap_uncapped >= 0.85 AND voc_perf_vs_cap_uncapped <= 0.9499 THEN 2
          WHEN voc_perf_vs_cap_uncapped >= 0.95 AND voc_perf_vs_cap_uncapped <= 0.9599 THEN 3
          WHEN voc_perf_vs_cap_uncapped >= 0.96 THEN 4
          ELSE NULL 
        END) AS voc_points_obtained
    FROM CappedData
  ),

  -- 5. Final Manager CTE: Weights and Dilution
  ManagerFinalData AS (
    SELECT 
      *,
      -- Preserved original alias typo: voc_weight_obtaiend
      IF(voc_exempt = 'Yes', NULL, (voc_points_obtained * 0.25) * voc_weight) AS voc_weight_obtaiend,
      IF(voc_exempt = 'Yes', NULL, voc_points_obtained * voc_weight) AS voc_points_obtained_for_final_score_only,
      -- Preserved original alias typo: voc_weight_obtaiend_program_diluted
      IF(voc_exempt = 'Yes', NULL,
        (CASE 
          WHEN achievement_category = 'Improvement Required' THEN voc_weight * 0.25
          WHEN achievement_category = 'Developing' THEN voc_weight * 0.50
          WHEN achievement_category = 'Achieving' THEN voc_weight * 0.75
          WHEN achievement_category = 'Excelling' THEN voc_weight * 1.00
          ELSE NULL 
        END) * SAFE_DIVIDE(1.0, final_total_programs)) AS voc_weight_obtaiend_program_diluted
    FROM 
      CategorizedAndPointsData
  ),

  -- ==============================================================================================
  -- BRANCH 2: SENIOR MANAGER (RE-MAPPED MIRROR LOGIC)
  -- ==============================================================================================
  -- 1. CTE: Extraction of Senior Manager ID and Name re-mapped to manager_name/wdid_manager
  SrManagerBase AS (
    SELECT 
      * EXCEPT(tl_sr_manager),
      CAST(NULL AS STRING) AS tl_sr_manager, -- Blank for Senior Manager hierarchy level
      REGEXP_EXTRACT(tl_sr_manager, r'\((\d+)\)\s*$') AS wdid_manager,
      TRIM(REGEXP_EXTRACT(tl_sr_manager, r'^(.*?)\s*\(\d+\)\s*$')) AS manager_name
    FROM `ti-ca-ml-start.QA_Training_scorecards.2026_qa_voc_raw`
    WHERE tl_sr_manager IS NOT NULL AND TRIM(tl_sr_manager) != ''
  ),

  -- 2. CTE: Program counting aggregated at Senior Manager level
  SrProgramCounts AS (
    SELECT 
      wdid_manager, report_month, report_year, 
      COUNT(DISTINCT program) AS final_total_programs
    FROM SrManagerBase
    GROUP BY 1, 2, 3
  ),

  -- 3. CTE: Skeleton, Averages, and Calculations for Senior Manager
  SrCalculatedData AS (
    SELECT 
      'CX Quality Manager and Sr Manager' AS role,
      MAX(raw.timestamp) AS timestamp,
      raw.report_month,
      raw.report_year,
      raw.manager_name,
      raw.wdid_manager,
      raw.tl_sr_manager,
      raw.program,
      raw.country,
      raw.region,
      'My Customer' AS voc_business_category,
      'VOC % to Goal' AS voc_kpi,
      
      IF(COUNTIF(LOWER(TRIM(raw.kpi_applicable)) = 'yes') > 0, 'Yes', 'No') AS voc_kpi_applicable,
      IF(COUNTIF(LOWER(TRIM(raw.exempt)) = 'no') > 0, 'No', 'Yes') AS voc_exempt,
      IF(COUNTIF(LOWER(TRIM(raw.exempt)) = 'no') > 0, 'Rolled up by Senior Manager and Program', 'Exempt') AS voc_reason,
      
      IF(COUNTIF(LOWER(TRIM(raw.exempt)) = 'no') = 0, NULL, FORMAT('%.2f%%', AVG(CASE WHEN LOWER(TRIM(raw.exempt)) = 'no' THEN CAST(REPLACE(raw.voc_score_actual, '%', '') AS FLOAT64) ELSE NULL END))) AS voc_score_actual,
      IF(COUNTIF(LOWER(TRIM(raw.exempt)) = 'no') = 0, NULL, FORMAT('%.2f%%', AVG(CASE WHEN LOWER(TRIM(raw.exempt)) = 'no' THEN CAST(REPLACE(raw.voc_score_target_program, '%', '') AS FLOAT64) ELSE NULL END))) AS voc_score_target_program,
      
      pc.final_total_programs,
      
      CASE 
        WHEN COUNTIF(LOWER(TRIM(raw.kpi_applicable)) = 'yes') > 0 AND COUNTIF(LOWER(TRIM(raw.exempt)) = 'no') > 0 THEN 0.15 
        ELSE NULL 
      END AS voc_weight,

      SAFE_DIVIDE(
        AVG(CASE WHEN LOWER(TRIM(raw.exempt)) = 'no' THEN CAST(REPLACE(raw.voc_score_actual, '%', '') AS FLOAT64) ELSE NULL END), 
        AVG(CASE WHEN LOWER(TRIM(raw.exempt)) = 'no' THEN CAST(REPLACE(raw.voc_score_target_program, '%', '') AS FLOAT64) ELSE NULL END)
      ) AS voc_single_multi_program,

      CASE WHEN pc.final_total_programs = 1 THEN
        SAFE_DIVIDE(
          AVG(CASE WHEN LOWER(TRIM(raw.exempt)) = 'no' THEN CAST(REPLACE(raw.voc_score_actual, '%', '') AS FLOAT64) ELSE NULL END), 
          AVG(CASE WHEN LOWER(TRIM(raw.exempt)) = 'no' THEN CAST(REPLACE(raw.voc_score_target_program, '%', '') AS FLOAT64) ELSE NULL END)
        )
      ELSE NULL END AS voc_single_program,

      SAFE_DIVIDE(
        AVG(CASE WHEN LOWER(TRIM(raw.exempt)) = 'no' THEN CAST(REPLACE(raw.voc_score_actual, '%', '') AS FLOAT64) ELSE NULL END), 
        AVG(CASE WHEN LOWER(TRIM(raw.exempt)) = 'no' THEN CAST(REPLACE(raw.voc_score_target_program, '%', '') AS FLOAT64) ELSE NULL END)
      ) AS _raw_calc
    FROM SrManagerBase AS raw
    LEFT JOIN SrProgramCounts AS pc 
      ON raw.wdid_manager = pc.wdid_manager AND raw.report_month = pc.report_month AND raw.report_year = pc.report_year
    GROUP BY 3,4,5,6,7,8,9,10, pc.final_total_programs
  ),

  -- 4. CTE: Capping for Senior Manager
  SrCappedData AS (
    SELECT * EXCEPT(_raw_calc),
      IF(voc_exempt = 'Yes', NULL,
        CASE WHEN final_total_programs >= 2 THEN
            CASE 
              WHEN _raw_calc <= 0.50 THEN 0
              WHEN _raw_calc > 0.50 AND _raw_calc <= 0.85 THEN 0.50
              WHEN _raw_calc > 0.85 AND _raw_calc <= 0.9599 THEN 0.75
              WHEN _raw_calc >= 0.96 AND _raw_calc <= 1.1499 THEN 1.00
              WHEN _raw_calc >= 1.15 THEN 1.15
              ELSE _raw_calc
            END
        ELSE NULL END) AS voc_multi_program,
      IF(voc_exempt = 'Yes', NULL,
        COALESCE(voc_single_program, 
                 CASE WHEN final_total_programs >= 2 THEN
                   CASE 
                     WHEN _raw_calc <= 0.50 THEN 0
                     WHEN _raw_calc > 0.50 AND _raw_calc <= 0.85 THEN 0.50
                     WHEN _raw_calc > 0.85 AND _raw_calc <= 0.9599 THEN 0.75
                     WHEN _raw_calc >= 0.96 AND _raw_calc <= 1.1499 THEN 1.00
                     WHEN _raw_calc >= 1.15 THEN 1.15
                     ELSE _raw_calc
                   END
                 ELSE NULL END)) AS voc_perf_vs_cap_uncapped
    FROM SrCalculatedData
  ),

  -- 5. CTE: Categories and Points for Senior Manager
  SrCategorizedAndPointsData AS (
    SELECT *,
      IF(voc_exempt = 'Yes', NULL,
        CASE 
          WHEN voc_perf_vs_cap_uncapped < 0.85 THEN 'Improvement Required'
          WHEN voc_perf_vs_cap_uncapped >= 0.85 AND voc_perf_vs_cap_uncapped <= 0.9499 THEN 'Developing'
          WHEN voc_perf_vs_cap_uncapped >= 0.95 AND voc_perf_vs_cap_uncapped <= 0.9599 THEN 'Achieving'
          WHEN voc_perf_vs_cap_uncapped >= 0.96 THEN 'Excelling'
          ELSE NULL 
        END) AS achievement_category,
      IF(voc_exempt = 'Yes', NULL,
        CASE 
          WHEN voc_perf_vs_cap_uncapped < 0.85 THEN 1
          WHEN voc_perf_vs_cap_uncapped >= 0.85 AND voc_perf_vs_cap_uncapped <= 0.9499 THEN 2
          WHEN voc_perf_vs_cap_uncapped >= 0.95 AND voc_perf_vs_cap_uncapped <= 0.9599 THEN 3
          WHEN voc_perf_vs_cap_uncapped >= 0.96 THEN 4
          ELSE NULL 
        END) AS voc_points_obtained
    FROM SrCappedData
  ),

  -- 6. Final Senior Manager CTE: Weights and Dilution
  SrManagerFinalData AS (
    SELECT 
      *,
      IF(voc_exempt = 'Yes', NULL, (voc_points_obtained * 0.25) * voc_weight) AS voc_weight_obtaiend,
      IF(voc_exempt = 'Yes', NULL, voc_points_obtained * voc_weight) AS voc_points_obtained_for_final_score_only,
      IF(voc_exempt = 'Yes', NULL,
        (CASE 
          WHEN achievement_category = 'Improvement Required' THEN voc_weight * 0.25
          WHEN achievement_category = 'Developing' THEN voc_weight * 0.50
          WHEN achievement_category = 'Achieving' THEN voc_weight * 0.75
          WHEN achievement_category = 'Excelling' THEN voc_weight * 1.00
          ELSE NULL 
        END) * SAFE_DIVIDE(1.0, final_total_programs)) AS voc_weight_obtaiend_program_diluted
    FROM 
      SrCategorizedAndPointsData
  )

  -- ==============================================================================================
  -- FINAL UNION
  -- ==============================================================================================
  SELECT * FROM ManagerFinalData
  UNION ALL
  SELECT * FROM SrManagerFinalData;

END;
