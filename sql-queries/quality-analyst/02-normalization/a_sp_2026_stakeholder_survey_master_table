CREATE OR REPLACE PROCEDURE `ti-ca-ml-start.QA_Training_scorecards.a_sp_2026_stakeholder_survey_master_table`()
BEGIN
  /************************************************************************************************
   PROCEDURE: Stakeholder Survey Master Table ETL
   DESCRIPTION: 
   1. Aggregates raw survey scores across multiple categories (Scope, Support, Alignment, etc.).
   2. Standardizes survey dates and calculates the Percentage to Goal (PTG).
   3. Categorizes performance and assigns points based on the calculated PTG.
  ************************************************************************************************/

  CREATE OR REPLACE TABLE `ti-ca-ml-start.QA_Training_scorecards.2026_stakeholder_survey_master_table` AS
  
  -- CTE 1: Base Calculation - Aggregate scores and counts from raw data
  WITH Calculos_Base AS (
    SELECT 
      Year,
      Survey_Date,
      Region,
      Country,
      Functional_Area,
      prgrmNcntry_TMC,
      prgrmNcntry_resp,
      Scope_scr,
      Alignment_scr,
      Support_scr,
      Execution_scr,
      Strategic_scr,
      Communication_scr,
      Culture_scr,
      Scope_count,
      Alignment_count,
      Support_count,
      Execution_count,
      Strategic_count,
      Communication_count,
      Culture_count,

      -- Intermediate Totals: Aggregates all specific survey category scores
      -- Uses SAFE_CAST and IFNULL to ensure mathematical operations don't fail on nulls/strings
      NULLIF((
        IFNULL(SAFE_CAST(Scope_scr AS FLOAT64), 0) + IFNULL(SAFE_CAST(Alignment_scr AS FLOAT64), 0) + 
        IFNULL(SAFE_CAST(Support_scr AS FLOAT64), 0) + IFNULL(SAFE_CAST(Execution_scr AS FLOAT64), 0) + 
        IFNULL(SAFE_CAST(Strategic_scr AS FLOAT64), 0) + IFNULL(SAFE_CAST(Communication_scr AS FLOAT64), 0) + 
        IFNULL(SAFE_CAST(Culture_scr AS FLOAT64), 0)
      ), 0) AS total_score,

      -- Intermediate Counts: Aggregates total number of responses across all categories
      -- NULLIF prevents division by zero in the next block
      NULLIF((
        IFNULL(SAFE_CAST(Scope_count AS FLOAT64), 0) + IFNULL(SAFE_CAST(Alignment_count AS FLOAT64), 0) + 
        IFNULL(SAFE_CAST(Support_count AS FLOAT64), 0) + IFNULL(SAFE_CAST(Execution_count AS FLOAT64), 0) + 
        IFNULL(SAFE_CAST(Strategic_count AS FLOAT64), 0) + IFNULL(SAFE_CAST(Communication_count AS FLOAT64), 0) + 
        IFNULL(SAFE_CAST(Culture_count AS FLOAT64), 0)
      ), 0) AS total_count

    FROM `ti-ca-ml-start.QA_Training_scorecards.2026_stakeholder_survey_raw`
    WHERE Survey_Date IS NOT NULL
  ),

  -- CTE 2: Final Scores - Standardize dates and calculate PTG (Percentage to Goal)
  Puntajes_Finales AS (
    SELECT
      *,
      -- 1. Date Standardization: Converts "Month Year" string into a standard Date format
      PARSE_DATE('%B %Y', Survey_Date) AS performance_date,
      
      -- 2. Business Metadata: Defining KPI identifiers and target
      'Stakeholder Surveys' AS kpi_name,
      'My Team' AS business_category,
      0.85 AS actual_target,
      
      -- 3. PTG Calculation: Scales the average score to a decimal percentage format (e.g., 0.85 = 85%)
      SAFE_DIVIDE(SAFE_DIVIDE(total_score, total_count) * 20, 100) AS stakeholder_survey_ptg,
      
      -- 4. Weight Placeholders: Reserved for future weighting logic
      CAST(NULL AS FLOAT64) AS metric_weight,
      CAST(NULL AS FLOAT64) AS weight_obtained
    FROM Calculos_Base
  )

  -- FINAL OUTPUT: Categorization and Point Assignment
  SELECT
    *,
    -- 5. Achievement Categorization: Buckets based on the PTG result
    CASE 
      WHEN stakeholder_survey_ptg IS NULL THEN NULL
      WHEN stakeholder_survey_ptg < 0.75 THEN 'Improvement Required'
      WHEN stakeholder_survey_ptg < 0.85 THEN 'Developing'
      WHEN stakeholder_survey_ptg < 0.86 THEN 'Achieving'
      ELSE 'Excelling'
    END AS sths_achievement_category,
    
    -- 6. Points Obtained: Translates PTG into a standard 1-4 scale
    CASE 
      WHEN stakeholder_survey_ptg IS NULL THEN NULL
      WHEN stakeholder_survey_ptg < 0.75 THEN 1
      WHEN stakeholder_survey_ptg < 0.85 THEN 2
      WHEN stakeholder_survey_ptg < 0.86 THEN 3
      ELSE 4
    END AS sths_points_obtained,

    -- 7. Final Score Placeholder: Initialized for future consolidated score calculation
    CAST(NULL AS FLOAT64) AS sths_points_final_score

  FROM Puntajes_Finales;
END;
