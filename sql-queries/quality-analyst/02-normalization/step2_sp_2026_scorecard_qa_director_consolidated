CREATE OR REPLACE PROCEDURE `ti-ca-ml-start.QA_Training_scorecards.step2_sp_2026_scorecard_qa_director_consolidated`()
BEGIN

  CREATE OR REPLACE TABLE `ti-ca-ml-start.QA_Training_scorecards.2026_scorecard_qa_director_consolidated` AS
  
  -- 1. CTE: String cleaning and actual dynamic calculation of sei_ptg_decimal
  WITH Raw_Data AS (
    SELECT 
      *,
      SAFE_DIVIDE(
        SAFE_CAST(REPLACE(CAST(sei_score AS STRING), '%', '') AS FLOAT64),
        SAFE_CAST(REPLACE(CAST(sei_target AS STRING), '%', '') AS FLOAT64)
      ) AS sei_ptg_decimal
    FROM `ti-ca-ml-start.QA_Training_scorecards.2026_qadirectors_raw`
    -- ROOT PROTECTION: Filters nulls, empties, and garbage text before any calculations
    WHERE director_wdid IS NOT NULL 
      AND TRIM(CAST(director_wdid AS STRING)) NOT IN ('', '-', 'NULL')
  ),
  
  -- 2. CTE: Assignment of categories and fixed points based on the actual sei_ptg_decimal
  Calculos_Metricas AS (
    SELECT
      *,
      'Service Excellence Index' AS sei_kpi_fixed,
      'My Customer' AS sei_business_category_fixed,
      0.25 AS sei_weight_fixed,
      CASE 
        WHEN sei_ptg_decimal < 0.90 THEN 'Improvement Required'
        WHEN sei_ptg_decimal < 1.00 THEN 'Developing'
        WHEN sei_ptg_decimal < 1.01 THEN 'Achieving'
        ELSE 'Excelling'
      END AS sei_achievement_category_calc,
      CASE 
        WHEN sei_ptg_decimal < 0.90 THEN 1
        WHEN sei_ptg_decimal < 1.00 THEN 2
        WHEN sei_ptg_decimal < 1.01 THEN 3
        ELSE 4
      END AS sei_points_obtained_calc
    FROM Raw_Data
  ),

  /* --- CTE 3: BASE SCORECARD WITH CLEAN IDENTITY KEY & UNIFIED 3-LETTER MONTH --- */
  Base_Scorecard AS (
    SELECT 
      pk,
      timestamp,
      submitter_email,
      UPPER(TRIM(SUBSTR(CAST(report_month AS STRING), 1, 3))) AS report_month, -- Definitive 3-Letter Upper Standard
      report_year,
      region,
      role,
      -- SAFE FIX: Treats IDs as strings and removes trailing '.0' from Excel exports, keeping 'CW' letters intact
      REGEXP_REPLACE(TRIM(CAST(director_wdid AS STRING)), r'\.0$', '') AS director_wdid, 
      director_name,
      sei_kpi_fixed AS sei_kpi,
      sei_business_category_fixed AS sei_business_category,
      sei_weight_fixed AS sei_weight,
      sei_score,
      sei_target,
      FORMAT('%.2f%%', sei_ptg_decimal * 100) AS sei_ptg, 
      sei_achievement_category_calc AS sei_achievement_category,
      sei_points_obtained_calc AS sei_points_obtained,
      (CAST(sei_points_obtained_calc AS FLOAT64) / 4) * 0.25 AS sei_weight_obtained,
      CAST(sei_points_obtained_calc AS FLOAT64) * 0.25 AS sei_points_final_score
    FROM Calculos_Metricas
  ),

  /* --- NEW BLOCK: CASCADE LEADERSHIP DATA INTEGRATION (UNIFIED MONTH) --- */
  leadership_director_agg AS (
    SELECT 
      -- SAFE FIX: Treats IDs as strings and removes trailing '.0'
      REGEXP_REPLACE(TRIM(CAST(Employee_ID AS STRING)), r'\.0$', '') AS wdid,
      UPPER(TRIM(SUBSTR(CAST(report_month AS STRING), 1, 3))) AS month, -- Definitive 3-Letter Upper Standard
      SAFE_CAST(report_year AS STRING) AS year,
      SAFE_CAST(leadership_ptg AS FLOAT64) AS leadership_ptg
    FROM `ti-ca-ml-start.QA_Training_scorecards.global_qa_roster_with_scores` 
    WHERE Employee_ID IS NOT NULL
  ),

  /* --- CTE 4: MACRO POTP PRE-AGGREGATION (UNIFIED MONTH) --- */
  potp_director_agg AS (
    SELECT 
      -- SAFE FIX: Treats IDs as strings and removes trailing '.0'
      REGEXP_REPLACE(TRIM(CAST(inmediate_supervisor_id AS STRING)), r'\.0$', '') AS wdid, 
      UPPER(TRIM(SUBSTR(CAST(month AS STRING), 1, 3))) as month, -- Definitive 3-Letter Upper Standard
      SAFE_CAST(year AS STRING) as year, 
      SUM(count_top_performers) as count_top_performers,
      SUM(count_total) as count_total,
      MAX(target_master) as target_master,
      SAFE_DIVIDE(SUM(count_top_performers), SUM(count_total)) as potp_ptg
    FROM `ti-ca-ml-start.QA_Training_scorecards.2026_potp_all_roles_etl_output`
    WHERE inmediate_supervisor_id IS NOT NULL 
      AND TRIM(CAST(inmediate_supervisor_id AS STRING)) NOT IN ('', '-', 'NULL')
    GROUP BY 1, 2, 3 
  ),

  /* --- CTE 5: SAFE HORIZONTAL COUPLING AND DAPT LOGIC --- */
  DAPT_Calculations AS (
    SELECT
      b.*,
      
      -- ==========================================
      -- METADATA AND PILLAR LOGIC: CASCADE LEADERSHIP
      -- ==========================================
      CAST('My Team' AS STRING) AS yearly_evals_business_category,
      CAST('Yearly Evaluations (% to goal)' AS STRING) AS yearly_evals_kpi,
      1.00 AS yearly_evals_target_master,
      0.20 AS yearly_evals_weight_master, 
      CASE WHEN b.report_month = 'JUN' THEN l.leadership_ptg ELSE NULL END AS yearly_evals_ptg,
      CAST(CASE WHEN b.report_month = 'JUN' AND l.leadership_ptg IS NOT NULL THEN 'Yes' ELSE 'No' END AS STRING) AS yearly_evals_kpi_applicable,
      
      CASE 
        WHEN b.report_month != 'JUN' THEN NULL
        WHEN l.leadership_ptg IS NULL THEN NULL
        WHEN l.leadership_ptg < 0.90 THEN 'Improvement Required'
        WHEN l.leadership_ptg < 1.00 THEN 'Developing'
        WHEN l.leadership_ptg < 1.01 THEN 'Achieving'
        ELSE 'Excelling'
      END AS yearly_evals_achievement_category,

      CASE 
        WHEN b.report_month != 'JUN' THEN NULL
        WHEN l.leadership_ptg IS NULL THEN NULL
        WHEN l.leadership_ptg < 0.90 THEN 1
        WHEN l.leadership_ptg < 1.00 THEN 2
        WHEN l.leadership_ptg < 1.01 THEN 3
        ELSE 4
      END AS yearly_evals_metric_points,

      CASE 
        WHEN b.report_month != 'JUN' THEN NULL
        WHEN l.leadership_ptg IS NULL THEN NULL
        WHEN l.leadership_ptg < 0.90 THEN 0.25
        WHEN l.leadership_ptg < 1.00 THEN 0.50
        WHEN l.leadership_ptg < 1.01 THEN 0.75
        ELSE 1.00
      END * 0.20 AS yearly_evals_weight_earned,

      CASE 
        WHEN b.report_month != 'JUN' THEN NULL
        WHEN l.leadership_ptg IS NULL THEN NULL
        WHEN l.leadership_ptg < 0.90 THEN 1
        WHEN l.leadership_ptg < 1.00 THEN 2
        WHEN l.leadership_ptg < 1.01 THEN 3
        ELSE 4
      END * 0.20 AS yearly_evals_points_final_score,
      
      -- ==========================================
      -- METADATA AND PILLAR LOGIC: POTP (UNTOUCHED)
      -- ==========================================
      CAST('My Team' AS STRING) AS potp_business_category,
      CAST('% of Top Performers' AS STRING) AS potp_kpi,
      p.count_top_performers AS potp_count_top_performers,
      p.count_total AS potp_count_total,
      CAST(CASE WHEN p.count_total IS NULL OR p.count_total = 0 THEN 'No' ELSE 'Yes' END AS STRING) AS potp_kpi_applicable,
      CAST('No' AS STRING) AS potp_exempt,
      CAST(NULL AS STRING) AS potp_reason,
      0.20 AS potp_weight, 
      p.target_master AS potp_target,
      p.potp_ptg AS potp_ptg,
      
      CASE 
        WHEN p.count_total IS NULL OR p.count_total = 0 THEN NULL
        WHEN p.potp_ptg < 0.75 THEN 'Improvement Required'
        WHEN p.potp_ptg < 0.90 THEN 'Developing'
        WHEN p.potp_ptg < 0.95 THEN 'Achieving'
        ELSE 'Excelling'
      END AS potp_achievement_tier,

      CASE 
        WHEN p.count_total IS NULL OR p.count_total = 0 THEN NULL
        WHEN p.potp_ptg < 0.75 THEN 1
        WHEN p.potp_ptg < 0.90 THEN 2
        WHEN p.potp_ptg < 0.95 THEN 3
        ELSE 4
      END AS potp_points_obtained,

      CASE 
        WHEN p.count_total IS NULL OR p.count_total = 0 THEN NULL
        WHEN p.potp_ptg < 0.75 THEN 0.25
        WHEN p.potp_ptg < 0.90 THEN 0.50
        WHEN p.potp_ptg < 0.95 THEN 0.75
        ELSE 1.00
      END * 0.20 AS potp_weight_obtained,

      CASE 
        WHEN p.count_total IS NULL OR p.count_total = 0 THEN NULL
        WHEN p.potp_ptg < 0.75 THEN 1
        WHEN p.potp_ptg < 0.90 THEN 2
        WHEN p.potp_ptg < 0.95 THEN 3
        ELSE 4
      END * 0.20 AS potp_points_for_final_score,

      -- Standardized metadata pillars for Step 3 Unpivot
      CAST('All' AS STRING) AS final_score_business_category,
      CAST('Final Score' AS STRING) AS final_score_kpi,

      -- DYNAMIC SUMMATIVE DAPT CALCULATION (YETG dynamically evaluates to 0 points outside of June)
      (
        COALESCE(b.sei_points_final_score, 0) +
        COALESCE(CASE 
          WHEN b.report_month != 'JUN' THEN NULL
          WHEN l.leadership_ptg IS NULL THEN NULL
          WHEN l.leadership_ptg < 0.90 THEN 1
          WHEN l.leadership_ptg < 1.00 THEN 2
          WHEN l.leadership_ptg < 1.01 THEN 3
          ELSE 4
        END * 0.20, 0) +
        COALESCE(CASE 
          WHEN p.count_total IS NULL OR p.count_total = 0 THEN NULL
          WHEN p.potp_ptg < 0.75 THEN 1
          WHEN p.potp_ptg < 0.90 THEN 2
          WHEN p.potp_ptg < 0.95 THEN 3
          ELSE 4
        END * 0.20, 0)
      ) AS final_score_points_obtained,

      -- DYNAMIC DAPT CEILING BY APPLICABILITY (YETG drops its 0.20 weight to 0 outside of June)
      (
        COALESCE(b.sei_weight, 0) * 4 +
        COALESCE(CASE WHEN b.report_month != 'JUN' OR l.leadership_ptg IS NULL THEN 0 ELSE 0.20 END * 4, 0) +
        COALESCE(CASE WHEN p.count_total IS NULL OR p.count_total = 0 THEN 0 ELSE 0.20 END * 4, 0)
      ) AS max_final_score_points_available

    FROM Base_Scorecard b
    
    -- LEFT JOIN 1: Connection to the new Leadership table under the strict triad (ID, Month, Year)
    LEFT JOIN leadership_director_agg l
      ON b.director_wdid = l.wdid
     AND b.report_month = l.month
     AND SAFE_CAST(b.report_year AS STRING) = l.year

    -- LEFT JOIN 2: Connection to POTP under the same triad
    LEFT JOIN potp_director_agg p
      ON b.director_wdid = p.wdid
     AND b.report_month = p.month
     AND SAFE_CAST(b.report_year AS STRING) = p.year
  )

  /* --- FINAL SELECTION: RATIOS AND MAPPING TO TIERS --- */
  SELECT 
    *,
    SAFE_DIVIDE(final_score_points_obtained, max_final_score_points_available) AS final_score_ptg,
    
    CASE 
      WHEN SAFE_DIVIDE(final_score_points_obtained, max_final_score_points_available) IS NULL THEN NULL
      WHEN SAFE_DIVIDE(final_score_points_obtained, max_final_score_points_available) >= 0.87 THEN 'Excelling'
      WHEN SAFE_DIVIDE(final_score_points_obtained, max_final_score_points_available) >= 0.75 THEN 'Achieving'
      WHEN SAFE_DIVIDE(final_score_points_obtained, max_final_score_points_available) >= 0.50 THEN 'Developing'
      ELSE 'Improvement Required'
    END AS final_score_tier
  FROM DAPT_Calculations;

END;
