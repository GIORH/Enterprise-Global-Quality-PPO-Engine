CREATE OR REPLACE PROCEDURE `ti-ca-ml-start.QA_Training_scorecards.step0_sp_2026_lead_trustandsafety_productivity_ETL`()
BEGIN

  CREATE OR REPLACE TABLE `ti-ca-ml-start.QA_Training_scorecards.step0_sp_2026_lead_trustandsafety_productivity_ETL` AS

 WITH Productivity_Source AS (
  SELECT 
    LOWER(TRIM(pk)) AS pk_normalized, 
    timestamp,
    SAFE.PARSE_DATE('%d %B %Y', CONCAT('01 ', TRIM(report_month), ' ', CAST(report_year AS STRING))) AS date,
    report_month, 
    report_year, 
    tl_wdid, 
    tl_name, 
    tl_manager, 
    tl_sr_manager, 
    program, 
    country, 
    region,
    SAFE_CAST(qa_count AS FLOAT64) AS qa_count, 
    SAFE_CAST(ts_calibrations_completed AS FLOAT64) AS ts_calibrations_completed,
    SAFE_CAST(ts_calibrations_required AS FLOAT64) AS ts_calibrations_required, 
    SAFE_CAST(ts_evals_completed AS FLOAT64) AS ts_evals_completed,
    SAFE_CAST(ts_evals_target AS FLOAT64) AS ts_evals_target, 
    qa_evals_na, 
    ts_exempt, 
    CAST(ts_exemption_reason AS STRING) AS ts_exemption_reason, 
    notes
  FROM `ti-ca-ml-start.QA_Training_scorecards.2026_ts_qatl_productivity_raw`
),

  TL_Productivity_PTG AS (
    SELECT
      *,
      'My Business' AS productivity_business_category, 
      'Productivity' AS productivity_kpi, 
      CASE 
        WHEN UPPER(TRIM(ts_exempt)) = 'YES' THEN NULL 
        ELSE 0.10 
      END AS productivity_weight_master,
      1.00 AS productivity_target_master,
      
      -- Porcentaje para Calibraciones con control de exención
      CASE 
        WHEN UPPER(TRIM(ts_exempt)) = 'YES' THEN NULL 
        ELSE SAFE_DIVIDE(ts_calibrations_completed, ts_calibrations_required) 
      END AS calibrations_ptg,
      
      -- Porcentaje para Evaluaciones con control de metas en cero
      CASE 
        WHEN ts_evals_completed = 0 AND ts_evals_target = 0 THEN NULL 
        ELSE SAFE_DIVIDE(ts_evals_completed, ts_evals_target) 
      END AS evaluations_ptg
    FROM Productivity_Source
  ),

  TL_Productivity_Final AS (
    SELECT
      *,
      -- Cálculo promedio dinámico libre de dilución
      CASE 
        WHEN calibrations_ptg IS NULL AND evaluations_ptg IS NULL THEN NULL
        ELSE SAFE_DIVIDE(
          IFNULL(calibrations_ptg, 0) + IFNULL(evaluations_ptg, 0), 
          (CASE WHEN calibrations_ptg IS NOT NULL THEN 1 ELSE 0 END + CASE WHEN evaluations_ptg IS NOT NULL THEN 1 ELSE 0 END)
        ) 
      END AS productivity_ptg
    FROM TL_Productivity_PTG
  ),

  TL_Productivity_Scores AS (
    SELECT
      *,
      -- Asignación de Tiers basada en el porcentaje total de productividad obtenido
      CASE 
        WHEN productivity_ptg IS NULL THEN NULL 
        WHEN productivity_ptg < 0.90 THEN 'Improvement Required' 
        WHEN productivity_ptg >= 0.90 AND productivity_ptg <= 0.9999 THEN 'Developing' 
        WHEN productivity_ptg >= 1.00 THEN 'Achieving' 
        ELSE NULL 
      END AS productivity_achievement_tier,
      
      -- Puntos de matriz obtenidos (Productividad se evalúa sobre base 3)
      CASE 
        WHEN productivity_ptg IS NULL THEN NULL 
        WHEN productivity_ptg < 0.90 THEN 1 
        WHEN productivity_ptg >= 0.90 AND productivity_ptg <= 0.9999 THEN 2 
        WHEN productivity_ptg >= 1.00 THEN 3 
        ELSE 0 
      END AS productivity_points_obtained
    FROM TL_Productivity_Final
  ),

  TL_Productivity_Block AS (
    SELECT
      *,
      -- Obtención de peso ganado y puntaje ponderado final
      CASE 
        WHEN productivity_points_obtained IS NULL THEN NULL 
        ELSE (productivity_points_obtained / 3) * productivity_weight_master 
      END AS productivity_weight_earned,
      CASE 
        WHEN productivity_points_obtained IS NULL THEN NULL 
        ELSE productivity_points_obtained * productivity_weight_master 
      END AS productivity_points_final_score
    FROM TL_Productivity_Scores
  )

SELECT 
  -- Metadata & Dimensions Base
  timestamp,
  date,
  report_month,
  report_year,
  tl_wdid,
  tl_name,
  tl_manager,
  tl_sr_manager,
  program,
  country,
  region,

  -- Isolated Productivity Metrics
  productivity_business_category,
  productivity_kpi,
  qa_count,
  ts_calibrations_completed,
  ts_calibrations_required,
  ts_evals_completed,
  ts_evals_target,
  calibrations_ptg,
  evaluations_ptg,
  productivity_weight_master,
  productivity_target_master,
  productivity_ptg,
  qa_evals_na,
  ts_exempt,
  ts_exemption_reason,
  notes,
  productivity_achievement_tier,
  productivity_points_obtained,
  productivity_weight_earned,
  productivity_points_final_score

FROM TL_Productivity_Block;

END;
