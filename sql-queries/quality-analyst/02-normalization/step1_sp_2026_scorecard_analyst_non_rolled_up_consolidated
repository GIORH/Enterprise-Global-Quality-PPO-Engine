CREATE OR REPLACE PROCEDURE `ti-ca-ml-start.QA_Training_scorecards.step1_sp_2026_scorecard_analyst_non_rolled_up_consolidated`()
BEGIN

  /************************************************************************************************
   PROCEDURE: Individual Metrics - Rolled Up Version (Sum aggregation by TM/Month/Year)
   DESCRIPTION: 
   1. Aggregates numerators and denominators for PPD and Team Dev by TM, month, and year.
   2. Recalculates PTG, Achievement Categories, and Points based on rolled-up totals.
   3. Ensures a single row per analyst per month across all metrics.
   ************************************************************************************************/

  CREATE OR REPLACE TABLE `ti-ca-ml-start.QA_Training_scorecards.2026_analyst_non_rolled_up_consolidate` AS
  
  -- BLOCK 1: DIMENSION COLLECTION (SKELETON)
  WITH Raw_Dimensions AS (
      SELECT tm_wdid, report_month, report_year, timestamp, submitter_email, tl_wdid, tl_name, tl_manager, tl_sr_manager, tm_name, country, region
      FROM `ti-ca-ml-start.QA_Training_scorecards.2026_qa_team_dev_raw`
      UNION ALL
      SELECT tm_wdid, report_month, report_year, timestamp, submitter_email, tl_wdid, tl_name, tl_manager, tl_sr_manager, tm_name, country, region
      FROM `ti-ca-ml-start.QA_Training_scorecards.2026_qa_ppd_raw`
  ),

  Final_Skeleton AS (
    SELECT 
      CONCAT(SAFE_CAST(tm_wdid AS STRING), '|', SAFE_CAST(report_month AS STRING), '|', SAFE_CAST(report_year AS STRING)) as key,
      'CX Quality Analyst' as role,
      MAX(COALESCE(
        SAFE.FORMAT_TIMESTAMP('%m/%d/%Y', SAFE_CAST(timestamp AS TIMESTAMP)),
        SAFE.FORMAT_DATE('%m/%d/%Y', SAFE.PARSE_DATE('%m/%d/%Y', REGEXP_EXTRACT(timestamp, r'\d{1,2}/\d{1,2}/\d{4}'))),
        timestamp 
      )) as timestamp,
      MAX(submitter_email) as submitter_email,
      SAFE_CAST(report_month AS STRING) as report_month,
      SAFE_CAST(report_year AS STRING) as report_year,
      MAX(tl_wdid) as tl_wdid, MAX(tl_name) as tl_name, MAX(tl_manager) as tl_manager, MAX(tl_sr_manager) as tl_sr_manager,
      SAFE_CAST(tm_wdid AS STRING) as tm_wdid, MAX(tm_name) as tm_name, MAX(country) as country, MAX(region) as region
    FROM Raw_Dimensions
    GROUP BY tm_wdid, report_month, report_year
  ),

  -- BLOCK 2: ROLLED UP PPD CALCULATION
  PPD_Rolled_Up AS (
    SELECT 
      CONCAT(SAFE_CAST(tm_wdid AS STRING), '|', SAFE_CAST(report_month AS STRING), '|', SAFE_CAST(report_year AS STRING)) as key,
      'My Team' as ppd_business_category,
      'PPD' as ppd_kpi,
      SUM(SAFE_CAST(courses_completed AS FLOAT64)) as ppd_courses_completed,
      SUM(SAFE_CAST(courses_required AS FLOAT64)) as ppd_courses_required,
      -- Columnas de soporte identificadas en origen
      MAX(kpi_applicable) as ppd_kpi_applicable,
      MAX(exempt) as ppd_exempt,
      MAX(reason) as ppd_reason,
      -- Peso master con lógica de excepción
      IF(UPPER(TRIM(MAX(kpi_applicable))) = 'NO' OR UPPER(TRIM(MAX(exempt))) = 'YES', NULL, 0.15) as ppd_weight,
      1.00 as ppd_target
    FROM `ti-ca-ml-start.QA_Training_scorecards.2026_qa_ppd_raw`
    GROUP BY tm_wdid, report_month, report_year
  ),

  PPD_Calculated AS (
    SELECT 
      *,
      SAFE_DIVIDE(ppd_courses_completed, ppd_courses_required) as ppd_ptg
    FROM PPD_Rolled_Up
  ),

  PPD_Final AS (
    SELECT 
      *,
      CASE 
        WHEN ppd_ptg IS NULL THEN NULL
        WHEN ppd_ptg < 0.40 THEN 'Improvement Required'
        WHEN ppd_ptg BETWEEN 0.40 AND 0.85 THEN 'Developing'
        WHEN ppd_ptg BETWEEN 0.8501 AND 1.00 THEN 'Achieving'
        WHEN ppd_ptg >= 1.0001 THEN 'Excelling'
      END as ppd_achievement_category,
      CASE 
        WHEN ppd_ptg IS NULL THEN NULL
        WHEN ppd_ptg < 0.40 THEN 1
        WHEN ppd_ptg BETWEEN 0.40 AND 0.85 THEN 2
        WHEN ppd_ptg BETWEEN 0.8501 AND 1.00 THEN 3
        WHEN ppd_ptg >= 1.0001 THEN 4
      END as ppd_points_obtained
    FROM PPD_Calculated
  ),

  -- BLOCK 3: ROLLED UP TEAM DEVELOPMENT CALCULATION
  TD_Rolled_Up AS (
    SELECT 
      CONCAT(SAFE_CAST(tm_wdid AS STRING), '|', SAFE_CAST(report_month AS STRING), '|', SAFE_CAST(report_year AS STRING)) as key,
      'My Team' as td_business_category,
      'Team Development' as td_kpi,
      SUM(SAFE_CAST(workshops_delivered AS FLOAT64)) as td_workshops_delivered,
      12.0 as td_workshops_required,
      -- Columnas de soporte identificadas en origen
      MAX(kpi_applicable) as td_kpi_applicable,
      MAX(exempt) as td_exempt,
      MAX(reason) as td_reason,
      -- Peso master con lógica de excepción
      IF(UPPER(TRIM(MAX(kpi_applicable))) = 'NO' OR UPPER(TRIM(MAX(exempt))) = 'YES', NULL, 0.15) as td_weight,
      1.00 as td_target
    FROM `ti-ca-ml-start.QA_Training_scorecards.2026_qa_team_dev_raw`
    GROUP BY tm_wdid, report_month, report_year
  ),

  TD_Calculated AS (
    SELECT 
      *,
      SAFE_DIVIDE(td_workshops_delivered, 12.0) as td_ptg
    FROM TD_Rolled_Up
  ),

  TD_Final AS (
    SELECT 
      *,
      CASE 
        WHEN td_ptg IS NULL THEN NULL
        WHEN td_ptg < (9.0/12.0) THEN 'Improvement Required'
        WHEN td_ptg BETWEEN (9.0/12.0) AND (11.0/12.0) THEN 'Developing'
        WHEN td_ptg = 1.0 THEN 'Achieving'
        WHEN td_ptg > 1.0 THEN 'Excelling'
      END as td_achievement_category,
      CASE 
        WHEN td_ptg IS NULL THEN NULL
        WHEN td_ptg < (9.0/12.0) THEN 1
        WHEN td_ptg BETWEEN (9.0/12.0) AND (11.0/12.0) THEN 2
        WHEN td_ptg = 1.0 THEN 3
        WHEN td_ptg > 1.0 THEN 4
      END as td_points_obtained
    FROM TD_Calculated
  )

  -- BLOCK 4: FINAL ASSEMBLY AND WEIGHT RECALCULATION
  SELECT 
    s.*,
    -- PPD Outputs
    p.ppd_business_category, p.ppd_kpi, p.ppd_courses_completed, p.ppd_courses_required, 
    p.ppd_kpi_applicable, p.ppd_exempt, p.ppd_reason, -- Columnas agregadas
    p.ppd_weight, p.ppd_target, p.ppd_ptg, 
    p.ppd_achievement_category, p.ppd_points_obtained,
    IF(p.ppd_points_obtained IS NOT NULL, (p.ppd_weight * (p.ppd_points_obtained / 4.0)), NULL) as ppd_weight_obtaiend,
    IF(p.ppd_points_obtained IS NOT NULL, (p.ppd_weight * p.ppd_points_obtained), NULL) as ppd_points_obtained_for_final_score_only,
    -- TD Outputs
    t.td_business_category, t.td_kpi, t.td_workshops_delivered, t.td_workshops_required, 
    t.td_kpi_applicable, t.td_exempt, t.td_reason, -- Columnas agregadas
    t.td_weight, t.td_target, t.td_ptg, 
    t.td_achievement_category, t.td_points_obtained,
    IF(t.td_points_obtained IS NOT NULL, (t.td_weight * (t.td_points_obtained / 4.0)), NULL) as td_weight_obtaiend,
    IF(t.td_points_obtained IS NOT NULL, (t.td_weight * t.td_points_obtained), NULL) as td_points_obtained_for_final_score_only
  FROM Final_Skeleton s
  LEFT JOIN PPD_Final p ON s.key = p.key
  LEFT JOIN TD_Final t ON s.key = t.key;

END;
