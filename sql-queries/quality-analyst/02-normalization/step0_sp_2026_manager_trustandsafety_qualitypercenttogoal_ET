CREATE OR REPLACE PROCEDURE `ti-ca-ml-start.QA_Training_scorecards.step0_sp_2026_manager_trustandsafety_qualitypercenttogoal_ETL`()
BEGIN

  /************************************************************************************************
   PROCEDURE: Trust & Safety Manager & Sr Manager - Quality % to Goal Rolled-up (Weight 20%)
  ************************************************************************************************/

  CREATE OR REPLACE TABLE `ti-ca-ml-start.QA_Training_scorecards.step0_sp_2026_manager_trustandsafety_qualitypercenttogoal_ETL` AS

  -- ==============================================================================================
  -- BRANCH 1: MANAGER (100% INTACT ORIGINAL LOGIC)
  -- ==============================================================================================
  WITH Manager_Quality_Source AS (
    SELECT
      MAX(timestamp) AS timestamp,
      SAFE.PARSE_DATE('%d %B %Y', CONCAT('01 ', TRIM(report_month), ' ', CAST(report_year AS STRING))) AS date,
      report_month,
      report_year,
      tl_manager,
      tl_sr_manager,
      program,
      country,
      region,
      
      -- Protection against mixed populations: ignore exempt or non-applicable individual analysts
      AVG(CASE WHEN UPPER(TRIM(qa_kpi_applicable)) = 'NO' OR UPPER(TRIM(qa_exempt)) = 'YES' THEN NULL ELSE SAFE_CAST(quality_score_actual AS FLOAT64) END) AS quality_score_actual,
      AVG(CASE WHEN UPPER(TRIM(qa_kpi_applicable)) = 'NO' OR UPPER(TRIM(qa_exempt)) = 'YES' THEN NULL ELSE SAFE_CAST(quality_score_target_program AS FLOAT64) END) AS quality_score_target_program,
      
      -- Conditional flags: Manager exempt only if 100% of team is exempt
      IF(COUNTIF(UPPER(TRIM(qa_kpi_applicable)) = 'NO') = COUNT(*), 'No', 'Yes') AS qa_kpi_applicable,
      IF(COUNTIF(UPPER(TRIM(qa_exempt)) = 'YES') = COUNT(*), 'Yes', 'No') AS qa_exempt,
      IF(COUNTIF(UPPER(TRIM(qa_exempt)) = 'YES') = COUNT(*), 'Whole roll-up team exempt', NULL) AS quality_notes,
      IF(COUNTIF(UPPER(TRIM(qa_exempt)) = 'YES') = COUNT(*), MAX(qa_reason), NULL) AS qa_reason
    FROM `ti-ca-ml-start.QA_Training_scorecards.2026_ts_qa_consolidated_kpis_raw`
    GROUP BY report_month, report_year, tl_manager, tl_sr_manager, program, country, region
  ),

  Manager_Quality_PTG AS (
    SELECT
      *,
      'My Customer' AS qaptg_business_category,
      'Quality % to Goal' AS qa_kpi,
      
      -- Master weight inherits clean exemption from previous block
      CASE 
        WHEN UPPER(TRIM(qa_kpi_applicable)) = 'NO' OR UPPER(TRIM(qa_exempt)) = 'YES' THEN NULL 
        ELSE 0.20 
      END AS quality_weight_master,
      
      -- Final percentage to goal (PTG) calculation for quality
      CASE 
        WHEN UPPER(TRIM(qa_kpi_applicable)) = 'NO' OR UPPER(TRIM(qa_exempt)) = 'YES' THEN NULL 
        ELSE SAFE_DIVIDE(quality_score_actual, quality_score_target_program) 
      END AS quality_ptg
    FROM Manager_Quality_Source
  ),

  Manager_Quality_Scores AS (
    SELECT
      *,
      -- Achievement tier classification based on official thresholds
      CASE 
        WHEN quality_ptg IS NULL THEN NULL 
        WHEN quality_ptg < 0.90 THEN 'Improvement Required' 
        WHEN quality_ptg >= 0.90 AND quality_ptg <= 0.9999 THEN 'Developing' 
        WHEN quality_ptg >= 1.00 AND quality_ptg <= 1.0099 THEN 'Achieving' 
        WHEN quality_ptg >= 1.01 THEN 'Excelling' 
        ELSE NULL 
      END AS quality_achievement_tier,
      
      -- Matrix points obtained
      CASE 
        WHEN quality_ptg IS NULL THEN NULL 
        WHEN quality_ptg < 0.90 THEN 1 
        WHEN quality_ptg >= 0.90 AND quality_ptg <= 0.9999 THEN 2 
        WHEN quality_ptg >= 1.00 AND quality_ptg <= 1.0099 THEN 3 
        WHEN quality_ptg >= 1.01 THEN 4 
        ELSE 0 
      END AS quality_points_obtained
    FROM Manager_Quality_PTG
  ),

  Manager_Quality_Final_Block AS (
    SELECT
      timestamp,
      date,
      report_month,
      report_year,
      tl_manager,
      tl_sr_manager,
      program,
      country,
      region,
      qaptg_business_category,
      qa_kpi,
      quality_score_actual,
      quality_score_target_program,
      quality_weight_master,
      quality_ptg,
      quality_achievement_tier,
      quality_points_obtained,
      CASE WHEN quality_points_obtained IS NULL THEN NULL ELSE (quality_points_obtained / 4) * quality_weight_master END AS quality_weight_obtained,
      CASE WHEN quality_points_obtained IS NULL THEN NULL ELSE quality_points_obtained * quality_weight_master END AS quality_points_final_score,
      quality_notes,
      qa_kpi_applicable,
      qa_exempt,
      qa_reason
    FROM Manager_Quality_Scores
  ),

  -- ==============================================================================================
  -- BRANCH 2: SENIOR MANAGER (RE-MAPPED MIRROR LOGIC FROM RAW SOURCE)
  -- ==============================================================================================
  SrManager_Quality_Source AS (
    SELECT
      MAX(timestamp) AS timestamp,
      SAFE.PARSE_DATE('%d %B %Y', CONCAT('01 ', TRIM(report_month), ' ', CAST(report_year AS STRING))) AS date,
      report_month,
      report_year,
      tl_sr_manager AS tl_manager, -- Re-mapping Senior Manager to tl_manager
      program,
      country,
      region,
      
      AVG(CASE WHEN UPPER(TRIM(qa_kpi_applicable)) = 'NO' OR UPPER(TRIM(qa_exempt)) = 'YES' THEN NULL ELSE SAFE_CAST(quality_score_actual AS FLOAT64) END) AS quality_score_actual,
      AVG(CASE WHEN UPPER(TRIM(qa_kpi_applicable)) = 'NO' OR UPPER(TRIM(qa_exempt)) = 'YES' THEN NULL ELSE SAFE_CAST(quality_score_target_program AS FLOAT64) END) AS quality_score_target_program,
      
      IF(COUNTIF(UPPER(TRIM(qa_kpi_applicable)) = 'NO') = COUNT(*), 'No', 'Yes') AS qa_kpi_applicable,
      IF(COUNTIF(UPPER(TRIM(qa_exempt)) = 'YES') = COUNT(*), 'Yes', 'No') AS qa_exempt,
      IF(COUNTIF(UPPER(TRIM(qa_exempt)) = 'YES') = COUNT(*), 'Whole roll-up team exempt', NULL) AS quality_notes,
      IF(COUNTIF(UPPER(TRIM(qa_exempt)) = 'YES') = COUNT(*), MAX(qa_reason), NULL) AS qa_reason
    FROM `ti-ca-ml-start.QA_Training_scorecards.2026_ts_qa_consolidated_kpis_raw`
    WHERE tl_sr_manager IS NOT NULL AND TRIM(tl_sr_manager) != ''
    GROUP BY report_month, report_year, tl_sr_manager, program, country, region
  ),

  SrManager_Quality_PTG AS (
    SELECT
      *,
      'My Customer' AS qaptg_business_category,
      'Quality % to Goal' AS qa_kpi,
      
      CASE 
        WHEN UPPER(TRIM(qa_kpi_applicable)) = 'NO' OR UPPER(TRIM(qa_exempt)) = 'YES' THEN NULL 
        ELSE 0.20 
      END AS quality_weight_master,
      
      CASE 
        WHEN UPPER(TRIM(qa_kpi_applicable)) = 'NO' OR UPPER(TRIM(qa_exempt)) = 'YES' THEN NULL 
        ELSE SAFE_DIVIDE(quality_score_actual, quality_score_target_program) 
      END AS quality_ptg
    FROM SrManager_Quality_Source
  ),

  SrManager_Quality_Scores AS (
    SELECT
      *,
      CASE 
        WHEN quality_ptg IS NULL THEN NULL 
        WHEN quality_ptg < 0.90 THEN 'Improvement Required' 
        WHEN quality_ptg >= 0.90 AND quality_ptg <= 0.9999 THEN 'Developing' 
        WHEN quality_ptg >= 1.00 AND quality_ptg <= 1.0099 THEN 'Achieving' 
        WHEN quality_ptg >= 1.01 THEN 'Excelling' 
        ELSE NULL 
      END AS quality_achievement_tier,
      
      CASE 
        WHEN quality_ptg IS NULL THEN NULL 
        WHEN quality_ptg < 0.90 THEN 1 
        WHEN quality_ptg >= 0.90 AND quality_ptg <= 0.9999 THEN 2 
        WHEN quality_ptg >= 1.00 AND quality_ptg <= 1.0099 THEN 3 
        WHEN quality_ptg >= 1.01 THEN 4 
        ELSE 0 
      END AS quality_points_obtained
    FROM SrManager_Quality_PTG
  ),

  SrManager_Quality_Final_Block AS (
    SELECT
      timestamp,
      date,
      report_month,
      report_year,
      tl_manager,
      CAST(NULL AS STRING) AS tl_sr_manager, -- Blank for Senior Manager hierarchy level
      program,
      country,
      region,
      qaptg_business_category,
      qa_kpi,
      quality_score_actual,
      quality_score_target_program,
      quality_weight_master,
      quality_ptg,
      quality_achievement_tier,
      quality_points_obtained,
      CASE WHEN quality_points_obtained IS NULL THEN NULL ELSE (quality_points_obtained / 4) * quality_weight_master END AS quality_weight_obtained,
      CASE WHEN quality_points_obtained IS NULL THEN NULL ELSE quality_points_obtained * quality_weight_master END AS quality_points_final_score,
      quality_notes,
      qa_kpi_applicable,
      qa_exempt,
      qa_reason
    FROM SrManager_Quality_Scores
  )

  -- ==============================================================================================
  -- FINAL UNION
  -- ==============================================================================================
  SELECT * FROM Manager_Quality_Final_Block
  UNION ALL
  SELECT * FROM SrManager_Quality_Final_Block;

END;
