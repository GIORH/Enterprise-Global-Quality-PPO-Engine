CREATE OR REPLACE PROCEDURE `ti-ca-ml-start.QA_Training_scorecards.step3_sp_2026_unpivot_team_lead`()
BEGIN

  /* ======================================================================================
   * PROCEDURE: sp_2026_unpivot_team_lead
   * DESCRIPTION: Team Lead Unpivot aligned to Blueprints and compatible with Looker.
   * INTEGRATION: Standardized 3-Level Row Level Security (RLS) implementation.
   *   - first_level_security: Evaluated Employee Email + Full Access Emails
   *   - second_level_security: Immediate Supervisor 1 Email + Full Access Emails
   *   - third_level_security: Evaluated Email + Full Hierarchy Chain (L1-L6) + Full Access Emails
   * NOTE: Final aliases are maintained for Looker Studio compatibility.
   * ====================================================================================== */

  CREATE OR REPLACE TABLE `ti-ca-ml-start.QA_Training_scorecards.2026_scorecard_quality_team_lead_unpivoted` AS

  WITH 
    -- 🔑 1. DYNAMIC FULL ACCESS EMAIL CONSOLIDATION
    full_access_list AS (
      SELECT STRING_AGG(email, ',') AS full_access_emails
      FROM (
        SELECT LOWER(TRIM(telus_digital_email)) AS email 
        FROM `ti-ca-ml-start.QA_Training_scorecards.2026_full_access_security_emails_raw` 
        WHERE telus_digital_email IS NOT NULL AND TRIM(telus_digital_email) != ''
        
        UNION DISTINCT
        
        SELECT LOWER(TRIM(telus_international_email)) AS email 
        FROM `ti-ca-ml-start.QA_Training_scorecards.2026_full_access_security_emails_raw` 
        WHERE telus_international_email IS NOT NULL AND TRIM(telus_international_email) != ''
      )
    ),

    -- 🔑 2. HISTORICAL ROSTER SECURITY MAPPING PER EMPLOYEE/MONTH/YEAR
    roster_security AS (
      SELECT 
        REGEXP_REPLACE(TRIM(CAST(employee_id AS STRING)), r'\.0$', '') AS employee_id_std,
        UPPER(TRIM(SUBSTR(CAST(month AS STRING), 1, 3))) AS month_std,
        SAFE_CAST(year AS STRING) AS year_std,
        LOWER(TRIM(email_primary_work)) AS evaluated_email,
        LOWER(TRIM(inmediate_supervisor_1_email)) AS supervisor_1_email,
        ARRAY_TO_STRING(
          ARRAY(
            SELECT DISTINCT email
            FROM UNNEST([
              LOWER(TRIM(email_primary_work)),
              LOWER(TRIM(inmediate_supervisor_1_email)),
              LOWER(TRIM(inmediate_supervisor_2_email)),
              LOWER(TRIM(inmediate_supervisor_3_email)),
              LOWER(TRIM(inmediate_supervisor_4_email)),
              LOWER(TRIM(inmediate_supervisor_5_email)),
              LOWER(TRIM(inmediate_supervisor_6_email))
            ]) AS email
            WHERE email IS NOT NULL AND TRIM(email) != ''
          ), ','
        ) AS full_chain_emails
      FROM `ti-ca-ml-start.QA_Training_scorecards.2026_historical_qa_global_roster_proposal_raw`
      WHERE employee_id IS NOT NULL 
        AND TRIM(CAST(employee_id AS STRING)) NOT IN ('', '-', 'NULL')
      QUALIFY ROW_NUMBER() OVER(
        PARTITION BY 
          REGEXP_REPLACE(TRIM(CAST(employee_id AS STRING)), r'\.0$', ''),
          UPPER(TRIM(SUBSTR(CAST(month AS STRING), 1, 3))),
          SAFE_CAST(year AS STRING)
        ORDER BY employee_id
      ) = 1
    ),

    source AS (
      SELECT * FROM `ti-ca-ml-start.QA_Training_scorecards.2026_scorecard_qa_team_lead_consolidated`
      WHERE tl_wdid IS NOT NULL
    ),

    unpivoted_data AS (
      -- BLOCK 1: QUALITY % TO GOAL
      SELECT 
        PARSE_DATE('%b %E4Y', CONCAT(INITCAP(report_month), ' ', CAST(report_year AS STRING))) AS performance_date,
        report_year, 
        report_month, 
        'CX Quality Team Lead' AS position_role,
        SAFE_CAST(tl_wdid AS STRING) AS employee_id, 
        tl_name AS quality_team_member,
        region, 
        country, 
        program, 
        tl_manager AS immediate_supervisor, -- TL's supervisor is their Manager
        tl_manager AS immediate_manager, 
        tl_sr_manager AS immediate_sr_manager,
        'Quality % to Goal' AS kpi, 
        qaptg_business_category AS business_category, 
        SAFE_CAST(quality_score_target_program AS FLOAT64) AS target, 
        SAFE_CAST(qa_single_multi_program AS FLOAT64) AS target_obtained, 
        SAFE_CAST(qa_points_obtained AS FLOAT64) AS metric_points, 
        SAFE_CAST(qa_weight AS FLOAT64) AS weight, 
        SAFE_CAST(qa_weight_obtained AS FLOAT64) AS weight_obtained, 
        qa_achievement_category AS tier, 
        SAFE_CAST(qa_points_obtained_for_final_score_only AS FLOAT64) AS quality_ptg_points_final_score
      FROM source
      
      UNION ALL
      
      -- BLOCK 2: VOC % TO GOAL
      SELECT 
        PARSE_DATE('%b %E4Y', CONCAT(INITCAP(report_month), ' ', CAST(report_year AS STRING))),
        report_year, report_month, 'CX Quality Team Lead', SAFE_CAST(tl_wdid AS STRING), tl_name, region, country, program, tl_manager, tl_manager, tl_sr_manager,
        'VOC % to Goal', voc_business_category, SAFE_CAST(voc_score_target_program AS FLOAT64), SAFE_CAST(voc_single_multi_program AS FLOAT64), SAFE_CAST(voc_points_obtained AS FLOAT64), SAFE_CAST(voc_weight AS FLOAT64), SAFE_CAST(voc_weight_obtaiend AS FLOAT64), voc_achievement_category, SAFE_CAST(voc_points_obtained_for_final_score_only AS FLOAT64)
      FROM source

      UNION ALL
      
      -- BLOCK 3: ACCURACY % TO GOAL
      SELECT 
        PARSE_DATE('%b %E4Y', CONCAT(INITCAP(report_month), ' ', CAST(report_year AS STRING))),
        report_year, report_month, 'CX Quality Team Lead', SAFE_CAST(tl_wdid AS STRING), tl_name, region, country, program, tl_manager, tl_manager, tl_sr_manager,
        'Accuracy % to Goal', accuracy_business_category, SAFE_CAST(accuracy_target_master AS FLOAT64), SAFE_CAST(accuracy_pct_to_goal AS FLOAT64), SAFE_CAST(accuracy_points_obtained AS FLOAT64), SAFE_CAST(accuracy_weight_master AS FLOAT64), SAFE_CAST(accuracy_weight_diluted AS FLOAT64), accuracy_achievement_category, SAFE_CAST(accuracy_points_obtained_for_final_score_only AS FLOAT64)
      FROM source

      UNION ALL
      
      -- BLOCK 4: SERVICE DELIVERY
      SELECT 
        PARSE_DATE('%b %E4Y', CONCAT(INITCAP(report_month), ' ', CAST(report_year AS STRING))),
        report_year, report_month, 'CX Quality Team Lead', SAFE_CAST(tl_wdid AS STRING), tl_name, region, country, program, tl_manager, tl_manager, tl_sr_manager,
        'Service Delivery', service_delivery_business_category, SAFE_CAST(service_delivery_target_master AS FLOAT64), SAFE_CAST(service_delivery_pct_to_goal AS FLOAT64), SAFE_CAST(service_delivery_points_obtained AS FLOAT64), SAFE_CAST(service_delivery_weight_master AS FLOAT64), SAFE_CAST(service_delivery_weight_obtaiend_program_diluted AS FLOAT64), service_delivery_status, SAFE_CAST(service_delivery_points_obtained_for_final_score_only AS FLOAT64)
      FROM source

      UNION ALL
      
      -- BLOCK 5: PRODUCTIVITY
      SELECT 
        PARSE_DATE('%b %E4Y', CONCAT(INITCAP(report_month), ' ', CAST(report_year AS STRING))),
        report_year, report_month, 'CX Quality Team Lead', SAFE_CAST(tl_wdid AS STRING), tl_name, region, country, program, tl_manager, tl_manager, tl_sr_manager,
        'Productivity', productivity_business_category, SAFE_CAST(productivity_target AS FLOAT64), SAFE_CAST(productivity_ptg AS FLOAT64), SAFE_CAST(productivity_points_obtained AS FLOAT64), SAFE_CAST(productivity_weight AS FLOAT64), SAFE_CAST(productivity_weight_obtaiend AS FLOAT64), productivity_achievement_category, SAFE_CAST(productivity_points_obtained_for_final_score_only AS FLOAT64)
      FROM source

      UNION ALL
      
      -- BLOCK 6: INNOVATION
      SELECT 
        PARSE_DATE('%b %E4Y', CONCAT(INITCAP(report_month), ' ', CAST(report_year AS STRING))),
        report_year, report_month, 'CX Quality Team Lead', SAFE_CAST(tl_wdid AS STRING), tl_name, region, country, program, tl_manager, tl_manager, tl_sr_manager,
        'Innovation', innovation_businesscategory, SAFE_CAST(innovation_target AS FLOAT64), SAFE_CAST(innovation_ptg AS FLOAT64), SAFE_CAST(innovation_points_obtained AS FLOAT64), SAFE_CAST(innovation_weight AS FLOAT64), SAFE_CAST(innovation_weight_obtained AS FLOAT64), innovation_achievement, SAFE_CAST(innovation_points_obtained_for_final_score_only AS FLOAT64)
      FROM source

      UNION ALL
      
      -- BLOCK 7: PPD
      SELECT 
        PARSE_DATE('%b %E4Y', CONCAT(INITCAP(report_month), ' ', CAST(report_year AS STRING))),
        report_year, report_month, 'CX Quality Team Lead', SAFE_CAST(tl_wdid AS STRING), tl_name, region, country, program, tl_manager, tl_manager, tl_sr_manager,
        'PPD', ppd_businesscategory, SAFE_CAST(ppd_target AS FLOAT64), SAFE_CAST(ppd_ptg AS FLOAT64), SAFE_CAST(ppd_points_obtained AS FLOAT64), SAFE_CAST(ppd_weight AS FLOAT64), SAFE_CAST(ppd_weight_obtained AS FLOAT64), ppd_achievement_category, SAFE_CAST(ppd_points_obtained_for_final_score_only AS FLOAT64)
      FROM source

      UNION ALL

      -- BLOCK 8: NEW BLOCK YETG PERFORMANCE (YEARLY EVALUATIONS TO GOAL - 10% WEIGHT)
      SELECT 
          PARSE_DATE('%b %E4Y', CONCAT(INITCAP(report_month), ' ', CAST(report_year AS STRING))),
          report_year, report_month, 'CX Quality Team Lead', SAFE_CAST(tl_wdid AS STRING), tl_name, region, country, program, tl_manager, tl_manager, tl_sr_manager,
          yearly_evals_kpi, yearly_evals_business_category, 
          -- 💡 MODIFICACIÓN: Meta (Target) - Solo en Junio
          CASE 
            WHEN yearly_evals_kpi = 'Yearly Evaluations (% to goal)' 
                AND UPPER(CAST(report_month AS STRING)) NOT IN ('JUN', 'JUNE', 'JUNIO', '6', '06') THEN NULL
            ELSE SAFE_CAST(yearly_evals_target_master AS FLOAT64)
          END AS target,
          SAFE_CAST(yearly_evals_ptg AS FLOAT64), 
          SAFE_CAST(yearly_evals_metric_points AS FLOAT64), 
          -- 💡 MODIFICACIÓN: Peso (Weight Master) - Solo en Junio
          CASE 
            WHEN yearly_evals_kpi = 'Yearly Evaluations (% to goal)' 
                AND UPPER(CAST(report_month AS STRING)) NOT IN ('JUN', 'JUNE', 'JUNIO', '6', '06') THEN NULL
            ELSE SAFE_CAST(yearly_evals_weight_master AS FLOAT64)
          END, 
          SAFE_CAST(yearly_evals_weight_earned AS FLOAT64), 
          yearly_evals_achievement_category, 
          SAFE_CAST(yearly_evals_points_final_score AS FLOAT64)
      FROM source

      UNION ALL
      
      -- BLOCK 9: POTP (10% WEIGHT)
      SELECT 
        PARSE_DATE('%b %E4Y', CONCAT(INITCAP(report_month), ' ', CAST(report_year AS STRING))),
        report_year, report_month, 'CX Quality Team Lead', SAFE_CAST(tl_wdid AS STRING), tl_name, region, country, program, tl_manager, tl_manager, tl_sr_manager,
        potp_kpi, 
        potp_business_category, 
        SAFE_CAST(potp_target AS FLOAT64), 
        SAFE_CAST(potp_ptg AS FLOAT64), 
        SAFE_CAST(potp_points_obtained AS FLOAT64), 
        SAFE_CAST(potp_weight AS FLOAT64), 
        SAFE_CAST(potp_weight_obtained AS FLOAT64), 
        CAST(potp_achievement_tier AS STRING), 
        SAFE_CAST(potp_points_for_final_score AS FLOAT64)
      FROM source

      UNION ALL

      -- BLOCK 10: FINAL SCORE (DAPT LOGIC INTEGRATION)
      SELECT 
        PARSE_DATE('%b %E4Y', CONCAT(INITCAP(report_month), ' ', CAST(report_year AS STRING))),
        report_year, report_month, 'CX Quality Team Lead', SAFE_CAST(tl_wdid AS STRING), tl_name, region, country, program, tl_manager, tl_manager, tl_sr_manager,
        final_score_kpi,                  -- KPI: 'Final Score'
        final_score_business_category,    -- Business Category: 'All'
        CAST(NULL AS FLOAT64),            -- Target
        SAFE_CAST(final_score_ptg AS FLOAT64), -- Target Obtained (Global achievement %)
        CAST(NULL AS FLOAT64),            -- Metric Points
        CAST(NULL AS FLOAT64),            -- Weight
        CAST(NULL AS FLOAT64),            -- Weight Obtained
        final_score_tier,                 -- Global tier ('Excelling', etc.)
        -- 💡 MODIFICACIÓN 1: Si es Final Score y el puntaje original es '0' sólido, se vuelve NULL
        CASE 
          WHEN final_score_kpi = 'Final Score' AND TRIM(CAST(final_score_points_obtained AS STRING)) = '0' THEN NULL
          ELSE SAFE_CAST(final_score_points_obtained AS FLOAT64)
        END AS quality_ptg_points_final_score
      FROM source
    )
    
  /* FINAL SELECT: 21 STANDARDIZED COLUMNS FOR LOOKER + STANDARDIZED 3-LEVEL SECURITY COLUMNS */
  SELECT 
    d.performance_date, 
    d.report_year, 
    d.report_month, 
    d.position_role, 
    d.employee_id, 
    d.quality_team_member, 
    d.region, 
    d.country, 
    d.program, 
    d.immediate_supervisor, 
    d.immediate_manager, 
    d.immediate_sr_manager,
    d.kpi, 
    d.business_category, 
    d.target, 
    d.target_obtained, 
    d.metric_points, 
    d.weight, 
    d.weight_obtained, 
    d.tier,
    d.quality_ptg_points_final_score AS points_final_score,

    -- 🛡️ FIRST LEVEL SECURITY: Evaluated Employee Email + Full Access Emails
    NULLIF(
      ARRAY_TO_STRING(
        ARRAY(
          SELECT DISTINCT email
          FROM UNNEST(
            SPLIT(
              CONCAT(
                IFNULL(r.evaluated_email, ''),
                ',',
                IFNULL(fa.full_access_emails, '')
              ), ','
            )
          ) AS email
          WHERE email IS NOT NULL AND TRIM(email) != ''
        ), ','
      ), ''
    ) AS first_level_security,

    -- 🛡️ SECOND LEVEL SECURITY: Immediate Supervisor 1 Email + Full Access Emails
    NULLIF(
      ARRAY_TO_STRING(
        ARRAY(
          SELECT DISTINCT email
          FROM UNNEST(
            SPLIT(
              CONCAT(
                IFNULL(r.supervisor_1_email, ''),
                ',',
                IFNULL(fa.full_access_emails, '')
              ), ','
            )
          ) AS email
          WHERE email IS NOT NULL AND TRIM(email) != ''
        ), ','
      ), ''
    ) AS second_level_security,

    -- 🛡️ THIRD LEVEL SECURITY: Evaluated Email + Full Hierarchy Chain (L1-L6) + Full Access Emails
    NULLIF(
      ARRAY_TO_STRING(
        ARRAY(
          SELECT DISTINCT email
          FROM UNNEST(
            SPLIT(
              CONCAT(
                IFNULL(r.full_chain_emails, ''),
                ',',
                IFNULL(fa.full_access_emails, '')
              ), ','
            )
          ) AS email
          WHERE email IS NOT NULL AND TRIM(email) != ''
        ), ','
      ), ''
    ) AS third_level_security

  FROM unpivoted_data d
  CROSS JOIN full_access_list fa
  LEFT JOIN roster_security r
    ON REGEXP_REPLACE(TRIM(CAST(d.employee_id AS STRING)), r'\.0$', '') = r.employee_id_std
   AND UPPER(TRIM(SUBSTR(CAST(d.report_month AS STRING), 1, 3))) = r.month_std
   AND SAFE_CAST(d.report_year AS STRING) = r.year_std;

END;
