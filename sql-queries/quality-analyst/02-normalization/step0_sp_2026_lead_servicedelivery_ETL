CREATE OR REPLACE PROCEDURE `ti-ca-ml-start.QA_Training_scorecards.step0_sp_2026_lead_servicedelivery_ETL`()
BEGIN

  /************************************************************************************************
   PROCEDURE: Team Lead - Service Delivery Rolled-up (Numeric Fix)
   METRIC: Service Delivery (Weight: 10%, Target: 100%)
  ************************************************************************************************/

  CREATE OR REPLACE TABLE `ti-ca-ml-start.QA_Training_scorecards.2026_qa_service_delivery_team_lead_detailed` AS
  
  -- 1. CTE: Conteo de programas por TL para la dilución exacta
  WITH ProgramCounts AS (
    SELECT 
      CAST(tl_wdid AS STRING) as tl_wdid, 
      CAST(report_month AS STRING) as report_month, 
      CAST(report_year AS STRING) as report_year, 
      COUNT(DISTINCT program) AS final_total_programs
    FROM `ti-ca-ml-start.QA_Training_scorecards.2026_qa_productivity_raw`
    GROUP BY 1, 2, 3
  ),

  -- 2. CTE: Agregación de datos (Incluyendo SAFE_CAST para evitar errores de tipo)
  AggregatedData AS (
    SELECT 
      'CX Quality Team Lead and Sr Team lead' AS role,
      MAX(timestamp) AS timestamp,
      MAX(submitter_email) AS submitter_email,
      CAST(report_month AS STRING) as report_month,
      CAST(report_year AS STRING) as report_year,
      CAST(tl_wdid AS STRING) as tl_wdid,
      tl_name,
      ANY_VALUE(tl_manager) AS tl_manager,
      ANY_VALUE(tl_sr_manager) AS tl_sr_manager,
      program,
      country,
      region,
      'My Business' as service_delivery_business_category,
      'Service Delivery' as kpi,
      
      -- Nuevas columnas de soporte añadidas después de las dimensiones para no alterar el GROUP BY ordinal
      IF(COUNTIF(LOWER(TRIM(kpi_applicable)) = 'yes') > 0, 'Yes', 'No') AS service_delivery_kpi_applicable,
      IF(COUNTIF(LOWER(TRIM(exempt)) = 'no') > 0, 'No', 'Yes') AS service_delivery_exempt,
      MAX(CASE WHEN LOWER(TRIM(exempt)) = 'yes' THEN reason ELSE NULL END) AS service_delivery_reason,
      
      -- Suma de columnas con SAFE_CAST filtrando analistas exentos para proteger el Roll-up
      SUM(CASE WHEN LOWER(TRIM(exempt)) = 'no' THEN SAFE_CAST(qa_evals_completed AS FLOAT64) ELSE NULL END) as qa_evals_completed,
      SUM(CASE WHEN LOWER(TRIM(exempt)) = 'no' THEN SAFE_CAST(qa_evals_target AS FLOAT64) ELSE NULL END) as qa_evals_target,
      SUM(CASE WHEN LOWER(TRIM(exempt)) = 'no' THEN SAFE_CAST(voc_evals_completed AS FLOAT64) ELSE NULL END) as voc_evals_completed,
      SUM(CASE WHEN LOWER(TRIM(exempt)) = 'no' THEN SAFE_CAST(voc_evals_target AS FLOAT64) ELSE NULL END) as voc_evals_target,

      -- Promedios de los cumplimientos del equipo (Pilares) libres de analistas exentos
      AVG(CASE WHEN LOWER(TRIM(exempt)) = 'no' THEN SAFE_CAST(REPLACE(qa_evals_completion, '%', '') AS FLOAT64) ELSE NULL END) / 100 as _qa_comp_avg,
      AVG(CASE WHEN LOWER(TRIM(exempt)) = 'no' THEN SAFE_CAST(REPLACE(voc_evals_completion, '%', '') AS FLOAT64) ELSE NULL END) / 100 as _voc_comp_avg,

      -- Promedio del Score Final libre de analistas exentos
      AVG(CASE WHEN LOWER(TRIM(exempt)) = 'no' THEN SAFE_CAST(REPLACE(service_delivery_pct_to_goal, '%', '') AS FLOAT64) ELSE NULL END) / 100 as _sd_score_avg
    FROM `ti-ca-ml-start.QA_Training_scorecards.2026_qa_service_delivery_analyst_detailed`
    GROUP BY 4,5,6,7,10,11,12
  ),

  -- 3. CTE: Cálculo de Niveles y Puntos
  CalculatedLevels AS (
    SELECT 
      ad.*,
      pc.final_total_programs,
      1.00 as service_delivery_target_master,
      IF(ad.service_delivery_exempt = 'Yes', NULL, 0.10) as service_delivery_weight_master,
      
      IF(ad.service_delivery_exempt = 'Yes', NULL, FORMAT("%.2f%%", ad._qa_comp_avg * 100)) as qa_evals_completion,
      IF(ad.service_delivery_exempt = 'Yes', NULL, FORMAT("%.2f%%", ad._voc_comp_avg * 100)) as voc_evals_completion,
      IF(ad.service_delivery_exempt = 'Yes', NULL, FORMAT("%.2f%%", ad._sd_score_avg * 100)) as service_delivery_pct_to_goal,

      IF(ad.service_delivery_exempt = 'Yes', NULL, 
        CASE 
          WHEN ad._sd_score_avg < 0.90 THEN 1
          WHEN ad._sd_score_avg < 1.00 THEN 2
          WHEN ad._sd_score_avg < 1.01 THEN 3
          ELSE 4
        END) as service_delivery_points_obtained
    FROM AggregatedData ad
    LEFT JOIN ProgramCounts pc 
      ON ad.tl_wdid = pc.tl_wdid 
      AND ad.report_month = pc.report_month 
      AND ad.report_year = pc.report_year
  )

  -- 4. SELECT Final: Status, Dilución y Scorecard Points
  SELECT 
    * EXCEPT(_qa_comp_avg, _voc_comp_avg, _sd_score_avg),
    
    CASE 
      WHEN service_delivery_exempt = 'Yes' THEN NULL
      WHEN service_delivery_points_obtained = 1 THEN 'Improvement Required'
      WHEN service_delivery_points_obtained = 2 THEN 'Developing'
      WHEN service_delivery_points_obtained = 3 THEN 'Achieving'
      ELSE 'Excelling'
    END as service_delivery_status,

    -- Puntos para Scorecard Final
    IF(service_delivery_exempt = 'Yes', NULL, SAFE_CAST(service_delivery_points_obtained * 0.10 AS FLOAT64)) as service_delivery_points_obtained_for_final_score_only,

    -- Peso Ganado (Cuartas partes)
    IF(service_delivery_exempt = 'Yes', NULL, FORMAT("%.2f%%", (0.10 * (CASE 
                                 WHEN service_delivery_points_obtained = 1 THEN 0.25 
                                 WHEN service_delivery_points_obtained = 2 THEN 0.50 
                                 WHEN service_delivery_points_obtained = 3 THEN 0.75 
                                 ELSE 1.00 END)) * 100)) as service_delivery_earned_weight,

    -- Peso Diluido (Conservando alias original con typo: service_delivery_weight_obtaiend_program_diluted)
    IF(service_delivery_exempt = 'Yes', NULL, (0.10 * (CASE 
                               WHEN service_delivery_points_obtained = 1 THEN 0.25 
                               WHEN service_delivery_points_obtained = 2 THEN 0.50 
                               WHEN service_delivery_points_obtained = 3 THEN 0.75 
                               ELSE 1.00 END)) * SAFE_DIVIDE(1.0, NULLIF(final_total_programs, 0))) as service_delivery_weight_obtaiend_program_diluted

  FROM CalculatedLevels;

END;
