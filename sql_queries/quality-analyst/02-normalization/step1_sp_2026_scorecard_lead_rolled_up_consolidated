CREATE OR REPLACE PROCEDURE `ti-ca-ml-start.QA_Training_scorecards.step1_sp_2026_scorecard_lead_rolled_up_consolidated`()
BEGIN

  CREATE OR REPLACE TABLE `ti-ca-ml-start.QA_Training_scorecards.2026_tl_rolled_up_consolidated` AS
  
  -- ===========================================================================
  -- BLOQUE 1: MASTER SKELETON (Universo de Llaves Únicas Ultra Limpio)
  -- ===========================================================================
  WITH master_skeleton AS (
    SELECT 
      -- Limpieza absoluta de colas flotantes (.0), espacios y emparentado de caja de texto
      REGEXP_REPLACE(TRIM(SAFE_CAST(tl_wdid AS STRING)), r'\.0$', '') as tl_wdid, 
      LOWER(TRIM(SAFE_CAST(report_month AS STRING))) as report_month, 
      TRIM(SAFE_CAST(report_year AS STRING)) as report_year, 
      IFNULL(NULLIF(TRIM(SAFE_CAST(program AS STRING)), ''), 'No Program') as program, 
      country, -- MOVIDO AL GROUP BY
      region,  -- MOVIDO AL GROUP BY
      MAX(TRIM(role)) as role, 
      MAX(TRIM(tl_name)) as tl_name, 
      MAX(TRIM(tl_manager)) as tl_manager, 
      MAX(TRIM(tl_sr_manager)) as tl_sr_manager 
    FROM (
      SELECT tl_wdid, report_month, report_year, program, role, tl_name, tl_manager, tl_sr_manager, country, region FROM `ti-ca-ml-start.QA_Training_scorecards.2026_qa_ptg_team_lead_detailed` 
      UNION ALL
      SELECT tl_wdid, report_month, report_year, program, role, tl_name, tl_manager, tl_sr_manager, country, region FROM `ti-ca-ml-start.QA_Training_scorecards.2026_voc_ptg_team_lead_detailed` 
      UNION ALL
      SELECT tl_wdid, report_month, report_year, program, role, tl_name, tl_manager, tl_sr_manager, country, region FROM `ti-ca-ml-start.QA_Training_scorecards.2026_qa_accuracy_team_lead_detailed` 
      UNION ALL
      SELECT tl_wdid, report_month, report_year, program, role, tl_name, tl_manager, tl_sr_manager, country, region FROM `ti-ca-ml-start.QA_Training_scorecards.2026_qa_service_delivery_team_lead_detailed` 
      UNION ALL
      SELECT tl_wdid, report_month, report_year, program, 'CX Quality Team Lead and Sr Team lead' as role, tl_name, tl_manager, tl_sr_manager, country, region FROM `ti-ca-ml-start.QA_Training_scorecards.2026_productivity_team_lead_detailed`
    )
    GROUP BY 1, 2, 3, 4, 5, 6
  ),

  -- ===========================================================================
  -- BLOQUE 2: PILARES INDIVIDUALES (Simetría total en las llaves de agrupación)
  -- ===========================================================================

  qa_block AS (
    SELECT 
      REGEXP_REPLACE(TRIM(SAFE_CAST(tl_wdid AS STRING)), r'\.0$', '') as tl_wdid, 
      LOWER(TRIM(SAFE_CAST(report_month AS STRING))) as report_month, 
      TRIM(SAFE_CAST(report_year AS STRING)) as report_year, 
      IFNULL(NULLIF(TRIM(SAFE_CAST(program AS STRING)), ''), 'No Program') as program,
      country, -- AÑADIDO PARA LA LLAVE
      region,  -- AÑADIDO PARA LA LLAVE
      MAX(qaptg_business_category) as qaptg_business_category, 
      MAX(qa_kpi) as qa_kpi, 
      MAX(qa_notes) as qa_notes, 
      MAX(qa_kpi_applicable) as qa_kpi_applicable, 
      MAX(qa_exempt) as qa_exempt, 
      MAX(qa_reason) as qa_reason,
      AVG(SAFE_CAST(REGEXP_REPLACE(quality_score_actual, r'[^0-9.]', '') AS FLOAT64) / 100.0) as quality_score_actual,
      AVG(SAFE_CAST(REGEXP_REPLACE(quality_score_target_program, r'[^0-9.]', '') AS FLOAT64) / 100.0) as quality_score_target_program,
      MAX(SAFE_CAST(final_total_programs AS FLOAT64)) as qa_final_total_programs,
      AVG(SAFE_CAST(qa_weight AS FLOAT64)) as qa_weight,
      MAX(SAFE_CAST(qa_single_multi_program AS FLOAT64)) as qa_single_multi_program,
      MAX(SAFE_CAST(qa_single_program AS FLOAT64)) as qa_single_program,
      MAX(SAFE_CAST(quality_multi_program AS FLOAT64)) as quality_multi_program,
      MAX(SAFE_CAST(qa_perf_vs_cap_uncapped AS FLOAT64)) as qa_perf_vs_cap_uncapped,
      MAX(achievement_category) as qa_achievement_category,
      AVG(SAFE_CAST(qa_points_obtained AS FLOAT64)) as qa_points_obtained,
      AVG(SAFE_CAST(qa_weight_obtained AS FLOAT64)) as qa_weight_obtained,
      AVG(SAFE_CAST(qa_points_obtained_for_final_score_only AS FLOAT64)) as qa_points_obtained_for_final_score_only,
      AVG(SAFE_CAST(qa_weight_obtaiend_program_diluted AS FLOAT64)) as qa_weight_obtaiend_program_diluted
    FROM `ti-ca-ml-start.QA_Training_scorecards.2026_qa_ptg_team_lead_detailed`
    GROUP BY 1,2,3,4,5,6
  ),

  voc_block AS (
    SELECT 
      REGEXP_REPLACE(TRIM(SAFE_CAST(tl_wdid AS STRING)), r'\.0$', '') as tl_wdid, 
      LOWER(TRIM(SAFE_CAST(report_month AS STRING))) as report_month, 
      TRIM(SAFE_CAST(report_year AS STRING)) as report_year, 
      IFNULL(NULLIF(TRIM(SAFE_CAST(program AS STRING)), ''), 'No Program') as program,
      country, -- AÑADIDO PARA LA LLAVE
      region,  -- AÑADIDO PARA LA LLAVE
      MAX(voc_business_category) as voc_business_category, 
      MAX(voc_kpi) as voc_kpi,
      AVG(SAFE_CAST(REGEXP_REPLACE(voc_score_actual, r'[^0-9.]', '') AS FLOAT64) / 100.0) as voc_score_actual,
      AVG(SAFE_CAST(REGEXP_REPLACE(voc_score_target_program, r'[^0-9.]', '') AS FLOAT64) / 100.0) as voc_score_target_program,
      MAX(SAFE_CAST(final_total_programs AS FLOAT64)) as voc_final_total_programs,
      AVG(SAFE_CAST(voc_weight AS FLOAT64)) as voc_weight,
      MAX(SAFE_CAST(voc_single_multi_program AS FLOAT64)) as voc_single_multi_program,
      MAX(SAFE_CAST(voc_single_program AS FLOAT64)) as voc_single_program,
      MAX(SAFE_CAST(voc_multi_program AS FLOAT64)) as voc_multi_program,
      MAX(SAFE_CAST(voc_perf_vs_cap_uncapped AS FLOAT64)) as voc_perf_vs_cap_uncapped,
      MAX(achievement_category) as voc_achievement_category,
      AVG(SAFE_CAST(voc_points_obtained AS FLOAT64)) as voc_points_obtained,
      AVG(SAFE_CAST(voc_weight_obtaiend AS FLOAT64)) as voc_weight_obtaiend,
      AVG(SAFE_CAST(voc_points_obtained_for_final_score_only AS FLOAT64)) as voc_points_obtained_for_final_score_only,
      AVG(SAFE_CAST(voc_weight_obtaiend_program_diluted AS FLOAT64)) as voc_weight_obtaiend_program_diluted
    FROM `ti-ca-ml-start.QA_Training_scorecards.2026_voc_ptg_team_lead_detailed`
    GROUP BY 1,2,3,4,5,6
  ),

  accuracy_block AS (
    SELECT 
      REGEXP_REPLACE(TRIM(SAFE_CAST(tl_wdid AS STRING)), r'\.0$', '') as tl_wdid, 
      LOWER(TRIM(SAFE_CAST(report_month AS STRING))) as report_month, 
      TRIM(SAFE_CAST(report_year AS STRING)) as report_year, 
      IFNULL(NULLIF(TRIM(SAFE_CAST(program AS STRING)), ''), 'No Program') as program,
      country, -- AÑADIDO PARA LA LLAVE
      region,  -- AÑADIDO PARA LA LLAVE
      MAX(accuracy_business_category) as accuracy_business_category,
      MAX(accuracy_kpi) as accuracy_kpi,
      SUM(SAFE_CAST(cal_accurate AS FLOAT64)) as cal_accurate,
      SUM(SAFE_CAST(cal_performed AS FLOAT64)) as cal_performed,
      SUM(SAFE_CAST(valid_disputes AS FLOAT64)) as valid_disputes,
      SUM(SAFE_CAST(total_completed_evals AS FLOAT64)) as total_completed_evals,
      SUM(SAFE_CAST(accurate_evals AS FLOAT64)) as accurate_evals,
      MAX(SAFE_CAST(final_total_programs AS FLOAT64)) as acc_final_total_programs,
      AVG(SAFE_CAST(accuracy_target_master AS FLOAT64)) as accuracy_target_master,
      AVG(SAFE_CAST(accuracy_weight_master AS FLOAT64)) as accuracy_weight_master,
      AVG(SAFE_CAST(REGEXP_REPLACE(accuracy_pct_to_goal, r'[^0-9.]', '') AS FLOAT64) / 100.0) as accuracy_pct_to_goal,
      AVG(SAFE_CAST(accuracy_points_obtained AS FLOAT64)) as accuracy_points_obtained,
      MAX(accuracy_achievement_category) as accuracy_achievement_category,
      AVG(SAFE_CAST(accuracy_points_obtained_for_final_score_only AS FLOAT64)) as accuracy_points_obtained_for_final_score_only,
      AVG(SAFE_CAST(REGEXP_REPLACE(accuracy_earned_weight, r'[^0-9.]', '') AS FLOAT64) / 100.0) as accuracy_earned_weight,
      AVG(SAFE_CAST(accuracy_weight_diluted AS FLOAT64)) as accuracy_weight_diluted
    FROM `ti-ca-ml-start.QA_Training_scorecards.2026_qa_accuracy_team_lead_detailed`
    GROUP BY 1,2,3,4,5,6
  ),

  sd_block AS (
    SELECT 
      REGEXP_REPLACE(TRIM(SAFE_CAST(tl_wdid AS STRING)), r'\.0$', '') as tl_wdid, 
      LOWER(TRIM(SAFE_CAST(report_month AS STRING))) as report_month, 
      TRIM(SAFE_CAST(report_year AS STRING)) as report_year, 
      IFNULL(NULLIF(TRIM(SAFE_CAST(program AS STRING)), ''), 'No Program') as program,
      country, -- AÑADIDO PARA LA LLAVE
      region,  -- AÑADIDO PARA LA LLAVE
      MAX(service_delivery_business_category) as service_delivery_business_category,
      MAX(kpi) as sd_kpi,
      SUM(SAFE_CAST(qa_evals_completed AS FLOAT64)) as qa_evals_completed,
      SUM(SAFE_CAST(qa_evals_target AS FLOAT64)) as qa_evals_target,
      SUM(SAFE_CAST(voc_evals_completed AS FLOAT64)) as voc_evals_completed,
      SUM(SAFE_CAST(voc_evals_target AS FLOAT64)) as voc_evals_target,
      MAX(SAFE_CAST(final_total_programs AS FLOAT64)) as sd_final_total_programs,
      AVG(SAFE_CAST(service_delivery_target_master AS FLOAT64)) as service_delivery_target_master,
      AVG(SAFE_CAST(service_delivery_weight_master AS FLOAT64)) as service_delivery_weight_master,
      AVG(SAFE_CAST(REGEXP_REPLACE(qa_evals_completion, r'[^0-9.]', '') AS FLOAT64) / 100.0) as qa_evals_completion,
      AVG(SAFE_CAST(REGEXP_REPLACE(voc_evals_completion, r'[^0-9.]', '') AS FLOAT64) / 100.0) as voc_evals_completion,
      AVG(SAFE_CAST(REGEXP_REPLACE(service_delivery_pct_to_goal, r'[^0-9.]', '') AS FLOAT64) / 100.0) as service_delivery_pct_to_goal,
      CAST(MAX(SAFE_CAST(service_delivery_points_obtained AS FLOAT64)) AS INT64) as service_delivery_points_obtained,
      MAX(service_delivery_status) as service_delivery_status,
      AVG(SAFE_CAST(service_delivery_points_obtained_for_final_score_only AS FLOAT64)) as service_delivery_points_obtained_for_final_score_only,
      AVG(SAFE_CAST(REGEXP_REPLACE(service_delivery_earned_weight, r'[^0-9.]', '') AS FLOAT64) / 100.0) as service_delivery_earned_weight,
      AVG(SAFE_CAST(service_delivery_weight_obtaiend_program_diluted AS FLOAT64)) as service_delivery_weight_obtaiend_program_diluted
    FROM `ti-ca-ml-start.QA_Training_scorecards.2026_qa_service_delivery_team_lead_detailed`
    GROUP BY 1,2,3,4,5,6
  ),

  prod_block AS (
    SELECT 
      REGEXP_REPLACE(TRIM(SAFE_CAST(tl_wdid AS STRING)), r'\.0$', '') as tl_wdid, 
      LOWER(TRIM(SAFE_CAST(report_month AS STRING))) as report_month, 
      TRIM(SAFE_CAST(report_year AS STRING)) as report_year, 
      IFNULL(NULLIF(TRIM(SAFE_CAST(program AS STRING)), ''), 'No Program') as program,
      country, -- AÑADIDO PARA LA LLAVE
      region,  -- AÑADIDO PARA LA LLAVE
      MAX(notes) as productivity_notes,
      MAX(productivity_business_category) as productivity_business_category,
      MAX(productivity_kpi) as productivity_kpi,
      AVG(SAFE_CAST(productivity_weight AS FLOAT64)) as productivity_weight,
      AVG(SAFE_CAST(productivity_target AS FLOAT64)) as productivity_target,
      SUM(SAFE_CAST(audits_completed AS FLOAT64)) as audits_completed,
      SUM(SAFE_CAST(audits_required AS FLOAT64)) as audits_required,
      AVG(SAFE_CAST(productivity_pct AS FLOAT64)) as productivity_ptg,
      MAX(productivity_achievement_category) as productivity_achievement_category,
      CAST(MAX(SAFE_CAST(productivity_points AS FLOAT64)) AS INT64) as productivity_points_obtained,
      AVG(SAFE_CAST(productivity_weight_obtained AS FLOAT64)) as productivity_weight_obtaiend,
      AVG(SAFE_CAST(productivity_weight_final_score AS FLOAT64)) as productivity_points_obtained_for_final_score_only
    FROM `ti-ca-ml-start.QA_Training_scorecards.2026_productivity_team_lead_detailed`
    GROUP BY 1,2,3,4,5,6
  )

  -- ===========================================================================
  -- BLOQUE 3: ENSAMBLE FINAL (Joins perfectamente alineados a nivel binario)
  -- ===========================================================================
  SELECT 
    CONCAT(s.tl_wdid, '|', INITCAP(s.report_month), '|', s.report_year, '|', s.program, '|', s.country) as primary_key,
    s.tl_wdid,
    INITCAP(s.report_month) as report_month, -- Estética capitalizada para Looker Studio
    s.report_year,
    s.program,
    s.role,
    s.tl_name,
    s.tl_manager,
    s.tl_sr_manager,
    s.country,
    s.region,
    
    -- QA PILLAR
    qa.qaptg_business_category, qa.qa_kpi, qa.qa_notes, qa.qa_kpi_applicable, qa.qa_exempt, qa.qa_reason,
    qa.quality_score_actual, qa.quality_score_target_program, qa.qa_final_total_programs, qa.qa_weight,
    qa.qa_single_multi_program, qa.qa_single_program, qa.quality_multi_program, qa.qa_perf_vs_cap_uncapped,
    qa.qa_achievement_category, qa.qa_points_obtained, qa.qa_weight_obtained, 
    qa.qa_points_obtained_for_final_score_only, qa.qa_weight_obtaiend_program_diluted,

    -- VOC PILLAR
    voc.voc_business_category, voc.voc_kpi, voc.voc_score_actual, voc.voc_score_target_program,
    voc.voc_final_total_programs, voc.voc_weight, voc.voc_single_multi_program, voc.voc_single_program,
    voc.voc_multi_program, voc.voc_perf_vs_cap_uncapped, voc.voc_achievement_category,
    voc.voc_points_obtained, voc.voc_weight_obtaiend, voc.voc_points_obtained_for_final_score_only, 
    voc.voc_weight_obtaiend_program_diluted,

    -- ACCURACY PILLAR
    acc.accuracy_business_category, acc.accuracy_kpi, acc.cal_accurate, acc.cal_performed,
    acc.valid_disputes, acc.total_completed_evals, acc.accurate_evals, acc.acc_final_total_programs,
    acc.accuracy_target_master, acc.accuracy_weight_master, acc.accuracy_pct_to_goal,
    acc.accuracy_points_obtained, acc.accuracy_achievement_category, 
    acc.accuracy_points_obtained_for_final_score_only, acc.accuracy_earned_weight, acc.accuracy_weight_diluted,

    -- SERVICE DELIVERY PILLAR
    sd.service_delivery_business_category, sd.sd_kpi, sd.qa_evals_completed, sd.qa_evals_target,
    sd.voc_evals_completed, sd.voc_evals_target, sd.sd_final_total_programs,
    sd.service_delivery_target_master, sd.service_delivery_weight_master, sd.qa_evals_completion,
    sd.voc_evals_completion, sd.service_delivery_pct_to_goal, sd.service_delivery_points_obtained,
    sd.service_delivery_status, sd.service_delivery_points_obtained_for_final_score_only,
    sd.service_delivery_earned_weight, sd.service_delivery_weight_obtaiend_program_diluted,

    -- PRODUCTIVITY PILLAR
    prd.productivity_notes, prd.productivity_business_category, prd.productivity_kpi, prd.productivity_weight,
    prd.productivity_target, prd.audits_completed, prd.audits_required, prd.productivity_ptg,
    prd.productivity_achievement_category, prd.productivity_points_obtained,
    prd.productivity_weight_obtaiend, prd.productivity_points_obtained_for_final_score_only

  FROM master_skeleton s
  LEFT JOIN qa_block qa ON s.tl_wdid = qa.tl_wdid AND s.report_month = qa.report_month AND s.report_year = qa.report_year AND s.program = qa.program AND s.country = qa.country AND s.region = qa.region
  LEFT JOIN voc_block voc ON s.tl_wdid = voc.tl_wdid AND s.report_month = voc.report_month AND s.report_year = voc.report_year AND s.program = voc.program AND s.country = voc.country AND s.region = voc.region
  LEFT JOIN accuracy_block acc ON s.tl_wdid = acc.tl_wdid AND s.report_month = acc.report_month AND s.report_year = acc.report_year AND s.program = acc.program AND s.country = acc.country AND s.region = acc.region
  LEFT JOIN sd_block sd ON s.tl_wdid = sd.tl_wdid AND s.report_month = sd.report_month AND s.report_year = sd.report_year AND s.program = sd.program AND s.country = sd.country AND s.region = sd.region
  LEFT JOIN prod_block prd ON s.tl_wdid = prd.tl_wdid AND s.report_month = prd.report_month AND s.report_year = prd.report_year AND s.program = prd.program AND s.country = prd.country AND s.region = prd.region;

END;
