CREATE OR REPLACE PROCEDURE `ti-ca-ml-start.QA_Training_scorecards.step1_sp_2026_scorecard_lead_non_rolled_up_consolidated`()
BEGIN

  /************************************************************************************************
   PROCEDURE: Team Lead Non Rolled-Up Consolidation (Innovation & PPD) - AUDITED VERSION
   DESCRIPTION: 
   1. Consolidates metrics into a single row per Lead, Month, and Year (No Program).
   2. Hardcoded Weights (10%) and Targets (100%).
   3. Innovation Achievement: <75% IR, 75-99.99% Dev, 100% Ach, >100% Exc.
   4. Innovation PTG mapping: 1pt=25%, 2pts=50%, 3pts=75%, 4pts=100%, 5+pts=100.1%.
   5. PPD Achievement: <50% IR, 50-90.99% Dev, 91-100% Ach, >100% Exc.
  ************************************************************************************************/

  CREATE OR REPLACE TABLE `ti-ca-ml-start.QA_Training_scorecards.2026_tl_non_rolled_up_consolidated` AS
  
  WITH 
    /* --- PART 1: DIMENSIONS (Consolidated by TL, Month, Year) --- */
    tl_skeleton AS (
      SELECT 
        CAST(tl_wdid AS INT64) as tl_wdid, 
        LOWER(TRIM(report_month)) as report_month, 
        CAST(report_year AS INT64) as report_year,
        ANY_VALUE(TRIM(tl_name)) as tl_name, 
        ANY_VALUE(TRIM(country)) as country, 
        ANY_VALUE(TRIM(region)) as region,
        ANY_VALUE(TRIM(tl_manager)) as tl_manager,
        ANY_VALUE(TRIM(tl_sr_manager)) as tl_sr_manager
      FROM (
        SELECT tl_wdid, report_month, report_year, tl_name, country, region, tl_manager, tl_sr_manager 
        FROM `ti-ca-ml-start.QA_Training_scorecards.2026_qatl_innovation_raw` 
        UNION ALL
        SELECT tl_wdid, report_month, report_year, tl_name, country, region, tl_manager, tl_sr_manager 
        FROM `ti-ca-ml-start.QA_Training_scorecards.2026_qatl_ppd_raw`
      )
      GROUP BY 1, 2, 3
    ),

    /* --- PART 2: RAW DATA AGGREGATION --- */
    inn_block AS (
      SELECT 
        CAST(tl_wdid AS INT64) as wdid, 
        LOWER(TRIM(report_month)) as month, 
        CAST(report_year AS INT64) as year,
        -- Extracción de columnas de soporte para Innovación
        MAX(exempt) as innovation_exempt,
        MAX(exception_reason) as innovation_reason,
        SUM(CASE WHEN LOWER(TRIM(exempt)) = 'no' THEN SAFE_CAST(innovation_high_count AS FLOAT64) ELSE NULL END) as h,
        SUM(CASE WHEN LOWER(TRIM(exempt)) = 'no' THEN SAFE_CAST(innovation_med_count AS FLOAT64) ELSE NULL END) as m,
        SUM(CASE WHEN LOWER(TRIM(exempt)) = 'no' THEN SAFE_CAST(innovation_low_count AS FLOAT64) ELSE NULL END) as l
      FROM `ti-ca-ml-start.QA_Training_scorecards.2026_qatl_innovation_raw`
      GROUP BY 1, 2, 3
    ),

    ppd_block AS (
      SELECT 
        CAST(tl_wdid AS INT64) as wdid, 
        LOWER(TRIM(report_month)) as month, 
        CAST(report_year AS INT64) as year,
        -- Extracción de columnas de soporte para PPD
        MAX(exempt) as ppd_exempt,
        MAX(exception_reason) as ppd_reason,
        SUM(CASE WHEN LOWER(TRIM(exempt)) = 'no' THEN SAFE_CAST(ppd_mandatory_completed AS FLOAT64) ELSE NULL END) as act,
        SUM(CASE WHEN LOWER(TRIM(exempt)) = 'no' THEN SAFE_CAST(ppd_required_courses AS FLOAT64) ELSE NULL END) as tar
      FROM `ti-ca-ml-start.QA_Training_scorecards.2026_qatl_ppd_raw`
      GROUP BY 1, 2, 3
    ),

    /* --- PART 3: ASSEMBLY & BASE CALCULATIONS --- */
    assembly AS (
      SELECT 
        t.*,
        -- Mapeo de columnas de estado (Innovación)
        COALESCE(inn.innovation_exempt, 'No') as innovation_exempt,
        inn.innovation_reason,
        'Yes' as innovation_kpi_applicable,
        
        -- Raw counts for Innovation
        inn.h as inn_h, inn.m as inn_m, inn.l as inn_l,
        -- Metric Points Calculation (Innovation)
        CASE 
          WHEN inn.h IS NULL AND inn.m IS NULL AND inn.l IS NULL THEN NULL 
          ELSE (COALESCE(inn.h,0) * 4 + COALESCE(inn.m,0) * 3 + COALESCE(inn.l,0) * 2) 
        END as inn_total_pts,

        -- Mapeo de columnas de estado (PPD)
        COALESCE(pp.ppd_exempt, 'No') as ppd_exempt,
        pp.ppd_reason,
        'Yes' as ppd_kpi_applicable,

        -- Raw data for PPD
        pp.act as ppd_act, pp.tar as ppd_tar,
        SAFE_DIVIDE(pp.act, pp.tar) as ppd_ptg_raw,

        -- Hardcoded Constants
        0.10 as weight_const, 
        1.0 as target_const   
  
      FROM tl_skeleton t
      LEFT JOIN inn_block inn ON t.tl_wdid = inn.wdid AND t.report_month = inn.month AND t.report_year = inn.year
      LEFT JOIN ppd_block pp ON t.tl_wdid = pp.wdid AND t.report_month = pp.month AND t.report_year = pp.year
    ),

    /* --- PART 4: PTG MAPPING --- */
    logic_attribution AS (
      SELECT 
        *,
        -- Innovation PTG Mapping (1pt=25%, 2pts=50%, 3pts=75%, 4pts=100%, 5+pts=100.1%)
        CASE 
          WHEN inn_total_pts IS NULL THEN NULL
          WHEN inn_total_pts = 1 THEN 0.25
          WHEN inn_total_pts = 2 THEN 0.50
          WHEN inn_total_pts = 3 THEN 0.75
          WHEN inn_total_pts = 4 THEN 1.00
          WHEN inn_total_pts >= 5 THEN 1.001 
          ELSE 0.0 
        END as inn_ptg_mapped
      FROM assembly
    )

  /* --- PART 5: FINAL SELECTION & CATEGORIZATION --- */
  SELECT 
    CONCAT(CAST(tl_wdid AS STRING), '_', report_month, '_', CAST(report_year AS STRING)) as primary_key,
    tl_wdid, 
    report_month, 
    report_year, 
    tl_name, 
    tl_manager, 
    tl_sr_manager, 
    country, 
    region,

    -- INNOVATION BLOCK
    'My Business' as innovation_businesscategory,
    'Innovation' as innovation_kpi,
    innovation_kpi_applicable,
    innovation_exempt,
    innovation_reason,
    inn_h as innovation_high_count, 
    inn_m as innovation_med_count, 
    inn_l as innovation_low_count,
    IF(UPPER(TRIM(innovation_exempt)) = 'YES', NULL, inn_total_pts) as innovation_metric_points, 
    target_const as innovation_target,
    IF(UPPER(TRIM(innovation_exempt)) = 'YES', NULL, weight_const) as innovation_weight,
    IF(UPPER(TRIM(innovation_exempt)) = 'YES', NULL, inn_ptg_mapped) as innovation_ptg,
    -- Weight Obtained with CAP (Max 10%)
    IF(UPPER(TRIM(innovation_exempt)) = 'YES', NULL, 
      CASE 
        WHEN (inn_ptg_mapped * weight_const) > weight_const THEN weight_const 
        ELSE (inn_ptg_mapped * weight_const) 
      END) as innovation_weight_obtained,
    -- Achievement Category (CORRECTED: <75% IR, 75-99.99% Dev, 100% Ach, >100% Exc)
    IF(UPPER(TRIM(innovation_exempt)) = 'YES', NULL,
      CASE 
        WHEN inn_ptg_mapped > 1.00  THEN 'Excelling'
        WHEN inn_ptg_mapped = 1.00  THEN 'Achieving'
        WHEN inn_ptg_mapped >= 0.75 THEN 'Developing'
        ELSE 'Improvement Required' 
      END) as innovation_achievement,
    -- Points Obtained (1 to 4) based on the new Achievement Category
    IF(UPPER(TRIM(innovation_exempt)) = 'YES', NULL,
      CASE 
        WHEN inn_ptg_mapped > 1.00  THEN 4
        WHEN inn_ptg_mapped = 1.00  THEN 3
        WHEN inn_ptg_mapped >= 0.75 THEN 2
        ELSE 1 
      END) as innovation_points_obtained,
    -- Points for final score only (Points * Weight)
    IF(UPPER(TRIM(innovation_exempt)) = 'YES', NULL,
      (CASE 
        WHEN inn_ptg_mapped > 1.00  THEN 4
        WHEN inn_ptg_mapped = 1.00  THEN 3
        WHEN inn_ptg_mapped >= 0.75 THEN 2
        ELSE 1 
      END * weight_const)) as innovation_points_obtained_for_final_score_only,

    -- PPD BLOCK
    'My Team' as ppd_businesscategory,
    'PPD' as ppd_kpi,
    ppd_kpi_applicable,
    ppd_exempt,
    ppd_reason,
    ppd_act as ppd_mandatory_completed, 
    ppd_tar as ppd_required_courses,
    target_const as ppd_target,
    IF(UPPER(TRIM(ppd_exempt)) = 'YES', NULL, ppd_ptg_raw) as ppd_ptg,
    IF(UPPER(TRIM(ppd_exempt)) = 'YES', NULL, weight_const) as ppd_weight,
    -- PPD Achievement (Scale: IR <50%, Dev 50-90.99%, Ach 91-100%, Exc >100%)
    IF(UPPER(TRIM(ppd_exempt)) = 'YES', NULL,
      CASE 
        WHEN ppd_ptg_raw > 1.0   THEN 'Excelling'
        WHEN ppd_ptg_raw >= 0.91 THEN 'Achieving'
        WHEN ppd_ptg_raw >= 0.50 THEN 'Developing'
        ELSE 'Improvement Required' 
      END) as ppd_achievement_category,

    IF(UPPER(TRIM(ppd_exempt)) = 'YES', NULL,
      (CASE 
        WHEN ppd_ptg_raw > 1.0   THEN 4
        WHEN ppd_ptg_raw >= 0.91 THEN 3
        WHEN ppd_ptg_raw >= 0.50 THEN 2
        ELSE 1 
      END / 4.0) * weight_const) as ppd_weight_obtained,
    -- Points Obtained (1 to 4)
    IF(UPPER(TRIM(ppd_exempt)) = 'YES', NULL,
      CASE 
        WHEN ppd_ptg_raw > 1.0   THEN 4
        WHEN ppd_ptg_raw >= 0.91 THEN 3
        WHEN ppd_ptg_raw >= 0.50 THEN 2
        ELSE 1 
      END) as ppd_points_obtained,
    -- Final calculation (Points * Weight)
    IF(UPPER(TRIM(ppd_exempt)) = 'YES', NULL,
      (CASE 
        WHEN ppd_ptg_raw > 1.0   THEN 4
        WHEN ppd_ptg_raw >= 0.91 THEN 3
        WHEN ppd_ptg_raw >= 0.50 THEN 2
        ELSE 1 
      END * weight_const)) as ppd_points_obtained_for_final_score_only

  FROM logic_attribution;
END;
