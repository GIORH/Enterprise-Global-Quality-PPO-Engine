CREATE OR REPLACE PROCEDURE `ti-ca-ml-start.QA_Training_scorecards.step0_sp_2026_manager_qualitypercenttogoalETL`()
BEGIN

  /************************************************************************************************
   PROCEDURE: Manager & Sr Manager - Quality % to Goal Rolled-up (Weight 10%)
  ************************************************************************************************/

  CREATE OR REPLACE TABLE `ti-ca-ml-start.QA_Training_scorecards.2026_qa_ptg_manager_detailed` AS
  
  -- ==============================================================================================
  -- BRANCH 1: MANAGER (100% INTACT ORIGINAL LOGIC)
  -- ==============================================================================================
  WITH ManagerBase AS (
    SELECT 
      *,
      REGEXP_EXTRACT(tl_manager, r'\((\d+)\)\s*$') AS wdid_manager,
      TRIM(REGEXP_EXTRACT(tl_manager, r'^(.*?)\s*\(\d+\)\s*$')) AS manager_name
    FROM `ti-ca-ml-start.QA_Training_scorecards.2026_qa_quality_raw`
  ),

  ProgramCounts AS (
    SELECT 
      wdid_manager, report_month, report_year, 
      COUNT(DISTINCT program) AS final_total_programs
    FROM ManagerBase
    GROUP BY 1, 2, 3
  ),

  CalculatedData AS (
    SELECT 
      'CX Quality Manager and Sr Manager' AS role,
      MAX(raw.timestamp) AS timestamp,
      raw.report_month,
      raw.report_year,
      raw.manager_name,
      raw.wdid_manager,
      raw.tl_sr_manager,
      raw.program,
      raw.country,
      raw.region,
      'My Customer' AS qaptg_business_category,
      'Quality % to Goal' AS qa_kpi,
      
      IF(COUNTIF(LOWER(TRIM(raw.kpi_applicable)) = 'yes') > 0, 'Yes', 'No') AS qa_kpi_applicable,
      IF(COUNTIF(LOWER(TRIM(raw.exempt)) = 'no') > 0, 'No', 'Yes') AS qa_exempt,
      IF(COUNTIF(LOWER(TRIM(raw.exempt)) = 'no') > 0, 'Rolled up by Manager and Program', 'Exempt') AS qa_reason,
      
      IF(COUNTIF(LOWER(TRIM(raw.exempt)) = 'no') = 0, NULL, FORMAT('%.2f%%', AVG(CASE WHEN LOWER(TRIM(raw.exempt)) = 'no' THEN CAST(REPLACE(raw.quality_score_actual, '%', '') AS FLOAT64) ELSE NULL END))) AS quality_score_actual,
      IF(COUNTIF(LOWER(TRIM(raw.exempt)) = 'no') = 0, NULL, FORMAT('%.2f%%', AVG(CASE WHEN LOWER(TRIM(raw.exempt)) = 'no' THEN CAST(REPLACE(raw.quality_score_target_program, '%', '') AS FLOAT64) ELSE NULL END))) AS quality_score_target_program,
      
      pc.final_total_programs,
      
      CASE 
        WHEN COUNTIF(LOWER(TRIM(raw.kpi_applicable)) = 'yes') > 0 AND COUNTIF(LOWER(TRIM(raw.exempt)) = 'no') > 0 THEN 0.15 
        ELSE NULL 
      END AS qa_weight,

      SAFE_DIVIDE(
        AVG(CASE WHEN LOWER(TRIM(raw.exempt)) = 'no' THEN CAST(REPLACE(raw.quality_score_actual, '%', '') AS FLOAT64) ELSE NULL END), 
        AVG(CASE WHEN LOWER(TRIM(raw.exempt)) = 'no' THEN CAST(REPLACE(raw.quality_score_target_program, '%', '') AS FLOAT64) ELSE NULL END)
      ) AS qa_single_multi_program,

      CASE WHEN pc.final_total_programs = 1 THEN
        SAFE_DIVIDE(
          AVG(CASE WHEN LOWER(TRIM(raw.exempt)) = 'no' THEN CAST(REPLACE(raw.quality_score_actual, '%', '') AS FLOAT64) ELSE NULL END), 
          AVG(CASE WHEN LOWER(TRIM(raw.exempt)) = 'no' THEN CAST(REPLACE(raw.quality_score_target_program, '%', '') AS FLOAT64) ELSE NULL END)
        )
      ELSE NULL END AS qa_single_program,

      SAFE_DIVIDE(
        AVG(CASE WHEN LOWER(TRIM(raw.exempt)) = 'no' THEN CAST(REPLACE(raw.quality_score_actual, '%', '') AS FLOAT64) ELSE NULL END), 
        AVG(CASE WHEN LOWER(TRIM(raw.exempt)) = 'no' THEN CAST(REPLACE(raw.quality_score_target_program, '%', '') AS FLOAT64) ELSE NULL END)
      ) AS _raw_calc
    FROM ManagerBase AS raw
    LEFT JOIN ProgramCounts AS pc 
      ON raw.wdid_manager = pc.wdid_manager AND raw.report_month = pc.report_month AND raw.report_year = pc.report_year
    GROUP BY 3,4,5,6,7,8,9,10, pc.final_total_programs
  ),

  CappedData AS (
    SELECT * EXCEPT(_raw_calc),
      IF(qa_exempt = 'Yes', NULL,
        CASE WHEN final_total_programs >= 2 THEN
            CASE 
              WHEN _raw_calc <= 0.50 THEN 0
              WHEN _raw_calc > 0.50 AND _raw_calc <= 0.85 THEN 0.50
              WHEN _raw_calc > 0.85 AND _raw_calc <= 0.9999 THEN 0.75
              WHEN _raw_calc >= 1.00 AND _raw_calc <= 1.1499 THEN 1.00
              WHEN _raw_calc >= 1.15 THEN 1.15
              ELSE _raw_calc
            END
        ELSE NULL END) AS quality_multi_program,
      IF(qa_exempt = 'Yes', NULL,
        COALESCE(qa_single_program, 
                 CASE WHEN final_total_programs >= 2 THEN
                   CASE 
                     WHEN _raw_calc <= 0.50 THEN 0
                     WHEN _raw_calc > 0.50 AND _raw_calc <= 0.85 THEN 0.50
                     WHEN _raw_calc > 0.85 AND _raw_calc <= 0.9999 THEN 0.75
                     WHEN _raw_calc >= 1.00 AND _raw_calc <= 1.1499 THEN 1.00
                     WHEN _raw_calc >= 1.15 THEN 1.15
                     ELSE _raw_calc
                   END
                 ELSE NULL END)) AS qa_perf_vs_cap_uncapped
    FROM CalculatedData
  ),

  CategorizedAndPointsData AS (
    SELECT *,
      IF(qa_exempt = 'Yes', NULL,
        CASE 
          WHEN qa_perf_vs_cap_uncapped < 0.90 THEN 'Improvement Required'
          WHEN qa_perf_vs_cap_uncapped >= 0.90 AND qa_perf_vs_cap_uncapped <= 0.9999 THEN 'Developing'
          WHEN qa_perf_vs_cap_uncapped >= 1.00 AND qa_perf_vs_cap_uncapped <= 1.0099 THEN 'Achieving'
          WHEN qa_perf_vs_cap_uncapped >= 1.01 THEN 'Excelling'
          ELSE NULL 
        END) AS achievement_category,
      IF(qa_exempt = 'Yes', NULL,
        CASE 
          WHEN qa_perf_vs_cap_uncapped < 0.90 THEN 1
          WHEN qa_perf_vs_cap_uncapped >= 0.90 AND qa_perf_vs_cap_uncapped <= 0.9999 THEN 2
          WHEN qa_perf_vs_cap_uncapped >= 1.00 AND qa_perf_vs_cap_uncapped <= 1.0099 THEN 3
          WHEN qa_perf_vs_cap_uncapped >= 1.01 THEN 4
          ELSE NULL 
        END) AS qa_points_obtained
    FROM CappedData
  ),

  ManagerFinalData AS (
    SELECT 
      *,
      IF(qa_exempt = 'Yes', NULL, (qa_points_obtained * 0.25) * qa_weight) AS qa_weight_obtaiend,
      IF(qa_exempt = 'Yes', NULL, qa_points_obtained * qa_weight) AS qa_points_obtained_for_final_score_only,
      IF(qa_exempt = 'Yes', NULL,
        (CASE 
          WHEN achievement_category = 'Improvement Required' THEN qa_weight * 0.25
          WHEN achievement_category = 'Developing' THEN qa_weight * 0.50
          WHEN achievement_category = 'Achieving' THEN qa_weight * 0.75
          WHEN achievement_category = 'Excelling' THEN qa_weight * 1.00
          ELSE NULL 
        END) * SAFE_DIVIDE(1.0, final_total_programs)) AS qa_weight_obtaiend_program_diluted
    FROM 
      CategorizedAndPointsData
  ),

  -- ==============================================================================================
  -- BRANCH 2: SENIOR MANAGER (RE-MAPPED MIRROR LOGIC FROM RAW SOURCE)
  -- ==============================================================================================
  SrManagerBase AS (
    SELECT 
      * EXCEPT(tl_sr_manager),
      CAST(NULL AS STRING) AS tl_sr_manager, -- Blank for Senior Manager hierarchy level
      REGEXP_EXTRACT(tl_sr_manager, r'\((\d+)\)\s*$') AS wdid_manager,
      TRIM(REGEXP_EXTRACT(tl_sr_manager, r'^(.*?)\s*\(\d+\)\s*$')) AS manager_name
    FROM `ti-ca-ml-start.QA_Training_scorecards.2026_qa_quality_raw`
    WHERE tl_sr_manager IS NOT NULL AND TRIM(tl_sr_manager) != ''
  ),

  SrProgramCounts AS (
    SELECT 
      wdid_manager, report_month, report_year, 
      COUNT(DISTINCT program) AS final_total_programs
    FROM SrManagerBase
    GROUP BY 1, 2, 3
  ),

  SrCalculatedData AS (
    SELECT 
      'CX Quality Manager and Sr Manager' AS role,
      MAX(raw.timestamp) AS timestamp,
      raw.report_month,
      raw.report_year,
      raw.manager_name,
      raw.wdid_manager,
      raw.tl_sr_manager,
      raw.program,
      raw.country,
      raw.region,
      'My Customer' AS qaptg_business_category,
      'Quality % to Goal' AS qa_kpi,
      
      IF(COUNTIF(LOWER(TRIM(raw.kpi_applicable)) = 'yes') > 0, 'Yes', 'No') AS qa_kpi_applicable,
      IF(COUNTIF(LOWER(TRIM(raw.exempt)) = 'no') > 0, 'No', 'Yes') AS qa_exempt,
      IF(COUNTIF(LOWER(TRIM(raw.exempt)) = 'no') > 0, 'Rolled up by Senior Manager and Program', 'Exempt') AS qa_reason,
      
      IF(COUNTIF(LOWER(TRIM(raw.exempt)) = 'no') = 0, NULL, FORMAT('%.2f%%', AVG(CASE WHEN LOWER(TRIM(raw.exempt)) = 'no' THEN CAST(REPLACE(raw.quality_score_actual, '%', '') AS FLOAT64) ELSE NULL END))) AS quality_score_actual,
      IF(COUNTIF(LOWER(TRIM(raw.exempt)) = 'no') = 0, NULL, FORMAT('%.2f%%', AVG(CASE WHEN LOWER(TRIM(raw.exempt)) = 'no' THEN CAST(REPLACE(raw.quality_score_target_program, '%', '') AS FLOAT64) ELSE NULL END))) AS quality_score_target_program,
      
      pc.final_total_programs,
      
      CASE 
        WHEN COUNTIF(LOWER(TRIM(raw.kpi_applicable)) = 'yes') > 0 AND COUNTIF(LOWER(TRIM(raw.exempt)) = 'no') > 0 THEN 0.15 
        ELSE NULL 
      END AS qa_weight,

      SAFE_DIVIDE(
        AVG(CASE WHEN LOWER(TRIM(raw.exempt)) = 'no' THEN CAST(REPLACE(raw.quality_score_actual, '%', '') AS FLOAT64) ELSE NULL END), 
        AVG(CASE WHEN LOWER(TRIM(raw.exempt)) = 'no' THEN CAST(REPLACE(raw.quality_score_target_program, '%', '') AS FLOAT64) ELSE NULL END)
      ) AS qa_single_multi_program,

      CASE WHEN pc.final_total_programs = 1 THEN
        SAFE_DIVIDE(
          AVG(CASE WHEN LOWER(TRIM(raw.exempt)) = 'no' THEN CAST(REPLACE(raw.quality_score_actual, '%', '') AS FLOAT64) ELSE NULL END), 
          AVG(CASE WHEN LOWER(TRIM(raw.exempt)) = 'no' THEN CAST(REPLACE(raw.quality_score_target_program, '%', '') AS FLOAT64) ELSE NULL END)
        )
      ELSE NULL END AS qa_single_program,

      SAFE_DIVIDE(
        AVG(CASE WHEN LOWER(TRIM(raw.exempt)) = 'no' THEN CAST(REPLACE(raw.quality_score_actual, '%', '') AS FLOAT64) ELSE NULL END), 
        AVG(CASE WHEN LOWER(TRIM(raw.exempt)) = 'no' THEN CAST(REPLACE(raw.quality_score_target_program, '%', '') AS FLOAT64) ELSE NULL END)
      ) AS _raw_calc
    FROM SrManagerBase AS raw
    LEFT JOIN SrProgramCounts AS pc 
      ON raw.wdid_manager = pc.wdid_manager AND raw.report_month = pc.report_month AND raw.report_year = pc.report_year
    GROUP BY 3,4,5,6,7,8,9,10, pc.final_total_programs
  ),

  SrCappedData AS (
    SELECT * EXCEPT(_raw_calc),
      IF(qa_exempt = 'Yes', NULL,
        CASE WHEN final_total_programs >= 2 THEN
            CASE 
              WHEN _raw_calc <= 0.50 THEN 0
              WHEN _raw_calc > 0.50 AND _raw_calc <= 0.85 THEN 0.50
              WHEN _raw_calc > 0.85 AND _raw_calc <= 0.9999 THEN 0.75
              WHEN _raw_calc >= 1.00 AND _raw_calc <= 1.1499 THEN 1.00
              WHEN _raw_calc >= 1.15 THEN 1.15
              ELSE _raw_calc
            END
        ELSE NULL END) AS quality_multi_program,
      IF(qa_exempt = 'Yes', NULL,
        COALESCE(qa_single_program, 
                 CASE WHEN final_total_programs >= 2 THEN
                   CASE 
                     WHEN _raw_calc <= 0.50 THEN 0
                     WHEN _raw_calc > 0.50 AND _raw_calc <= 0.85 THEN 0.50
                     WHEN _raw_calc > 0.85 AND _raw_calc <= 0.9999 THEN 0.75
                     WHEN _raw_calc >= 1.00 AND _raw_calc <= 1.1499 THEN 1.00
                     WHEN _raw_calc >= 1.15 THEN 1.15
                     ELSE _raw_calc
                   END
                 ELSE NULL END)) AS qa_perf_vs_cap_uncapped
    FROM SrCalculatedData
  ),

  SrCategorizedAndPointsData AS (
    SELECT *,
      IF(qa_exempt = 'Yes', NULL,
        CASE 
          WHEN qa_perf_vs_cap_uncapped < 0.90 THEN 'Improvement Required'
          WHEN qa_perf_vs_cap_uncapped >= 0.90 AND qa_perf_vs_cap_uncapped <= 0.9999 THEN 'Developing'
          WHEN qa_perf_vs_cap_uncapped >= 1.00 AND qa_perf_vs_cap_uncapped <= 1.0099 THEN 'Achieving'
          WHEN qa_perf_vs_cap_uncapped >= 1.01 THEN 'Excelling'
          ELSE NULL 
        END) AS achievement_category,
      IF(qa_exempt = 'Yes', NULL,
        CASE 
          WHEN qa_perf_vs_cap_uncapped < 0.90 THEN 1
          WHEN qa_perf_vs_cap_uncapped >= 0.90 AND qa_perf_vs_cap_uncapped <= 0.9999 THEN 2
          WHEN qa_perf_vs_cap_uncapped >= 1.00 AND qa_perf_vs_cap_uncapped <= 1.0099 THEN 3
          WHEN qa_perf_vs_cap_uncapped >= 1.01 THEN 4
          ELSE NULL 
        END) AS qa_points_obtained
    FROM SrCappedData
  ),

  SrManagerFinalData AS (
    SELECT 
      *,
      IF(qa_exempt = 'Yes', NULL, (qa_points_obtained * 0.25) * qa_weight) AS qa_weight_obtaiend,
      IF(qa_exempt = 'Yes', NULL, qa_points_obtained * qa_weight) AS qa_points_obtained_for_final_score_only,
      IF(qa_exempt = 'Yes', NULL,
        (CASE 
          WHEN achievement_category = 'Improvement Required' THEN qa_weight * 0.25
          WHEN achievement_category = 'Developing' THEN qa_weight * 0.50
          WHEN achievement_category = 'Achieving' THEN qa_weight * 0.75
          WHEN achievement_category = 'Excelling' THEN qa_weight * 1.00
          ELSE NULL 
        END) * SAFE_DIVIDE(1.0, final_total_programs)) AS qa_weight_obtaiend_program_diluted
    FROM 
      SrCategorizedAndPointsData
  )

  -- ==============================================================================================
  -- FINAL UNION
  -- ==============================================================================================
  SELECT * FROM ManagerFinalData
  UNION ALL
  SELECT * FROM SrManagerFinalData;

END;
